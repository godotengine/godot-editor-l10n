#: doc/classes/XRBodyTracker.xml
msgid "Left shoulder joint."
msgstr "Articulation de l'épaule gauche."

#: doc/classes/XRBodyTracker.xml
msgid "Left upper arm joint."
msgstr "Articulation du bras supérieur gauche."

#: doc/classes/XRBodyTracker.xml
