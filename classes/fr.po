#: doc/classes/StaticBody3D.xml doc/classes/VoxelGI.xml
#: doc/classes/VoxelGIData.xml doc/classes/WorldEnvironment.xml
msgid "Third Person Shooter (TPS) Demo"
msgstr "Démo de tir à la troisième personne (TPS)"

#: doc/classes/AnimatableBody3D.xml doc/classes/Basis.xml
