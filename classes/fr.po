#: modules/interactive_music/doc_classes/AudioStreamPlaybackSynchronized.xml
#, fuzzy
msgid "Playback class used for [AudioStreamSynchronized]."
msgstr "Classe de lecture utilisée pour [AudioStreamPlaylist]."

#: modules/interactive_music/doc_classes/AudioStreamPlaybackSynchronized.xml
