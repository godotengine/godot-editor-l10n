msgstr "Define a direção do texto como herdada."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "Sets text direction to automatic."
msgstr "Define a direção do texto como automática."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "Sets text direction to left-to-right."
msgstr "Define a direção do texto da esquerda para a direita."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "Sets text direction to right-to-left."
msgstr "Define a direção do texto da direita para a esquerda."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "Toggles control character display."
msgstr "Alterna a exibição de caracteres de controle."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "ID of \"Insert Control Character\" submenu."
msgstr "ID do submenu \"Inserir Caractere de Controle\"."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "Inserts left-to-right mark (LRM) character."
msgstr "Insere o caractere de marca da esquerda para a direita (LRM)."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "Inserts right-to-left mark (RLM) character."
msgstr "Insere o caractere de marca da direita para a esquerda (RLM)."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "Inserts start of left-to-right embedding (LRE) character."
msgstr ""
"Insere o início do caractere de incorporação da esquerda para a direita "
"(LRE)."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "Inserts start of right-to-left embedding (RLE) character."
msgstr ""
"Insere o início do caractere de incorporação da direita para a esquerda "
"(RLE)."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "Inserts start of left-to-right override (LRO) character."
msgstr ""
"Insere o início do caractere de substituição da esquerda para a direita "
"(LRO)."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "Inserts start of right-to-left override (RLO) character."
msgstr ""
"Insere o início do caractere de substituição da direita para a esquerda "
"(RLO)."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "Inserts pop direction formatting (PDF) character."
msgstr "Insere o caractere de formatação de direção de pop (PDF)."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "Inserts Arabic letter mark (ALM) character."
msgstr "Insere o caractere de marca de letra árabe (ALM)."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "Inserts left-to-right isolate (LRI) character."
msgstr "Insere o caractere de isolamento da esquerda para a direita (LRI)."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "Inserts right-to-left isolate (RLI) character."
msgstr "Insere o caractere de isolamento da direita para a esquerda (RLI)."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "Inserts first strong isolate (FSI) character."
msgstr "Insere o caractere de primeiro isolamento forte (FSI)."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "Inserts pop direction isolate (PDI) character."
msgstr "Insere o caractere de isolamento pop de direção (PDI)."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "Inserts zero width joiner (ZWJ) character."
msgstr "Insere o caractere de união de largura zero (ZWJ)."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "Inserts zero width non-joiner (ZWNJ) character."
msgstr "Insere o caractere de separador de largura zero (ZWNJ)."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "Inserts word joiner (WJ) character."
msgstr "Insere o caractere de junção de palavras (WJ)."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "Inserts soft hyphen (SHY) character."
msgstr "Insere o caractere de hífen opcional (SHY)."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "Opens system emoji and symbol picker."
msgstr "Abre o seletor de emojis e símbolos do sistema."

#: doc/classes/LineEdit.xml doc/classes/RichTextLabel.xml
#: doc/classes/TextEdit.xml
msgid "Represents the size of the [enum MenuItems] enum."
msgstr "Representa o tamanho do enum [enum MenuItems]."

#: doc/classes/LineEdit.xml
msgid "Use the original size for the right icon."
msgstr "Use o tamanho original para o ícone direito."

#: doc/classes/LineEdit.xml
msgid "Scale the right icon's size to match the size of the text."
msgstr ""
"Dimensiona o tamanho do ícone direito para corresponder ao tamanho do texto."

#: doc/classes/LineEdit.xml
msgid "Scale the right icon to fit the LineEdit."
msgstr "Redimensiona o ícone direito para caber no LineEdit."

#: doc/classes/LineEdit.xml
msgid ""
"Color of the [LineEdit]'s caret (text cursor). This can be set to a fully "
"transparent color to hide the caret entirely."
msgstr ""
"Cor do cursor (de texto) do [LineEdit]. Isso pode ser definido como uma cor "
"totalmente transparente para ocultar o cursor completamente."

#: doc/classes/LineEdit.xml
msgid "Color used as default tint for the clear button."
msgstr "Cor usada como tom padrão para o botão de limpeza."

#: doc/classes/LineEdit.xml
msgid "Color used for the clear button when it's pressed."
msgstr "Cor usada para o botão de limpar quando ele é pressionado."

#: doc/classes/LineEdit.xml
msgid "Default font color."
msgstr "Cor padrão da fonte."

#: doc/classes/LineEdit.xml
msgid "The tint of text outline of the [LineEdit]."
msgstr "O tom do contorno do texto do [LineEdit]."

#: doc/classes/LineEdit.xml doc/classes/TextEdit.xml
msgid "Font color for [member placeholder_text]."
msgstr "Cor da fonte para [member placeholder_text]."

#: doc/classes/LineEdit.xml
msgid "Font color for selected text (inside the selection rectangle)."
msgstr "Cor da fonte para texto selecionado (dentro do retângulo de seleção)."

#: doc/classes/LineEdit.xml
msgid "Font color when editing is disabled."
msgstr "Cor da fonte quando a edição está desativada."

#: doc/classes/LineEdit.xml
msgid "Color of the selection rectangle."
msgstr "Cor do retângulo de seleção."

#: doc/classes/LineEdit.xml
msgid ""
"The caret's width in pixels. Greater values can be used to improve "
"accessibility by ensuring the caret is easily visible, or to ensure "
"consistency with a large font size."
msgstr ""
"A largura do cursor de texto em pixels. Valores maiores podem ser usados "
"para melhorar a acessibilidade, garantindo que o cursor de texto seja "
"facilmente visível, ou para garantir a consistência com um tamanho de fonte "
"grande."

#: doc/classes/LineEdit.xml
msgid ""
"Minimum horizontal space for the text (not counting the clear button and "
"content margins). This value is measured in count of 'M' characters (i.e. "
"this number of 'M' characters can be displayed without scrolling)."
msgstr ""
"Espaço horizontal mínimo para o texto (sem contar o botão de limpar e as "
"margens de conteúdo). Este valor é medido em contagem de caracteres 'M' (ou "
"seja, este número de caracteres 'M' pode ser exibido sem rolagem)."

#: doc/classes/LineEdit.xml
msgid "Font used for the text."
msgstr "Fonte usada para o texto."

#: doc/classes/LineEdit.xml
msgid "Font size of the [LineEdit]'s text."
msgstr "Tamanho da fonte do texto do [LineEdit]."

#: doc/classes/LineEdit.xml
msgid "Texture for the clear button. See [member clear_button_enabled]."
msgstr ""
"Textura para o botão de limpar. Consulte [member clear_button_enabled]."

#: doc/classes/LineEdit.xml
msgid ""
"Background used when [LineEdit] has GUI focus. The [theme_item focus] "
"[StyleBox] is displayed [i]over[/i] the base [StyleBox], so a partially "
"transparent [StyleBox] should be used to ensure the base [StyleBox] remains "
"visible. A [StyleBox] that represents an outline or an underline works well "
"for this purpose. To disable the focus visual effect, assign a "
"[StyleBoxEmpty] resource. Note that disabling the focus visual effect will "
"harm keyboard/controller navigation usability, so this is not recommended "
"for accessibility reasons."
msgstr ""
"Plano de fundo usado quando o [LineEdit] tem o foco da GUI. O [StyleBox] de "
"[theme_item focus] é exibido [i]sobre[/i] o [StyleBox] base, portanto, um "
"[StyleBox] parcialmente transparente deve ser usado para garantir que o "
"[StyleBox] base permaneça visível. Um [StyleBox] que representa um contorno "
"ou um sublinhado funciona bem para este propósito. Para desativar o efeito "
"visual de foco, atribua um recurso [StyleBoxEmpty]. Note que desativar o "
"efeito visual de foco prejudicará a usabilidade da navegação por teclado/"
"controle, portanto, isso não é recomendado por motivos de acessibilidade."

#: doc/classes/LineEdit.xml
msgid "Default background for the [LineEdit]."
msgstr "Fundo padrão para o [LineEdit]."

#: doc/classes/LineEdit.xml
msgid ""
"Background used when [LineEdit] is in read-only mode ([member editable] is "
"set to [code]false[/code])."
msgstr ""
"Fundo usado quando o [LineEdit] está no modo somente leitura ([member "
"editable] está definido como [code]false[/code])."

#: doc/classes/LinkButton.xml
msgid "A button that represents a link."
msgstr "Um botão que representa um link."

#: doc/classes/LinkButton.xml
msgid ""
"A button that represents a link. This type of button is primarily used for "
"interactions that cause a context change (like linking to a web page).\n"
"See also [BaseButton] which contains common properties and methods "
"associated with this node."
msgstr ""

#: doc/classes/LinkButton.xml
msgid "The underline mode to use for the text."
msgstr "O modo de sublinhado a ser usado para o texto."

#: doc/classes/LinkButton.xml
msgid ""
"The [url=https://en.wikipedia.org/wiki/Uniform_Resource_Identifier]URI[/url] "
"for this [LinkButton]. If set to a valid URI, pressing the button opens the "
"URI using the operating system's default program for the protocol (via "
"[method OS.shell_open]). HTTP and HTTPS URLs open the default web browser.\n"
"[codeblocks]\n"
"[gdscript]\n"
"uri = \"https://godotengine.org\"  # Opens the URL in the default web "
"browser.\n"
"uri = \"C:\\SomeFolder\"  # Opens the file explorer at the given path.\n"
"uri = \"C:\\SomeImage.png\"  # Opens the given image in the default viewing "
"app.\n"
"[/gdscript]\n"
"[csharp]\n"
"Uri = \"https://godotengine.org\"; // Opens the URL in the default web "
"browser.\n"
"Uri = \"C:\\SomeFolder\"; // Opens the file explorer at the given path.\n"
"Uri = \"C:\\SomeImage.png\"; // Opens the given image in the default viewing "
"app.\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"A [url=https://en.wikipedia.org/wiki/Uniform_Resource_Identifier]URI[/url] "
"para este [LinkButton]. Se definida como uma URI válida, pressionar o botão "
"abre a URI usando o programa padrão do sistema operacional para o protocolo "
"(via [method OS.shell_open]). URLs HTTP e HTTPS abrem o navegador web "
"padrão.\n"
"[codeblocks]\n"
"[gdscript]\n"
"uri = \"https://godotengine.org\"  # Abre a URL no navegador web padrão.\n"
"uri = \"C:\\SomeFolder\"  # Abre o explorador de arquivos no caminho "
"fornecido.\n"
"uri = \"C:\\SomeImage.png\"  # Abre a imagem fornecida no aplicativo de "
"visualização padrão.\n"
"[/gdscript]\n"
"[csharp]\n"
"Uri = \"https://godotengine.org\"; // Abre a URL no navegador web padrão.\n"
"Uri = \"C:\\SomeFolder\"; // Abre o explorador de arquivos no caminho "
"fornecido.\n"
"Uri = \"C:\\SomeImage.png\"; // Abre a imagem fornecida no aplicativo de "
"visualização padrão.\n"
"[/csharp]\n"
"[/codeblocks]"

#: doc/classes/LinkButton.xml
msgid "The LinkButton will always show an underline at the bottom of its text."
msgstr ""
"O LinkButton sempre mostrará um sublinhado na parte inferior do seu texto."

#: doc/classes/LinkButton.xml
msgid ""
"The LinkButton will show an underline at the bottom of its text when the "
"mouse cursor is over it."
msgstr ""
"O LinkButton exibirá um sublinhado na parte inferior de seu texto quando o "
"cursor do mouse estiver sobre ele."

#: doc/classes/LinkButton.xml
msgid "The LinkButton will never show an underline at the bottom of its text."
msgstr ""
"O LinkButton nunca mostrará um sublinhado na parte inferior do seu texto."

#: doc/classes/LinkButton.xml
msgid "Default text [Color] of the [LinkButton]."
msgstr "[Color] de texto padrão do [LinkButton]."

#: doc/classes/LinkButton.xml
msgid "Text [Color] used when the [LinkButton] is disabled."
msgstr "[Color] do texto usado quando o [LinkButton] está desativado."

#: doc/classes/LinkButton.xml
msgid ""
"Text [Color] used when the [LinkButton] is focused. Only replaces the normal "
"text color of the button. Disabled, hovered, and pressed states take "
"precedence over this color."
msgstr ""
"[Color] do texto usada quando o [LinkButton] está em foco. Substitui apenas "
"a cor de texto normal do botão. Os estados desativado, com o cursor sobre "
"ele e pressionado têm precedência sobre esta cor."

#: doc/classes/LinkButton.xml
msgid "Text [Color] used when the [LinkButton] is being hovered."
msgstr ""
"[Color] do texto usado quando o [LinkButton] está recebendo foco do cursor."

#: doc/classes/LinkButton.xml
msgid "Text [Color] used when the [LinkButton] is being hovered and pressed."
msgstr ""
"[Color] do texto usada quando o [LinkButton] está com o cursor sobre ele e "
"sendo pressionado."

#: doc/classes/LinkButton.xml
msgid "The tint of text outline of the [LinkButton]."
msgstr "A tonalidade do contorno do texto do [LinkButton]."

#: doc/classes/LinkButton.xml
msgid "Text [Color] used when the [LinkButton] is being pressed."
msgstr "[Color] do texto usado quando o [LinkButton] está sendo pressionado."

#: doc/classes/LinkButton.xml
msgid "The vertical space between the baseline of text and the underline."
msgstr "O espaço vertical entre a linha de base do texto e o sublinhado."

#: doc/classes/LinkButton.xml
msgid "[Font] of the [LinkButton]'s text."
msgstr "[Font] do texto do [LinkButton]."

#: doc/classes/LinkButton.xml
msgid "Font size of the [LinkButton]'s text."
msgstr "Tamanho da fonte do texto do [LinkButton]."

#: doc/classes/LinkButton.xml
msgid ""
"[StyleBox] used when the [LinkButton] is focused. The [theme_item focus] "
"[StyleBox] is displayed [i]over[/i] the base [StyleBox], so a partially "
"transparent [StyleBox] should be used to ensure the base [StyleBox] remains "
"visible. A [StyleBox] that represents an outline or an underline works well "
"for this purpose. To disable the focus visual effect, assign a "
"[StyleBoxEmpty] resource. Note that disabling the focus visual effect will "
"harm keyboard/controller navigation usability, so this is not recommended "
"for accessibility reasons."
msgstr ""
"[StyleBox] usado quando o [LinkButton] está focado. O [StyleBox] de "
"[theme_item focus] é exibido [i]sobre[/i] o [StyleBox] base, portanto, um "
"[StyleBox] parcialmente transparente deve ser usado para garantir que o "
"[StyleBox] base permaneça visível. Um [StyleBox] que representa um contorno "
"ou um sublinhado funciona bem para este propósito. Para desativar o efeito "
"visual de foco, atribua um recurso [StyleBoxEmpty]. Note que desativar o "
"efeito visual de foco prejudicará a usabilidade da navegação por teclado/"
"controle, portanto, isso não é recomendado por motivos de acessibilidade."

#: doc/classes/Logger.xml
msgid ""
"Custom logger to receive messages from the internal error/warning stream."
msgstr ""
"Registrador personalizado para receber mensagens do fluxo interno de erros/"
"avisos."

#: doc/classes/Logger.xml
msgid ""
"Custom logger to receive messages from the internal error/warning stream. "
"Loggers are registered via [method OS.add_logger]."
msgstr ""
"Registrador personalizado para receber mensagens do fluxo interno de erros/"
"avisos. Os registradores são registrados via [method OS.add_logger]."

#: doc/classes/Logger.xml
msgid "Logging"
msgstr "Registrando"

#: doc/classes/Logger.xml
msgid ""
"Called when an error is logged. The error provides the [param function], "
"[param file], and [param line] that it originated from, as well as either "
"the [param code] that generated the error or a [param rationale].\n"
"The type of error provided by [param error_type] is described in the [enum "
"ErrorType] enumeration.\n"
"Additionally, [param script_backtraces] provides backtraces for each of the "
"script languages. These will only contain stack frames in editor builds and "
"debug builds by default. To enable them for release builds as well, you need "
"to enable [member ProjectSettings.debug/settings/gdscript/"
"always_track_call_stacks].\n"
"[b]Warning:[/b] This method will be called from threads other than the main "
"thread, possibly at the same time, so you will need to have some kind of "
"thread-safety in your implementation of it, like a [Mutex].\n"
"[b]Note:[/b] [param script_backtraces] will not contain any captured "
"variables, due to its prohibitively high cost. To get those, you will need "
"to capture the backtraces yourself, from within the [Logger] virtual "
"methods, using [method Engine.capture_script_backtraces].\n"
"[b]Note:[/b] Logging errors from this method using functions like [method "
"@GlobalScope.push_error] or [method @GlobalScope.push_warning] is not "
"supported, as it could cause infinite recursion. These errors will only show "
"up in the console output."
msgstr ""

#: doc/classes/Logger.xml
msgid ""
"Called when a message is logged. If [param error] is [code]true[/code], then "
"this message was meant to be sent to [code]stderr[/code].\n"
"[b]Warning:[/b] This method will be called from threads other than the main "
"thread, possibly at the same time, so you will need to have some kind of "
"thread-safety in your implementation of it, like a [Mutex].\n"
"[b]Note:[/b] Logging another message from this method using functions like "
"[method @GlobalScope.print] is not supported, as it could cause infinite "
"recursion. These messages will only show up in the console output."
msgstr ""

#: doc/classes/Logger.xml
msgid "The message received is an error."
msgstr "A mensagem recebida é um erro."

#: doc/classes/Logger.xml
msgid "The message received is a warning."
msgstr "A mensagem recebida é um aviso."

#: doc/classes/Logger.xml
msgid "The message received is a script error."
msgstr "A mensagem recebida é um erro de script."

#: doc/classes/Logger.xml
msgid "The message received is a shader error."
msgstr "A mensagem recebida é um erro de shader."

#: doc/classes/LookAtModifier3D.xml
msgid "The [LookAtModifier3D] rotates a bone to look at a target."
msgstr "O [LookAtModifier3D] rotaciona um osso para olhar para um alvo."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"This [SkeletonModifier3D] rotates a bone to look at a target. This is "
"helpful for moving a character's head to look at the player, rotating a "
"turret to look at a target, or any other case where you want to make a bone "
"rotate towards something quickly and easily.\n"
"When applying multiple [LookAtModifier3D]s, the [LookAtModifier3D] assigned "
"to the parent bone must be put above the [LookAtModifier3D] assigned to the "
"child bone in the list in order for the child bone results to be correct."
msgstr ""

#: doc/classes/LookAtModifier3D.xml
msgid "Returns the remaining seconds of the time-based interpolation."
msgstr "Retorna os segundos restantes da interpolação baseada em tempo."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"Returns [code]true[/code] if time-based interpolation is running. If "
"[code]true[/code], it is equivalent to [method get_interpolation_remaining] "
"returning [code]0.0[/code].\n"
"This is useful to determine whether a [LookAtModifier3D] can be removed "
"safely."
msgstr ""

#: doc/classes/LookAtModifier3D.xml
msgid ""
"Returns whether the target is within the angle limitations. It is useful for "
"unsetting the [member target_node] when the target is outside of the angle "
"limitations.\n"
"[b]Note:[/b] The value is updated after [method "
"SkeletonModifier3D._process_modification]. To retrieve this value correctly, "
"we recommend using the signal [signal "
"SkeletonModifier3D.modification_processed]."
msgstr ""

#: doc/classes/LookAtModifier3D.xml
msgid "Index of the [member bone_name] in the parent [Skeleton3D]."
msgstr "Índice do [member bone_name] no [Skeleton3D] pai."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The bone name of the [Skeleton3D] that the modification will operate on."
msgstr "O nome do osso do [Skeleton3D] em que a modificação operará."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The duration of the time-based interpolation. Interpolation is triggered at "
"the following cases:\n"
"- When the target node is changed\n"
"- When an axis is flipped due to angle limitation\n"
"[b]Note:[/b] The flipping occurs when the target is outside the angle "
"limitation and the internally computed secondary rotation axis of the "
"forward vector is flipped. Visually, it occurs when the target is outside "
"the angle limitation and crosses the plane of the [member forward_axis] and "
"[member primary_rotation_axis]."
msgstr ""

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The ease type of the time-based interpolation. See also [enum "
"Tween.EaseType]."
msgstr ""
"O tipo de suavização (ease) da interpolação baseada em tempo. Consulte "
"também [enum Tween.EaseType]."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The forward axis of the bone. This [SkeletonModifier3D] modifies the bone so "
"that this axis points toward the [member target_node]."
msgstr ""
"O eixo frontal do osso. Este [SkeletonModifier3D] modifica o osso para que "
"este eixo aponte para o [member target_node]."

#: doc/classes/LookAtModifier3D.xml
msgid "Index of the [member origin_bone_name] in the parent [Skeleton3D]."
msgstr "Índice do [member origin_bone_name] no [Skeleton3D] pai."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"If [member origin_from] is [constant ORIGIN_FROM_SPECIFIC_BONE], the bone "
"global pose position specified for this is used as origin."
msgstr ""
"Se [member origin_from] for [constant ORIGIN_FROM_SPECIFIC_BONE], a posição "
"da pose global do osso especificada para isso será usada como origem."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"If [member origin_from] is [constant ORIGIN_FROM_EXTERNAL_NODE], the global "
"position of the [Node3D] specified for this is used as origin."
msgstr ""
"Se [member origin_from] for [constant ORIGIN_FROM_EXTERNAL_NODE], a posição "
"global do [Node3D] especificado para isso será usada como origem."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"This value determines from what origin is retrieved for use in the "
"calculation of the forward vector."
msgstr ""
"Este valor determina de qual origem é obtido para uso no cálculo do vetor de "
"avanço."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The offset of the bone pose origin. Matching the origins by offset is useful "
"for cases where multiple bones must always face the same direction, such as "
"the eyes.\n"
"[b]Note:[/b] This value indicates the local position of the object set in "
"[member origin_from]."
msgstr ""

#: doc/classes/LookAtModifier3D.xml
msgid ""
"If the target passes through too close to the origin than this value, time-"
"based interpolation is used even if the target is within the angular "
"limitations, to prevent the angular velocity from becoming too high."
msgstr ""
"Se o alvo passar muito perto da origem em relação a este valor, a "
"interpolação baseada em tempo é usada mesmo que o alvo esteja dentro das "
"limitações angulares, para evitar que a velocidade angular se torne alta "
"demais."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The threshold to start damping for [member primary_limit_angle]. It provides "
"non-linear (b-spline) interpolation, let it feel more resistance the more it "
"rotate to the edge limit. This is useful for simulating the limits of human "
"motion.\n"
"If [code]1.0[/code], no damping is performed. If [code]0.0[/code], damping "
"is always performed."
msgstr ""

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The limit angle of the primary rotation when [member symmetry_limitation] is "
"[code]true[/code], in radians."
msgstr ""
"O ângulo limite da rotação primária quando [member symmetry_limitation] é "
"[code]true[/code], em radianos."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The threshold to start damping for [member primary_negative_limit_angle]."
msgstr ""
"O limiar para iniciar o amortecimento de [member "
"primary_negative_limit_angle]."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The limit angle of negative side of the primary rotation when [member "
"symmetry_limitation] is [code]false[/code], in radians."
msgstr ""
"O ângulo limite do lado negativo da rotação primária quando [member "
"symmetry_limitation] é [code]false[/code], em radianos."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The threshold to start damping for [member primary_positive_limit_angle]."
msgstr ""
"O limiar para iniciar o amortecimento de [member "
"primary_positive_limit_angle]."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The limit angle of positive side of the primary rotation when [member "
"symmetry_limitation] is [code]false[/code], in radians."
msgstr ""
"O ângulo limite do lado positivo da rotação primária quando [member "
"symmetry_limitation] é [code]false[/code], em radianos."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The axis of the first rotation. This [SkeletonModifier3D] works by "
"compositing the rotation by Euler angles to prevent to rotate the [member "
"forward_axis]."
msgstr ""
"O eixo da primeira rotação. Este [SkeletonModifier3D] funciona compondo a "
"rotação por ângulos de Euler para evitar rotacionar o [member forward_axis]."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The relative option. If [code]true[/code], the rotation is applied relative "
"to the pose. If [code]false[/code], the rotation is applied relative to the "
"rest. It means to replace the current pose with the [LookAtModifier3D]'s "
"result.\n"
"[b]Note:[/b] This option affects the base angle for [member "
"use_angle_limitation]. Since the [LookAtModifier3D] relies strongly on Euler "
"rotation, the axis that determines the limitation and the actual rotation "
"are strongly tied together."
msgstr ""

#: doc/classes/LookAtModifier3D.xml
msgid "The threshold to start damping for [member secondary_limit_angle]."
msgstr ""
"O limite para iniciar o amortecimento para [member secondary_limit_angle]."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The limit angle of the secondary rotation when [member symmetry_limitation] "
"is [code]true[/code], in radians."
msgstr ""
"O ângulo limite da rotação secundária quando [member symmetry_limitation] é "
"[code]true[/code], em radianos."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The threshold to start damping for [member secondary_negative_limit_angle]."
msgstr ""
"O limiar para iniciar o amortecimento de [member "
"secondary_negative_limit_angle]."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The limit angle of negative side of the secondary rotation when [member "
"symmetry_limitation] is [code]false[/code], in radians."
msgstr ""
"O ângulo limite do lado negativo da rotação secundária quando [member "
"symmetry_limitation] é [code]false[/code], em radianos."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The threshold to start damping for [member secondary_positive_limit_angle]."
msgstr ""
"O limiar para iniciar o amortecimento de [member "
"secondary_positive_limit_angle]."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The limit angle of positive side of the secondary rotation when [member "
"symmetry_limitation] is [code]false[/code], in radians."
msgstr ""
"O ângulo limite do lado positivo da rotação secundária quando [member "
"symmetry_limitation] é [code]false[/code], em radianos."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"If [code]true[/code], the limitations are spread from the bone "
"symmetrically.\n"
"If [code]false[/code], the limitation can be specified separately for each "
"side of the bone rest."
msgstr ""

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The [NodePath] to the node that is the target for the look at modification. "
"This node is what the modification will rotate the bone to."
msgstr ""
"O [NodePath] para o nó que é o alvo para a modificação de olhar para (look "
"at). Este nó é para onde a modificação rotacionará o osso."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The transition type of the time-based interpolation. See also [enum "
"Tween.TransitionType]."
msgstr ""
"O tipo de transição da interpolação baseada no tempo. Consulte também [enum "
"Tween.TransitionType]."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"If [code]true[/code], limits the amount of rotation. For example, this helps "
"to prevent a character's neck from rotating 360 degrees.\n"
"[b]Note:[/b] As with [AnimationTree] blending, interpolation is provided "
"that favors [method Skeleton3D.get_bone_rest] or [method "
"Skeleton3D.get_bone_pose] depends on the [member relative] option. This "
"means that interpolation does not select the shortest path in some cases.\n"
"[b]Note:[/b] Some values for [member transition_type] (such as [constant "
"Tween.TRANS_BACK], [constant Tween.TRANS_ELASTIC], and [constant "
"Tween.TRANS_SPRING]) may exceed the limitations. If interpolation occurs "
"while overshooting the limitations, the result might not respect the bone "
"rest."
msgstr ""

#: doc/classes/LookAtModifier3D.xml
msgid "If [code]true[/code], provides rotation by two axes."
msgstr "Se [code]true[/code], fornece rotação por dois eixos."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The bone rest position of the bone specified in [member bone] is used as "
"origin."
msgstr ""
"A posição de descanso do osso especificado em [member bone] é usada como "
"origem."

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The bone global pose position of the bone specified in [member origin_bone] "
"is used as origin.\n"
"[b]Note:[/b] It is recommended that you select only the parent bone unless "
"you are familiar with the bone processing process. The specified bone pose "
"at the time the [LookAtModifier3D] is processed is used as a reference. In "
"other words, if you specify a child bone and the [LookAtModifier3D] causes "
"the child bone to move, the rendered result and direction will not match."
msgstr ""

#: doc/classes/LookAtModifier3D.xml
msgid ""
"The global position of the [Node3D] specified in [member "
"origin_external_node] is used as origin.\n"
"[b]Note:[/b] Same as [constant ORIGIN_FROM_SPECIFIC_BONE], when specifying a "
"[BoneAttachment3D] with a child bone assigned, the rendered result and "
"direction will not match."
msgstr ""

#: doc/classes/MainLoop.xml
msgid "Abstract base class for the game's main loop."
msgstr "Classe base abstrata para o loop principal do jogo."

#: doc/classes/MainLoop.xml
msgid ""
"[MainLoop] is the abstract base class for a Godot project's game loop. It is "
"inherited by [SceneTree], which is the default game loop implementation used "
"in Godot projects, though it is also possible to write and use one's own "
"[MainLoop] subclass instead of the scene tree.\n"
"Upon the application start, a [MainLoop] implementation must be provided to "
"the OS; otherwise, the application will exit. This happens automatically "
"(and a [SceneTree] is created) unless a [MainLoop] [Script] is provided from "
"the command line (with e.g. [code]godot -s my_loop.gd[/code]) or the [member "
"ProjectSettings.application/run/main_loop_type] project setting is "
"overwritten.\n"
"Here is an example script implementing a simple [MainLoop]:\n"
"[codeblocks]\n"
"[gdscript]\n"
"class_name CustomMainLoop\n"
"extends MainLoop\n"
"\n"
"var time_elapsed = 0\n"
"\n"
"func _initialize():\n"
"\tprint(\"Initialized:\")\n"
"\tprint(\"  Starting time: %s\" % str(time_elapsed))\n"
"\n"
"func _process(delta):\n"
"\ttime_elapsed += delta\n"
"\t# Return true to end the main loop.\n"
"\treturn Input.get_mouse_button_mask() != 0 || "
"Input.is_key_pressed(KEY_ESCAPE)\n"
"\n"
"func _finalize():\n"
"\tprint(\"Finalized:\")\n"
"\tprint(\"  End time: %s\" % str(time_elapsed))\n"
"[/gdscript]\n"
"[csharp]\n"
"using Godot;\n"
"\n"
"[GlobalClass]\n"
"public partial class CustomMainLoop : MainLoop\n"
"{\n"
"\tprivate double _timeElapsed = 0;\n"
"\n"
"\tpublic override void _Initialize()\n"
"\t{\n"
"\t\tGD.Print(\"Initialized:\");\n"
"\t\tGD.Print($\"  Starting Time: {_timeElapsed}\");\n"
"\t}\n"
"\n"
"\tpublic override bool _Process(double delta)\n"
"\t{\n"
"\t\t_timeElapsed += delta;\n"
"\t\t// Return true to end the main loop.\n"
"\t\treturn Input.GetMouseButtonMask() != 0 || "
"Input.IsKeyPressed(Key.Escape);\n"
"\t}\n"
"\n"
"\tprivate void _Finalize()\n"
"\t{\n"
"\t\tGD.Print(\"Finalized:\");\n"
"\t\tGD.Print($\"  End Time: {_timeElapsed}\");\n"
"\t}\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"[MainLoop] é a classe base abstrata para o loop de jogo de um projeto Godot. "
"Ela é herdada pela [SceneTree], que é a implementação padrão de loop de jogo "
"usada em projetos Godot, embora também seja possível escrever e usar uma "
"subclasse de [MainLoop] própria em vez da árvore de cenas.\n"
"Ao iniciar a aplicação, uma implementação de [MainLoop] deve ser fornecida "
"ao sistema operacional; caso contrário, a aplicação será encerrada. Isso "
"acontece automaticamente (e uma [SceneTree] é criada), a menos que um "
"[Script] de [MainLoop] seja fornecido pela linha de comando (com, por "
"exemplo, [code]godot -s meu_loop.gd[/code]) ou que a configuração do projeto "
"[member ProjectSettings.application/run/main_loop_type] seja sobrescrita.\n"
"Aqui está um exemplo de script implementando um [MainLoop] simples:\n"
"[codeblocks]\n"
"[gdscript]\n"
"class_name CustomMainLoop\n"
"extends MainLoop\n"
"\n"
"var time_elapsed = 0\n"
"\n"
"func _initialize():\n"
"\tprint(\"Inicializado:\")\n"
"\tprint(\"  Tempo inicial: %s\" % str(time_elapsed))\n"
"\n"
"func _process(delta):\n"
"\ttime_elapsed += delta\n"
"\t# Retorne true para encerrar o loop principal.\n"
"\treturn Input.get_mouse_button_mask() != 0 || "
"Input.is_key_pressed(KEY_ESCAPE)\n"
"\n"
"func _finalize():\n"
"\tprint(\"Finalizado:\")\n"
"\tprint(\"  Tempo final: %s\" % str(time_elapsed))\n"
"[/gdscript]\n"
"[csharp]\n"
"using Godot;\n"
"\n"
"[GlobalClass]\n"
"public partial class CustomMainLoop : MainLoop\n"
"{\n"
"\tprivate double _timeElapsed = 0;\n"
"\n"
"\tpublic override void _Initialize()\n"
"\t{\n"
"\t\tGD.Print(\"Inicializado:\");\n"
"\t\tGD.Print($\"  Tempo inicial: {_timeElapsed}\");\n"
"\t}\n"
"\n"
"\tpublic override bool _Process(double delta)\n"
"\t{\n"
"\t\t_timeElapsed += delta;\n"
"\t\t// Retorne true para encerrar o loop principal.\n"
"\t\treturn Input.GetMouseButtonMask() != 0 || "
"Input.IsKeyPressed(Key.Escape);\n"
"\t}\n"
"\n"
"\tprivate void _Finalize()\n"
"\t{\n"
"\t\tGD.Print(\"Finalizado:\");\n"
"\t\tGD.Print($\"  Tempo final: {_timeElapsed}\");\n"
"\t}\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]"

#: doc/classes/MainLoop.xml
msgid "Called before the program exits."
msgstr "Chamada antes do programa fechar."

#: doc/classes/MainLoop.xml
msgid "Called once during initialization."
msgstr "Chamado uma vez durante a inicialização."

#: doc/classes/MainLoop.xml
msgid ""
"Called each physics tick. [param delta] is the logical time between physics "
"ticks in seconds and is equal to [member Engine.time_scale] / [member "
"Engine.physics_ticks_per_second]. Equivalent to [method "
"Node._physics_process].\n"
"If implemented, the method must return a boolean value. [code]true[/code] "
"ends the main loop, while [code]false[/code] lets it proceed to the next "
"step.\n"
"[b]Note:[/b] [method _physics_process] may be called up to [member "
"Engine.max_physics_steps_per_frame] times per (idle) frame. This step limit "
"may be reached when the engine is suffering performance issues.\n"
"[b]Note:[/b] Accumulated [param delta] may diverge from real world seconds."
msgstr ""

#: doc/classes/MainLoop.xml
msgid ""
"Called on each idle frame, prior to rendering, and after physics ticks have "
"been processed. [param delta] is the time between frames in seconds. "
"Equivalent to [method Node._process].\n"
"If implemented, the method must return a boolean value. [code]true[/code] "
"ends the main loop, while [code]false[/code] lets it proceed to the next "
"frame.\n"
"[b]Note:[/b] When the engine is struggling and the frame rate is lowered, "
"[param delta] will increase. When [param delta] is increased, it's capped at "
"a maximum of [member Engine.time_scale] * [member "
"Engine.max_physics_steps_per_frame] / [member "
"Engine.physics_ticks_per_second]. As a result, accumulated [param delta] may "
"not represent real world time.\n"
"[b]Note:[/b] When [code]--fixed-fps[/code] is enabled or the engine is "
"running in Movie Maker mode (see [MovieWriter]), process [param delta] will "
"always be the same for every frame, regardless of how much time the frame "
"took to render.\n"
"[b]Note:[/b] Frame delta may be post-processed by [member "
"OS.delta_smoothing] if this is enabled for the project."
msgstr ""

#: doc/classes/MainLoop.xml
msgid "Emitted when a user responds to a permission request."
msgstr "Emitido quando um usuário responde a uma solicitação de permissão."

#: doc/classes/MainLoop.xml
msgid ""
"Notification received from the OS when the application is exceeding its "
"allocated memory.\n"
"Specific to the iOS platform."
msgstr ""

#: doc/classes/MainLoop.xml
msgid ""
"Notification received when translations may have changed. Can be triggered "
"by the user changing the locale. Can be used to respond to language changes, "
"for example to change the UI strings on the fly. Useful when working with "
"the built-in translation support, like [method Object.tr]."
msgstr ""
"Notificação recebida quando as traduções podem ter mudado. Pode ser "
"disparada pelo usuário alterando a localidade. Pode ser usada para responder "
"a alterações de idioma, por exemplo, para alterar as strings da interface do "
"usuário em tempo de execução. Útil ao trabalhar com o suporte a tradução "
"integrado, como [method Object.tr]."

#: doc/classes/MainLoop.xml
msgid ""
"Notification received from the OS when a request for \"About\" information "
"is sent.\n"
"Specific to the macOS platform."
msgstr ""

#: doc/classes/MainLoop.xml
msgid ""
"Notification received from Godot's crash handler when the engine is about to "
"crash.\n"
"Implemented on desktop platforms if the crash handler is enabled."
msgstr ""

#: doc/classes/MainLoop.xml doc/classes/Node.xml
msgid ""
"Notification received from the OS when an update of the Input Method Engine "
"occurs (e.g. change of IME cursor position or composition string).\n"
"Implemented on desktop and web platforms."
msgstr ""
"Notificação recebida do SO quando ocorre uma atualização do Mecanismo de "
"Método de Entrada (por exemplo, alteração da posição do cursor do IME ou da "
"string de composição).\n"
"Implementado em plataformas desktop e web."

#: doc/classes/MainLoop.xml doc/classes/Node.xml
msgid ""
"Notification received from the OS when the application is resumed.\n"
"Specific to the Android and iOS platforms."
msgstr ""
"Notificação recebida do SO quando o aplicativo é retomado.\n"
"Específica das plataformas Android e iOS."

#: doc/classes/MainLoop.xml doc/classes/Node.xml
msgid ""
"Notification received from the OS when the application is paused.\n"
"Specific to the Android and iOS platforms.\n"
"[b]Note:[/b] On iOS, you only have approximately 5 seconds to finish a task "
"started by this signal. If you go over this allotment, iOS will kill the app "
"instead of pausing it."
msgstr ""

#: doc/classes/MainLoop.xml doc/classes/Node.xml
msgid ""
"Notification received from the OS when the application is focused, i.e. when "
"changing the focus from the OS desktop or a thirdparty application to any "
"open window of the Godot instance.\n"
"Implemented on desktop and mobile platforms."
msgstr ""

#: doc/classes/MainLoop.xml doc/classes/Node.xml
msgid ""
"Notification received from the OS when the application is defocused, i.e. "
"when changing the focus from any open window of the Godot instance to the OS "
"desktop or a thirdparty application.\n"
"Implemented on desktop and mobile platforms."
msgstr ""

#: doc/classes/MainLoop.xml
msgid "Notification received when text server is changed."
msgstr "Notificação recebida quando o servidor de texto é alterado."

#: doc/classes/MainLoop.xml doc/classes/Node.xml
msgid ""
"Notification received when the application enters picture-in-picture mode."
msgstr ""
"Notificação recebida quando o aplicativo entra no modo picture-in-picture."

#: doc/classes/MainLoop.xml doc/classes/Node.xml
msgid ""
"Notification received when the application exits picture-in-picture mode."
msgstr ""
"Notificação recebida quando o aplicativo sai do modo picture-in-picture."

#: doc/classes/MarginContainer.xml
msgid "A container that keeps a margin around its child controls."
msgstr "Um contêiner que mantém uma margem ao redor de seus controles filhos."

#: doc/classes/MarginContainer.xml
msgid ""
"[MarginContainer] adds an adjustable margin on each side of its child "
"controls. The margins are added around all children, not around each "
"individual one. To control the [MarginContainer]'s margins, use the "
"[code]margin_*[/code] theme properties listed below.\n"
"[b]Note:[/b] The margin sizes are theme overrides, not normal properties. "
"This is an example of how to change them in code:\n"
"[codeblocks]\n"
"[gdscript]\n"
"# This code sample assumes the current script is extending MarginContainer.\n"
"var margin_value = 100\n"
"add_theme_constant_override(\"margin_top\", margin_value)\n"
"add_theme_constant_override(\"margin_left\", margin_value)\n"
"add_theme_constant_override(\"margin_bottom\", margin_value)\n"
"add_theme_constant_override(\"margin_right\", margin_value)\n"
"[/gdscript]\n"
"[csharp]\n"
"// This code sample assumes the current script is extending "
"MarginContainer.\n"
"int marginValue = 100;\n"
"AddThemeConstantOverride(\"margin_top\", marginValue);\n"
"AddThemeConstantOverride(\"margin_left\", marginValue);\n"
"AddThemeConstantOverride(\"margin_bottom\", marginValue);\n"
"AddThemeConstantOverride(\"margin_right\", marginValue);\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"O [MarginContainer] adiciona uma margem ajustável em cada lado de seus "
"controles filhos. As margens são adicionadas ao redor de todos os filhos, e "
"não ao redor de cada um individualmente. Para controlar as margens do "
"[MarginContainer], use as propriedades de tema [code]margin_*[/code] "
"listadas abaixo.\n"
"[b]Nota:[/b] Os tamanhos das margens são substituições de tema, não "
"propriedades normais. Este é um exemplo de como alterá-los em código:\n"
"[codeblocks]\n"
"[gdscript]\n"
"# Este exemplo de código assume que o script atual estende MarginContainer.\n"
"var margin_value = 100\n"
"add_theme_constant_override(\"margin_top\", margin_value)\n"
"add_theme_constant_override(\"margin_left\", margin_value)\n"
"add_theme_constant_override(\"margin_bottom\", margin_value)\n"
"add_theme_constant_override(\"margin_right\", margin_value)\n"
"[/gdscript]\n"
"[csharp]\n"
"// Este exemplo de código assume que o script atual estende "
"MarginContainer.\n"
"int marginValue = 100;\n"
"AddThemeConstantOverride(\"margin_top\", marginValue);\n"
"AddThemeConstantOverride(\"margin_left\", marginValue);\n"
"AddThemeConstantOverride(\"margin_bottom\", marginValue);\n"
"AddThemeConstantOverride(\"margin_right\", marginValue);\n"
"[/csharp]\n"
"[/codeblocks]"

#: doc/classes/MarginContainer.xml
msgid ""
"Offsets towards the inside direct children of the container by this amount "
"of pixels from the bottom."
msgstr ""
"Desloca para o interior os filhos diretos do container por esta quantidade "
"de pixels a partir de baixo."

#: doc/classes/MarginContainer.xml
msgid ""
"Offsets towards the inside direct children of the container by this amount "
"of pixels from the left."
msgstr ""
"Desloca para o interior os filhos diretos do container por esta quantidade "
"de pixels a partir da esquerda."

#: doc/classes/MarginContainer.xml
msgid ""
"Offsets towards the inside direct children of the container by this amount "
"of pixels from the right."
msgstr ""
"Desloca para o interior os filhos diretos do container por esta quantidade "
"de pixels a partir da direita."

#: doc/classes/MarginContainer.xml
msgid ""
"Offsets towards the inside direct children of the container by this amount "
"of pixels from the top."
msgstr ""
"Desloca em direção aos filhos diretos internos do contêiner por esta "
"quantidade de pixels a partir do topo."

#: doc/classes/Marker2D.xml
msgid "Generic 2D position hint for editing."
msgstr "Dica de posição 2D genérica para edição."

#: doc/classes/Marker2D.xml
msgid ""
"Generic 2D position hint for editing. It's just like a plain [Node2D], but "
"it displays as a cross in the 2D editor at all times. You can set the cross' "
"visual size by using the gizmo in the 2D editor while the node is selected."
msgstr ""
"Dica de posição 2D genérica para edição. É como um [Node2D] simples, mas é "
"exibido como uma cruz no editor 2D o tempo todo. Você pode definir o tamanho "
"visual da cruz usando o gizmo no editor 2D enquanto o nó está selecionado."

#: doc/classes/Marker2D.xml doc/classes/Marker3D.xml
msgid "Size of the gizmo cross that appears in the editor."
msgstr "Tamanho da cruz do gizmo que aparece no editor."

#: doc/classes/Marker3D.xml
msgid "Generic 3D position hint for editing."
msgstr "Dica de posição 3D genérica para edição."

#: doc/classes/Marker3D.xml
msgid ""
"Generic 3D position hint for editing. It's just like a plain [Node3D], but "
"it displays as a cross in the 3D editor at all times."
msgstr ""
"Dica genérica de posição 3D para edição. É como um [Node3D] simples, mas é "
"exibido como uma cruz no editor 3D o tempo todo."

#: doc/classes/Marshalls.xml
msgid "Data transformation (marshaling) and encoding helpers."
msgstr "Auxiliares de transformação de dados (marshaling) e codificação."

#: doc/classes/Marshalls.xml
msgid "Provides data transformation and encoding utility functions."
msgstr "Fornece funções utilitárias de transformação e codificação de dados."

#: doc/classes/Marshalls.xml
msgid ""
"Returns a decoded [PackedByteArray] corresponding to the Base64-encoded "
"string [param base64_str]."
msgstr ""
"Retorna um [PackedByteArray] decodificado correspondente à string codificada "
"em Base64 [param base64_str]."

#: doc/classes/Marshalls.xml
msgid ""
"Returns a decoded string corresponding to the Base64-encoded string [param "
"base64_str]."
msgstr ""
"Retorna uma string decodificada correspondente à string codificada em Base64 "
"[param base64_str]."

#: doc/classes/Marshalls.xml
msgid ""
"Returns a decoded [Variant] corresponding to the Base64-encoded string "
"[param base64_str]. If [param allow_objects] is [code]true[/code], decoding "
"objects is allowed.\n"
"Internally, this uses the same decoding mechanism as the [method "
"@GlobalScope.bytes_to_var] method.\n"
"[b]Warning:[/b] Deserialized objects can contain code which gets executed. "
"Do not use this option if the serialized object comes from untrusted sources "
"to avoid potential security threats such as remote code execution."
msgstr ""
"Retorna um [Variant] decodificado correspondente à string codificada em "
"Base64 [param base64_str]. Se [param allow_objects] for [code]true[/code], a "
"decodificação de objetos é permitida.\n"
"Internamente, isso utiliza o mesmo mecanismo de decodificação do método "
"[method @GlobalScope.bytes_to_var].\n"
"[b]Aviso:[/b] Objetos desserializados podem conter código que é executado. "
"Não utilize esta opção se o objeto serializado provier de fontes não "
"confiáveis, para evitar possíveis ameaças à segurança, como a execução "
"remota de código."

#: doc/classes/Marshalls.xml
msgid "Returns a Base64-encoded string of a given [PackedByteArray]."
msgstr ""
"Retorna uma string codificada em Base64 de um [PackedByteArray] fornecido."

#: doc/classes/Marshalls.xml
msgid "Returns a Base64-encoded string of the UTF-8 string [param utf8_str]."
msgstr ""
"Retorna uma string codificada em Base64 da string UTF-8 [param utf8_str]."

#: doc/classes/Marshalls.xml
msgid ""
"Returns a Base64-encoded string of the [Variant] [param variant]. If [param "
"full_objects] is [code]true[/code], encoding objects is allowed (and can "
"potentially include code).\n"
"Internally, this uses the same encoding mechanism as the [method "
"@GlobalScope.var_to_bytes] method."
msgstr ""
"Retorna uma string codificada em Base64 do [Variant] [param variant]. Se "
"[param full_objects] for [code]true[/code], a codificação de objetos será "
"permitida (e pode potencialmente incluir código).\n"
"Internamente, isso usa o mesmo mecanismo de codificação que o método [method "
"@GlobalScope.var_to_bytes]."

#: doc/classes/Material.xml
msgid ""
"Virtual base class for applying visual properties to an object, such as "
"color and roughness."
msgstr ""
"Classe base virtual para aplicar propriedades visuais a um objeto, como cor "
"e rugosidade."

#: doc/classes/Material.xml
msgid ""
"[Material] is a base resource used for coloring and shading geometry. All "
"materials inherit from it and almost all [VisualInstance3D] derived nodes "
"carry a [Material]. A few flags and parameters are shared between all "
"material types and are configured here.\n"
"Importantly, you can inherit from [Material] to create your own custom "
"material type in script or in GDExtension."
msgstr ""

#: doc/classes/Material.xml
msgid ""
"Only exposed for the purpose of overriding. You cannot call this function "
"directly. Used internally to determine if [member next_pass] should be shown "
"in the editor or not."
msgstr ""
"Exposto apenas para fins de substituição. Você não pode chamar esta função "
"diretamente. Usado internamente para determinar se [member next_pass] deve "
"ser exibido no editor ou não."

#: doc/classes/Material.xml
msgid ""
"Only exposed for the purpose of overriding. You cannot call this function "
"directly. Used internally to determine if [member render_priority] should be "
"shown in the editor or not."
msgstr ""
"Exposto apenas para fins de substituição. Você não pode chamar esta função "
"diretamente. Usado internamente para determinar se [member render_priority] "
"deve ser exibido no editor ou não."

#: doc/classes/Material.xml
msgid ""
"Only exposed for the purpose of overriding. You cannot call this function "
"directly. Used internally by various editor tools."
msgstr ""
"Exposto apenas para fins de substituição. Você não pode chamar esta função "
"diretamente. Usado internamente por várias ferramentas do editor."

#: doc/classes/Material.xml
msgid ""
"Only exposed for the purpose of overriding. You cannot call this function "
"directly. Used internally by various editor tools. Used to access the RID of "
"the [Material]'s [Shader]."
msgstr ""
"Exposto apenas para fins de substituição. Você não pode chamar esta função "
"diretamente. Usado internamente por várias ferramentas do editor. Usado para "
"acessar o RID do [Shader] do [Material]."

#: doc/classes/Material.xml
msgid "Creates a placeholder version of this resource ([PlaceholderMaterial])."
msgstr ""
"Cria uma versão de espaço reservado deste recurso ([PlaceholderMaterial])."

#: doc/classes/Material.xml
msgid ""
"Only available when running in the editor. Opens a popup that visualizes the "
"generated shader code, including all variants and internal shader code. See "
"also [method Shader.inspect_native_shader_code]."
msgstr ""
"Disponível apenas ao executar no editor. Abre um pop-up que visualiza o "
"código de shader gerado, incluindo todas as variantes e o código de shader "
"interno. Consulte também [method Shader.inspect_native_shader_code]."

#: doc/classes/Material.xml
msgid ""
"Sets the [Material] to be used for the next pass. This renders the object "
"again using a different material.\n"
"[b]Note:[/b] [member next_pass] materials are not necessarily drawn "
"immediately after the source [Material]. Draw order is determined by "
"material properties, [member render_priority], and distance to camera.\n"
"[b]Note:[/b] This only applies to [StandardMaterial3D]s and "
"[ShaderMaterial]s with type \"Spatial\"."
msgstr ""

#: doc/classes/Material.xml
msgid ""
"Sets the render priority for objects in 3D scenes. Higher priority objects "
"will be sorted in front of lower priority objects. In other words, all "
"objects with [member render_priority] [code]1[/code] will render on top of "
"all objects with [member render_priority] [code]0[/code].\n"
"[b]Note:[/b] This only applies to [StandardMaterial3D]s and "
"[ShaderMaterial]s with type \"Spatial\".\n"
"[b]Note:[/b] This will not impact how transparent objects are sorted "
"relative to opaque objects or how dynamic meshes will be sorted relative to "
"other opaque meshes. This is because all transparent objects are drawn after "
"all opaque objects and all dynamic opaque meshes are drawn before other "
"opaque meshes."
msgstr ""

#: doc/classes/Material.xml
msgid "Maximum value for the [member render_priority] parameter."
msgstr "Valor máximo para o parâmetro [member render_priority]."

#: doc/classes/Material.xml
msgid "Minimum value for the [member render_priority] parameter."
msgstr "Valor mínimo para o parâmetro [member render_priority]."

#: doc/classes/MenuBar.xml
msgid "A horizontal menu bar that creates a menu for each [PopupMenu] child."
msgstr ""
"Uma barra de menus horizontal que cria um menu para cada filho [PopupMenu]."

#: doc/classes/MenuBar.xml
msgid ""
"A horizontal menu bar that creates a menu for each [PopupMenu] child. New "
"items are created by adding [PopupMenu]s to this node. Item title is "
"determined by [member Window.title], or node name if [member Window.title] "
"is empty. Item title can be overridden using [method set_menu_title]."
msgstr ""
"Uma barra de menu horizontal que cria um menu para cada filho [PopupMenu]. "
"Novos itens são criados adicionando [PopupMenu]s a este nó. O título do item "
"é determinado por [member Window.title], ou pelo nome do nó se [member "
"Window.title] estiver vazio. O título do item pode ser sobrescrito usando "
"[method set_menu_title]."

#: doc/classes/MenuBar.xml
msgid "Returns number of menu items."
msgstr "Retorna o número de itens de menu."

#: doc/classes/MenuBar.xml
msgid "Returns [PopupMenu] associated with menu item."
msgstr "Retorna o [PopupMenu] associado ao item de menu."

#: doc/classes/MenuBar.xml
msgid "Returns menu item title."
msgstr "Retorna o título do item de menu."

#: doc/classes/MenuBar.xml
msgid "Returns menu item tooltip."
msgstr "Retorna a dica de ferramenta do item de menu."

#: doc/classes/MenuBar.xml
msgid "Returns [code]true[/code] if the menu item is disabled."
msgstr "Retorna [code]true[/code] se o item de menu estiver desativado."

#: doc/classes/MenuBar.xml
msgid "Returns [code]true[/code] if the menu item is hidden."
msgstr "Retorna [code]true[/code] se o item de menu estiver oculto."

#: doc/classes/MenuBar.xml
msgid ""
"Returns [code]true[/code] if the current system's global menu is supported "
"and used by this [MenuBar]."
msgstr ""
"Retorna [code]true[/code] se o menu global do sistema atual for suportado e "
"usado por este [MenuBar]."

#: doc/classes/MenuBar.xml doc/classes/MenuButton.xml
#: doc/classes/OptionButton.xml
msgid ""
"If [code]true[/code], shortcuts are disabled and cannot be used to trigger "
"the button."
msgstr ""
"Se [code]true[/code], os atalhos são desativados e não podem ser usados para "
"acionar o botão."

#: doc/classes/MenuBar.xml
msgid "If [code]true[/code], menu item is disabled."
msgstr "Se [code]true[/code], o item do menu é desativado."

#: doc/classes/MenuBar.xml
msgid "If [code]true[/code], menu item is hidden."
msgstr "Se [code]true[/code], o item estará oculto."

#: doc/classes/MenuBar.xml
msgid "Sets menu item title."
msgstr "Define o título do item de menu."

#: doc/classes/MenuBar.xml
msgid "Sets menu item tooltip."
msgstr "Define a dica de ferramenta do item de menu."

#: doc/classes/MenuBar.xml
msgid "Flat [MenuBar] don't display item decoration."
msgstr "[MenuBar] planos não exibem decoração de itens."

#: doc/classes/MenuBar.xml
msgid ""
"If [code]true[/code], [MenuBar] will use system global menu when supported.\n"
"[b]Note:[/b] If [code]true[/code] and global menu is supported, this node is "
"not displayed, has zero size, and all its child nodes except [PopupMenu]s "
"are inaccessible.\n"
"[b]Note:[/b] This property overrides the value of the [member "
"PopupMenu.prefer_native_menu] property of the child nodes."
msgstr ""

#: doc/classes/MenuBar.xml
msgid ""
"Position order in the global menu to insert [MenuBar] items at. All menu "
"items in the [MenuBar] are always inserted as a continuous range. Menus with "
"lower [member start_index] are inserted first. Menus with [member "
"start_index] equal to [code]-1[/code] are inserted last."
msgstr ""
"Ordem de posição no menu global onde os itens do [MenuBar] devem ser "
"inseridos. Todos os itens de menu no [MenuBar] são sempre inseridos como um "
"intervalo contínuo. Menus com [member start_index] menor são inseridos "
"primeiro. Menus com [member start_index] igual a [code]-1[/code] são "
"inseridos por último."

#: doc/classes/MenuBar.xml
msgid ""
"If [code]true[/code], when the cursor hovers above menu item, it will close "
"the current [PopupMenu] and open the other one."
msgstr ""
"Se [code]true[/code], quando o cursor passar o mouse sobre o item de menu, "
"ele fechará o [PopupMenu] atual e abrirá o outro."

#: doc/classes/MenuBar.xml
msgid "Default text [Color] of the menu item."
msgstr "[Color] padrão do texto do item de menu."

#: doc/classes/MenuBar.xml
msgid "Text [Color] used when the menu item is disabled."
msgstr "[Color] do texto usada quando o item do menu está desativado."

#: doc/classes/MenuBar.xml
msgid ""
"Text [Color] used when the menu item is focused. Only replaces the normal "
"text color of the menu item. Disabled, hovered, and pressed states take "
"precedence over this color."
msgstr ""
"[Color] do texto usada quando o item de menu está em foco. Substitui apenas "
"a cor de texto normal do item de menu. Os estados desativado, com o cursor "
"sobre ele e pressionado têm precedência sobre esta cor."

#: doc/classes/MenuBar.xml
msgid "Text [Color] used when the menu item is being hovered."
msgstr "[Color] do texto usado quando o item do menu está com o mouse em cima."

#: doc/classes/MenuBar.xml
msgid "Text [Color] used when the menu item is being hovered and pressed."
msgstr ""
"[Color] do texto usada quando o item do menu está recebendo foco e sendo "
"pressionado."

#: doc/classes/MenuBar.xml doc/classes/PopupMenu.xml
msgid "The tint of text outline of the menu item."
msgstr "O tom do contorno do texto do item de menu."

#: doc/classes/MenuBar.xml
msgid "Text [Color] used when the menu item is being pressed."
msgstr "[Color] do texto usado quando o item do menu está sendo pressionado."

#: doc/classes/MenuBar.xml
msgid "The horizontal space between menu items."
msgstr "O espaço horizontal entre os itens de menu."

#: doc/classes/MenuBar.xml
msgid "[Font] of the menu item's text."
msgstr "[Font] do texto do item de menu."

#: doc/classes/MenuBar.xml
msgid "Font size of the menu item's text."
msgstr "Tamanho da fonte do texto do item de menu."

#: doc/classes/MenuBar.xml
msgid "[StyleBox] used when the menu item is disabled."
msgstr "[StyleBox] usado quando o item do menu está desativado."

#: doc/classes/MenuBar.xml
msgid ""
"[StyleBox] used when the menu item is disabled (for right-to-left layouts)."
msgstr ""
"[StyleBox] usado quando o item de menu está desativado (para layouts da "
"direita para a esquerda)."

#: doc/classes/MenuBar.xml
msgid "[StyleBox] used when the menu item is being hovered."
msgstr "[StyleBox] usado quando o item do menu está com o mouse em cima."

#: doc/classes/MenuBar.xml
msgid ""
"[StyleBox] used when the menu item is being hovered (for right-to-left "
"layouts)."
msgstr ""
"[StyleBox] usado quando o item de menu está com o cursor em cima (para "
"layouts da direita para a esquerda)."

#: doc/classes/MenuBar.xml
msgid ""
"[StyleBox] used when the menu item is being pressed and hovered at the same "
"time."
msgstr ""
"[StyleBox] usado quando o item do menu é pressionado e está com o cursor "
"sobre ele ao mesmo tempo."

#: doc/classes/MenuBar.xml
msgid ""
"[StyleBox] used when the menu item is being pressed and hovered at the same "
"time (for right-to-left layouts)."
msgstr ""
"[StyleBox] usado quando o item do menu está sendo pressionado e com o mouse "
"sobre ele ao mesmo tempo (para layouts da direita para a esquerda)."

#: doc/classes/MenuBar.xml
msgid "Default [StyleBox] for the menu item."
msgstr "[StyleBox] padrão para o item de menu."

#: doc/classes/MenuBar.xml
msgid "Default [StyleBox] for the menu item (for right-to-left layouts)."
msgstr ""
"[StyleBox] padrão para o item de menu (para layouts da direita para a "
"esquerda)."

#: doc/classes/MenuBar.xml
msgid "[StyleBox] used when the menu item is being pressed."
msgstr "[StyleBox] usado quando o item do menu está sendo pressionado."

#: doc/classes/MenuBar.xml
msgid ""
"[StyleBox] used when the menu item is being pressed (for right-to-left "
"layouts)."
msgstr ""
"[StyleBox] usado quando o item de menu está sendo pressionado (para layouts "
"da direita para a esquerda)."

#: doc/classes/MenuButton.xml
msgid "A button that brings up a [PopupMenu] when clicked."
msgstr "Um botão que abre um [PopupMenu] quando clicado."

#: doc/classes/MenuButton.xml
msgid ""
"A button that brings up a [PopupMenu] when clicked. To create new items "
"inside this [PopupMenu], use [code]get_popup().add_item(\"My Item Name\")[/"
"code]. You can also create them directly from Godot editor's inspector.\n"
"See also [BaseButton] which contains common properties and methods "
"associated with this node."
msgstr ""

#: doc/classes/MenuButton.xml doc/classes/OptionButton.xml
msgid ""
"Returns the [PopupMenu] contained in this button.\n"
"[b]Warning:[/b] This is a required internal node, removing and freeing it "
"may cause a crash. If you wish to hide it or any of its children, use their "
"[member Window.visible] property."
msgstr ""

#: doc/classes/MenuButton.xml
msgid ""
"Adjusts popup position and sizing for the [MenuButton], then shows the "
"[PopupMenu]. Prefer this over using [code]get_popup().popup()[/code]."
msgstr ""
"Ajusta a posição e o tamanho do pop-up para o [MenuButton], e então mostra o "
"[PopupMenu]. Prefira isso em vez de usar [code]get_popup().popup()[/code]."

#: doc/classes/MenuButton.xml doc/classes/PopupMenu.xml
msgid ""
"The checkable item type of the item at [code]index[/code].\n"
"[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. item_count - 1[/"
"code] range."
msgstr ""

#: doc/classes/MenuButton.xml doc/classes/PopupMenu.xml
msgid ""
"If [code]true[/code], the item at [code]index[/code] is checked.\n"
"[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. item_count - 1[/"
"code] range."
msgstr ""
"Se [code]true[/code], o item no [code]index[/code] está marcado.\n"
"[b]Nota:[/b] [code]index[/code] é um valor no intervalo [code]0 .. "
"item_count - 1[/code]."

#: doc/classes/MenuButton.xml doc/classes/OptionButton.xml
#: doc/classes/PopupMenu.xml
msgid ""
"The ID of the item at [code]index[/code].\n"
"[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. item_count - 1[/"
"code] range."
msgstr ""

#: doc/classes/MenuButton.xml doc/classes/OptionButton.xml
#: doc/classes/PopupMenu.xml
msgid ""
"If [code]true[/code], the item at [code]index[/code] is a separator.\n"
"[b]Note:[/b] [code]index[/code] is a value in the [code]0 .. item_count - 1[/"
"code] range."
msgstr ""

#: doc/classes/MenuButton.xml
msgid ""
"If [code]true[/code], when the cursor hovers above another [MenuButton] "
"within the same parent which also has [member switch_on_hover] enabled, it "
"will close the current [MenuButton] and open the other one."
msgstr ""
"Se [code]true[/code], quando o cursor passar o mouse sobre outro "
"[MenuButton] dentro do mesmo pai que também tenha [member switch_on_hover] "
"ativado, ele fechará o [MenuButton] atual e abrirá o outro."

#: doc/classes/MenuButton.xml
msgid "Emitted when the [PopupMenu] of this MenuButton is about to show."
msgstr ""
"Emitido quando o [PopupMenu] deste MenuButton está prestes a ser exibido."

#: doc/classes/Mesh.xml
msgid "A [Resource] that contains vertex array-based geometry."
msgstr "Um [Resource] que contém geometria baseada em array de vértices."

#: doc/classes/Mesh.xml
msgid ""
"Mesh is a type of [Resource] that contains vertex array-based geometry, "
"divided in [i]surfaces[/i]. Each surface contains a completely separate "
"array and a material used to draw it. Design wise, a mesh with multiple "
"surfaces is preferred to a single surface, because objects created in 3D "
"editing software commonly contain multiple materials. The maximum number of "
"surfaces per mesh is [constant RenderingServer.MAX_MESH_SURFACES]."
msgstr ""
"Mesh é um tipo de [Resource] que contém geometria baseada em array de "
"vértices, dividida em [i]superfícies[/i]. Cada superfície contém um array "
"completamente separado e um material usado para desenhá-la. Em termos de "
"design, uma malha com múltiplas superfícies é preferível a uma única "
"superfície, porque os objetos criados em softwares de edição 3D comumente "
"contêm múltiplos materiais. O número máximo de superfícies por malha é "
"[constant RenderingServer.MAX_MESH_SURFACES]."

#: doc/classes/Mesh.xml
msgid ""
"Virtual method to override the [AABB] for a custom class extending [Mesh]."
msgstr ""
"Método virtual para substituir o [AABB] para uma classe personalizada que "
"estende [Mesh]."

#: doc/classes/Mesh.xml
msgid ""
"Virtual method to override the number of blend shapes for a custom class "
"extending [Mesh]."
msgstr ""
"Método virtual para substituir o número de formas de mesclagem para uma "
"classe personalizada que estende [Mesh]."

#: doc/classes/Mesh.xml
msgid ""
"Virtual method to override the retrieval of blend shape names for a custom "
"class extending [Mesh]."
msgstr ""
"Método virtual para substituir a recuperação de nomes de formas de mesclagem "
"para uma classe personalizada que estende [Mesh]."

#: doc/classes/Mesh.xml
msgid ""
"Virtual method to override the surface count for a custom class extending "
"[Mesh]."
msgstr ""
"Método virtual para substituir a contagem de superfícies para uma classe "
"personalizada que estende [Mesh]."

#: doc/classes/Mesh.xml
msgid ""
"Virtual method to override the names of blend shapes for a custom class "
"extending [Mesh]."
msgstr ""
"Método virtual para substituir os nomes das formas de mesclagem para uma "
"classe personalizada que estende [Mesh]."

#: doc/classes/Mesh.xml
msgid ""
"Virtual method to override the surface array index length for a custom class "
"extending [Mesh]."
msgstr ""
"Método virtual para substituir o comprimento do índice da matriz de "
"superfície para uma classe personalizada que estende [Mesh]."

#: doc/classes/Mesh.xml
msgid ""
"Virtual method to override the surface array length for a custom class "
"extending [Mesh]."
msgstr ""
"Método virtual para substituir o comprimento do array de superfície para uma "
"classe personalizada que estende [Mesh]."

#: doc/classes/Mesh.xml
msgid ""
"Virtual method to override the surface arrays for a custom class extending "
"[Mesh]."
msgstr ""
"Método virtual para substituir as matrizes de superfície para uma classe "
"personalizada que estende [Mesh]."

#: doc/classes/Mesh.xml
msgid ""
"Virtual method to override the blend shape arrays for a custom class "
"extending [Mesh]."
msgstr ""
"Método virtual para substituir as matrizes de forma de mesclagem para uma "
"classe personalizada que estende [Mesh]."

#: doc/classes/Mesh.xml
msgid ""
"Virtual method to override the surface format for a custom class extending "
"[Mesh]."
msgstr ""
"Método virtual para substituir o formato de superfície para uma classe "
"personalizada que estende [Mesh]."

#: doc/classes/Mesh.xml
msgid ""
"Virtual method to override the surface LODs for a custom class extending "
"[Mesh]."
msgstr ""
"Método virtual para substituir os LODs de superfície para uma classe "
"personalizada que estende [Mesh]."

#: doc/classes/Mesh.xml
msgid ""
"Virtual method to override the surface material for a custom class extending "
"[Mesh]."
msgstr ""
"Método virtual para substituir o material de superfície para uma classe "
"personalizada que estende [Mesh]."

#: doc/classes/Mesh.xml
msgid ""
"Virtual method to override the surface primitive type for a custom class "
"extending [Mesh]."
msgstr ""
"Método virtual para substituir o tipo primitivo de superfície para uma "
"classe personalizada que estende [Mesh]."

#: doc/classes/Mesh.xml
msgid ""
"Virtual method to override the setting of a [param material] at the given "
"[param index] for a custom class extending [Mesh]."
msgstr ""
"Método virtual para substituir a configuração de um [param material] no "
"[param index] fornecido para uma classe personalizada que estende [Mesh]."

#: doc/classes/Mesh.xml
msgid ""
"Calculate a [ConvexPolygonShape3D] from the mesh.\n"
"If [param clean] is [code]true[/code] (default), duplicate and interior "
"vertices are removed automatically. You can set it to [code]false[/code] to "
"make the process faster if not needed.\n"
"If [param simplify] is [code]true[/code], the geometry can be further "
"simplified to reduce the number of vertices. Disabled by default."
msgstr ""

#: doc/classes/Mesh.xml
msgid ""
"Calculate an outline mesh at a defined offset (margin) from the original "
"mesh.\n"
"[b]Note:[/b] This method typically returns the vertices in reverse order "
"(e.g. clockwise to counterclockwise)."
msgstr ""

#: doc/classes/Mesh.xml
msgid "Creates a placeholder version of this resource ([PlaceholderMesh])."
msgstr "Cria uma versão de espaço reservado deste recurso ([PlaceholderMesh])."

#: doc/classes/Mesh.xml
msgid "Calculate a [ConcavePolygonShape3D] from the mesh."
msgstr "Calcula um [ConcavePolygonShape3D] a partir da malha."

#: doc/classes/Mesh.xml
msgid ""
"Generate a [TriangleMesh] from the mesh. Considers only surfaces using one "
"of these primitive types: [constant PRIMITIVE_TRIANGLES], [constant "
"PRIMITIVE_TRIANGLE_STRIP]."
msgstr ""
"Gera uma [TriangleMesh] a partir da malha. Considera apenas superfícies que "
"usam um destes tipos primitivos: [constant PRIMITIVE_TRIANGLES], [constant "
"PRIMITIVE_TRIANGLE_STRIP]."

#: doc/classes/Mesh.xml
msgid ""
"Returns the smallest [AABB] enclosing this mesh in local space. Not affected "
"by [code]custom_aabb[/code].\n"
"[b]Note:[/b] This is only implemented for [ArrayMesh] and [PrimitiveMesh]."
msgstr ""

#: doc/classes/Mesh.xml
msgid ""
"Returns all the vertices that make up the faces of the mesh. Each three "
"vertices represent one triangle."
msgstr ""
"Retorna todos os vértices que compõem as faces da malha. Cada três vértices "
"representam um triângulo."

#: doc/classes/Mesh.xml
msgid ""
"Returns the number of surfaces that the [Mesh] holds. This is equivalent to "
"[method MeshInstance3D.get_surface_override_material_count]."
msgstr ""
"Retorna o número de superfícies que a [Mesh] possui. Isso é equivalente a "
"[method MeshInstance3D.get_surface_override_material_count]."

#: doc/classes/Mesh.xml
msgid ""
"Returns the arrays for the vertices, normals, UVs, etc. that make up the "
"requested surface (see [method ArrayMesh.add_surface_from_arrays])."
msgstr ""
"Retorna os arrays para os vértices, normais, UVs, etc., que compõem a "
"superfície solicitada (veja [method ArrayMesh.add_surface_from_arrays])."

#: doc/classes/Mesh.xml
msgid "Returns the blend shape arrays for the requested surface."
msgstr ""
"Retorna as matrizes de formato de mesclagem para a superfície solicitada."

#: doc/classes/Mesh.xml
msgid ""
"Returns a [Material] in a given surface. Surface is rendered using this "
"material.\n"
"[b]Note:[/b] This returns the material within the [Mesh] resource, not the "
"[Material] associated to the [MeshInstance3D]'s Surface Material Override "
"properties. To get the [Material] associated to the [MeshInstance3D]'s "
"Surface Material Override properties, use [method "
"MeshInstance3D.get_surface_override_material] instead."
msgstr ""

#: doc/classes/Mesh.xml
msgid ""
"Sets a [Material] for a given surface. Surface will be rendered using this "
"material.\n"
"[b]Note:[/b] This assigns the material within the [Mesh] resource, not the "
"[Material] associated to the [MeshInstance3D]'s Surface Material Override "
"properties. To set the [Material] associated to the [MeshInstance3D]'s "
"Surface Material Override properties, use [method "
"MeshInstance3D.set_surface_override_material] instead."
msgstr ""

#: doc/classes/Mesh.xml
msgid "Sets a hint to be used for lightmap resolution."
msgstr "Define uma dica a ser usada para a resolução do mapa de luz."

#: doc/classes/Mesh.xml
msgid "Render array as points (one vertex equals one point)."
msgstr "Renderiza o array como pontos (um vértice equivale a um ponto)."

#: doc/classes/Mesh.xml
msgid "Render array as lines (every two vertices a line is created)."
msgstr ""
"Renderizar matriz como linhas (uma linha é criada a cada dois vértices)."

#: doc/classes/Mesh.xml
msgid "Render array as line strip."
msgstr "Renderizar o array como faixa de linhas."

#: doc/classes/Mesh.xml
msgid "Render array as triangles (every three vertices a triangle is created)."
msgstr ""
"Renderiza o array como triângulos (a cada três vértices, um triângulo é "
"criado)."

#: doc/classes/Mesh.xml
msgid "Render array as triangle strips."
msgstr "Renderizar o array como tiras de triângulos."

#: doc/classes/Mesh.xml
msgid ""
"[PackedVector3Array], [PackedVector2Array], or [Array] of vertex positions."
msgstr ""
"[PackedVector3Array], [PackedVector2Array] ou [Array] de posições de "
"vértices."

#: doc/classes/Mesh.xml
msgid ""
"[PackedVector3Array] of vertex normals.\n"
"[b]Note:[/b] The array has to consist of normal vectors, otherwise they will "
"be normalized by the engine, potentially causing visual discrepancies."
msgstr ""

#: doc/classes/Mesh.xml
msgid ""
"[PackedFloat32Array] of vertex tangents. Each element in groups of 4 floats, "
"first 3 floats determine the tangent, and the last the binormal direction as "
"-1 or 1."
msgstr ""
"[PackedFloat32Array] de tangentes de vértices. Cada elemento em grupos de 4 "
"floats, os primeiros 3 floats determinam a tangente e o último a direção do "
"binormal como -1 ou 1."

#: doc/classes/Mesh.xml
msgid "[PackedColorArray] of vertex colors."
msgstr "[PackedColorArray] de cores de vértices."

#: doc/classes/Mesh.xml
msgid "[PackedVector2Array] for UV coordinates."
msgstr "[PackedVector2Array] para coordenadas UV."

#: doc/classes/Mesh.xml
msgid "[PackedVector2Array] for second UV coordinates."
msgstr "[PackedVector2Array] para as segundas coordenadas UV."

#: doc/classes/Mesh.xml
msgid ""
"Contains custom color channel 0. [PackedByteArray] if [code](format >> "
"Mesh.ARRAY_FORMAT_CUSTOM0_SHIFT) & Mesh.ARRAY_FORMAT_CUSTOM_MASK[/code] is "
"[constant ARRAY_CUSTOM_RGBA8_UNORM], [constant ARRAY_CUSTOM_RGBA8_SNORM], "
"[constant ARRAY_CUSTOM_RG_HALF], or [constant ARRAY_CUSTOM_RGBA_HALF]. "
"[PackedFloat32Array] otherwise."
msgstr ""
"Contém o canal de cor personalizado 0. [PackedByteArray] se [code](format >> "
"Mesh.ARRAY_FORMAT_CUSTOM0_SHIFT) & Mesh.ARRAY_FORMAT_CUSTOM_MASK[/code] for "
"[constant ARRAY_CUSTOM_RGBA8_UNORM], [constant ARRAY_CUSTOM_RGBA8_SNORM], "
"[constant ARRAY_CUSTOM_RG_HALF] ou [constant ARRAY_CUSTOM_RGBA_HALF]. "
"[PackedFloat32Array] caso contrário."

#: doc/classes/Mesh.xml
msgid ""
"Contains custom color channel 1. [PackedByteArray] if [code](format >> "
"Mesh.ARRAY_FORMAT_CUSTOM1_SHIFT) & Mesh.ARRAY_FORMAT_CUSTOM_MASK[/code] is "
"[constant ARRAY_CUSTOM_RGBA8_UNORM], [constant ARRAY_CUSTOM_RGBA8_SNORM], "
"[constant ARRAY_CUSTOM_RG_HALF], or [constant ARRAY_CUSTOM_RGBA_HALF]. "
"[PackedFloat32Array] otherwise."
msgstr ""
"Contém o canal de cor personalizado 1. [PackedByteArray] se [code](format >> "
"Mesh.ARRAY_FORMAT_CUSTOM1_SHIFT) & Mesh.ARRAY_FORMAT_CUSTOM_MASK[/code] for "
"[constant ARRAY_CUSTOM_RGBA8_UNORM], [constant ARRAY_CUSTOM_RGBA8_SNORM], "
"[constant ARRAY_CUSTOM_RG_HALF] ou [constant ARRAY_CUSTOM_RGBA_HALF]. "
"[PackedFloat32Array] caso contrário."

#: doc/classes/Mesh.xml
msgid ""
"Contains custom color channel 2. [PackedByteArray] if [code](format >> "
"Mesh.ARRAY_FORMAT_CUSTOM2_SHIFT) & Mesh.ARRAY_FORMAT_CUSTOM_MASK[/code] is "
"[constant ARRAY_CUSTOM_RGBA8_UNORM], [constant ARRAY_CUSTOM_RGBA8_SNORM], "
"[constant ARRAY_CUSTOM_RG_HALF], or [constant ARRAY_CUSTOM_RGBA_HALF]. "
"[PackedFloat32Array] otherwise."
msgstr ""
"Contém o canal de cor personalizado 2. [PackedByteArray] se [code](format >> "
"Mesh.ARRAY_FORMAT_CUSTOM2_SHIFT) & Mesh.ARRAY_FORMAT_CUSTOM_MASK[/code] for "
"[constant ARRAY_CUSTOM_RGBA8_UNORM], [constant ARRAY_CUSTOM_RGBA8_SNORM], "
"[constant ARRAY_CUSTOM_RG_HALF] ou [constant ARRAY_CUSTOM_RGBA_HALF]. "
"[PackedFloat32Array] caso contrário."

#: doc/classes/Mesh.xml
msgid ""
"Contains custom color channel 3. [PackedByteArray] if [code](format >> "
"Mesh.ARRAY_FORMAT_CUSTOM3_SHIFT) & Mesh.ARRAY_FORMAT_CUSTOM_MASK[/code] is "
"[constant ARRAY_CUSTOM_RGBA8_UNORM], [constant ARRAY_CUSTOM_RGBA8_SNORM], "
"[constant ARRAY_CUSTOM_RG_HALF], or [constant ARRAY_CUSTOM_RGBA_HALF]. "
"[PackedFloat32Array] otherwise."
msgstr ""
