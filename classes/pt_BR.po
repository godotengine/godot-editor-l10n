msgstr ""
"Retorna o retângulo alinhado aos eixos para a malha de navegação "
"transformada da região."

#: doc/classes/NavigationRegion2D.xml doc/classes/NavigationRegion3D.xml
msgid "Returns the current navigation map [RID] used by this region."
msgstr "Retorna o [RID] do mapa de navegação atual usado por esta região."

#: doc/classes/NavigationRegion2D.xml doc/classes/NavigationRegion3D.xml
msgid "Use [method get_rid] instead."
msgstr "Use [method get_rid] em vez disso."

#: doc/classes/NavigationRegion2D.xml
msgid "Returns the [RID] of this region on the [NavigationServer2D]."
msgstr "Retorna o [RID] desta região no [NavigationServer2D]."

#: doc/classes/NavigationRegion2D.xml
msgid ""
"Returns the [RID] of this region on the [NavigationServer2D]. Combined with "
"[method NavigationServer2D.map_get_closest_point_owner] can be used to "
"identify the [NavigationRegion2D] closest to a point on the merged "
