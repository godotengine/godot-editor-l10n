#: doc/classes/AESContext.xml
msgid "Provides access to AES encryption/decryption of raw data."
msgstr "Fornece acesso à criptografia/descriptografia AES de dados brutos."

#: doc/classes/AESContext.xml
msgid ""
"This class holds the context information required for encryption and "
"decryption operations with AES (Advanced Encryption Standard). Both AES-ECB "
"and AES-CBC modes are supported.\n"
"[codeblocks]\n"
"[gdscript]\n"
"extends Node\n"
"\n"
"var aes = AESContext.new()\n"
"\n"
"func _ready():\n"
"\tvar key = \"My secret key!!!\" # Key must be either 16 or 32 bytes.\n"
"\tvar data = \"My secret text!!\" # Data size must be multiple of 16 bytes, "
"apply padding if needed.\n"
"\t# Encrypt ECB\n"
"\taes.start(AESContext.MODE_ECB_ENCRYPT, key.to_utf8_buffer())\n"
"\tvar encrypted = aes.update(data.to_utf8_buffer())\n"
"\taes.finish()\n"
"\t# Decrypt ECB\n"
"\taes.start(AESContext.MODE_ECB_DECRYPT, key.to_utf8_buffer())\n"
"\tvar decrypted = aes.update(encrypted)\n"
"\taes.finish()\n"
"\t# Check ECB\n"
"\tassert(decrypted == data.to_utf8_buffer())\n"
"\n"
"\tvar iv = \"My secret iv!!!!\" # IV must be of exactly 16 bytes.\n"
"\t# Encrypt CBC\n"
"\taes.start(AESContext.MODE_CBC_ENCRYPT, key.to_utf8_buffer(), "
"iv.to_utf8_buffer())\n"
"\tencrypted = aes.update(data.to_utf8_buffer())\n"
"\taes.finish()\n"
"\t# Decrypt CBC\n"
"\taes.start(AESContext.MODE_CBC_DECRYPT, key.to_utf8_buffer(), "
"iv.to_utf8_buffer())\n"
"\tdecrypted = aes.update(encrypted)\n"
"\taes.finish()\n"
"\t# Check CBC\n"
"\tassert(decrypted == data.to_utf8_buffer())\n"
"[/gdscript]\n"
"[csharp]\n"
"using Godot;\n"
"using System.Diagnostics;\n"
"\n"
"public partial class MyNode : Node\n"
"{\n"
"\tprivate AesContext _aes = new AesContext();\n"
"\n"
"\tpublic override void _Ready()\n"
"\t{\n"
"\t\tstring key = \"My secret key!!!\"; // Key must be either 16 or 32 "
"bytes.\n"
"\t\tstring data = \"My secret text!!\"; // Data size must be multiple of 16 "
"bytes, apply padding if needed.\n"
"\t\t// Encrypt ECB\n"
"\t\t_aes.Start(AesContext.Mode.EcbEncrypt, key.ToUtf8Buffer());\n"
"\t\tbyte[] encrypted = _aes.Update(data.ToUtf8Buffer());\n"
"\t\t_aes.Finish();\n"
"\t\t// Decrypt ECB\n"
"\t\t_aes.Start(AesContext.Mode.EcbDecrypt, key.ToUtf8Buffer());\n"
"\t\tbyte[] decrypted = _aes.Update(encrypted);\n"
"\t\t_aes.Finish();\n"
"\t\t// Check ECB\n"
"\t\tDebug.Assert(decrypted == data.ToUtf8Buffer());\n"
"\n"
"\t\tstring iv = \"My secret iv!!!!\"; // IV must be of exactly 16 bytes.\n"
"\t\t// Encrypt CBC\n"
"\t\t_aes.Start(AesContext.Mode.EcbEncrypt, key.ToUtf8Buffer(), "
"iv.ToUtf8Buffer());\n"
"\t\tencrypted = _aes.Update(data.ToUtf8Buffer());\n"
"\t\t_aes.Finish();\n"
"\t\t// Decrypt CBC\n"
"\t\t_aes.Start(AesContext.Mode.EcbDecrypt, key.ToUtf8Buffer(), "
"iv.ToUtf8Buffer());\n"
"\t\tdecrypted = _aes.Update(encrypted);\n"
"\t\t_aes.Finish();\n"
"\t\t// Check CBC\n"
"\t\tDebug.Assert(decrypted == data.ToUtf8Buffer());\n"
"\t}\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"Esta classe contém as informações de contexto necessárias para operações de "
"criptografia e descriptografia com AES (Advanced Encryption Standard). Ambos "
"os modos AES-ECB e AES-CBC são suportados.\n"
"[codeblocks]\n"
"[gdscript]\n"
"extends Node\n"
"\n"
"var aes = AESContext.new()\n"
"\n"
"func _ready():\n"
"\tvar key = \"My secret key!!!\" # A chave deve ter 16 ou 32 bytes.\n"
"\tvar data = \"My secret text!!\" # O tamanho dos dados deve ser múltiplo de "
"16 bytes, aplique preenchimento se necessário.\n"
"\t# Criptografar ECB\n"
"\taes.start(AESContext.MODE_ECB_ENCRYPT, key.to_utf8_buffer())\n"
"\tvar encrypted = aes.update(data.to_utf8_buffer())\n"
"\taes.finish()\n"
"\t# Descriptografar ECB\n"
"\taes.start(AESContext.MODE_ECB_DECRYPT, key.to_utf8_buffer())\n"
"\tvar decrypted = aes.update(encrypted)\n"
"\taes.finish()\n"
"\t# Verificar ECB\n"
"\tassert(decrypted == data.to_utf8_buffer())\n"
"\n"
"\tvar iv = \"My secret iv!!!!\" # O IV deve ter exatamente 16 bytes.\n"
"\t# Criptografar CBC\n"
"\taes.start(AESContext.MODE_CBC_ENCRYPT, key.to_utf8_buffer(), "
"iv.to_utf8_buffer())\n"
"\tencrypted = aes.update(data.to_utf8_buffer())\n"
"\taes.finish()\n"
"\t# Descriptografar CBC\n"
"\taes.start(AESContext.MODE_CBC_DECRYPT, key.to_utf8_buffer(), "
"iv.to_utf8_buffer())\n"
"\tdecrypted = aes.update(encrypted)\n"
"\taes.finish()\n"
"\t# Verificar CBC\n"
"\tassert(decrypted == data.to_utf8_buffer())\n"
"[/gdscript]\n"
"[csharp]\n"
"using Godot;\n"
"using System.Diagnostics;\n"
"\n"
"public partial class MyNode : Node\n"
"{\n"
"\tprivate AesContext _aes = new AesContext();\n"
"\n"
"\tpublic override void _Ready()\n"
"\t{\n"
"\t\tstring key = \"My secret key!!!\"; // A chave deve ter 16 ou 32 bytes.\n"
"\t\tstring data = \"My secret text!!\"; // O tamanho dos dados deve ser "
"múltiplo de 16 bytes, aplique preenchimento se necessário.\n"
"\t\t// Criptografar ECB\n"
"\t\t_aes.Start(AesContext.Mode.EcbEncrypt, key.ToUtf8Buffer());\n"
"\t\tbyte[] encrypted = _aes.Update(data.ToUtf8Buffer());\n"
"\t\t_aes.Finish();\n"
"\t\t// Descriptografar ECB\n"
"\t\t_aes.Start(AesContext.Mode.EcbDecrypt, key.ToUtf8Buffer());\n"
"\t\tbyte[] decrypted = _aes.Update(encrypted);\n"
"\t\t_aes.Finish();\n"
"\t\t// Verificar ECB\n"
"\t\tDebug.Assert(decrypted == data.ToUtf8Buffer());\n"
"\n"
"\t\tstring iv = \"My secret iv!!!!\"; // O IV deve ter exatamente 16 bytes.\n"
"\t\t// Criptografar CBC\n"
"\t\t_aes.Start(AesContext.Mode.EcbEncrypt, key.ToUtf8Buffer(), "
"iv.ToUtf8Buffer());\n"
"\t\tencrypted = _aes.Update(data.ToUtf8Buffer());\n"
"\t\t_aes.Finish();\n"
"\t\t// Descriptografar CBC\n"
"\t\t_aes.Start(AesContext.Mode.EcbDecrypt, key.ToUtf8Buffer(), "
"iv.ToUtf8Buffer());\n"
"\t\tdecrypted = _aes.Update(encrypted);\n"
"\t\t_aes.Finish();\n"
"\t\t// Verificar CBC\n"
"\t\tDebug.Assert(decrypted == data.ToUtf8Buffer());\n"
"\t}\n"
"}\n"
"[/csharp]\n"
"[/codeblocks]"

#: doc/classes/AESContext.xml
msgid "Close this AES context so it can be started again. See [method start]."
msgstr ""
"Feche este contexto de AES para que ele possa ser iniciado novamente. Veja "
"[method start]."

#: doc/classes/AESContext.xml
msgid ""
"Get the current IV state for this context (IV gets updated when calling "
"[method update]). You normally don't need this function.\n"
"[b]Note:[/b] This function only makes sense when the context is started with "
"[constant MODE_CBC_ENCRYPT] or [constant MODE_CBC_DECRYPT]."
msgstr ""
"Define o estado atual do IV para este contexto (o IV é atualizado ao chamar "
"[method update]). Normalmente, você não precisa desta função.\n"
"[b]Nota:[/b] Esta função faz sentido apenas se o contexto for iniciado com "
"[constant MODE_CBC_ENCRYPT] ou [constant MODE_CBC_DECRYPT]."

#: doc/classes/AESContext.xml
msgid ""
"Start the AES context in the given [param mode]. A [param key] of either 16 "
"or 32 bytes must always be provided, while an [param iv] (initialization "
"vector) of exactly 16 bytes, is only needed when [param mode] is either "
"[constant MODE_CBC_ENCRYPT] or [constant MODE_CBC_DECRYPT]."
msgstr ""
"Inicia o contexto de AES no [param mode] fornecido. Um [param key] de 16 ou "
"32 bytes deve sempre ser fornecido, enquanto um [param iv] (vetor de "
"inicialização) de exatamente 16 bytes só é necessário quando o [param mode] "
"for [constant MODE_CBC_ENCRYPT] ou [constant MODE_CBC_DECRYPT]."

#: doc/classes/AESContext.xml
msgid ""
"Run the desired operation for this AES context. Will return a "
"[PackedByteArray] containing the result of encrypting (or decrypting) the "
"given [param src]. See [method start] for mode of operation.\n"
"[b]Note:[/b] The size of [param src] must be a multiple of 16. Apply some "
"padding if needed."
msgstr ""
"Executa a operação desejada para este contexto AES. Retornará um "
"[PackedByteArray] contendo o resultado da criptografia (ou descriptografia) "
"do [param src]. Veja [method start] para obter informações sobre o modo de "
"operação.\n"
"[b]Nota:[/b] O tamanho de [param src] deve ser um múltiplo de 16. Aplique "
"algum preenchimento, se necessário."

#: doc/classes/AESContext.xml
msgid "AES electronic codebook encryption mode."
msgstr "Modo de criptografia de livro de códigos eletrônico (ECB) do AES."

#: doc/classes/AESContext.xml
msgid "AES electronic codebook decryption mode."
msgstr "Modo de descriptografia de livro de códigos eletrônico (ECB) do AES."

#: doc/classes/AESContext.xml
msgid "AES cipher block chaining encryption mode."
msgstr ""
"Modo de criptografia por encadeamento de blocos de cifras (CBC) do AES."

#: doc/classes/AESContext.xml
msgid "AES cipher block chaining decryption mode."
msgstr ""
"Modo de descriptografia por encadeamento de blocos de cifras (CBC) do AES."

#: doc/classes/AESContext.xml
msgid "Maximum value for the mode enum."
msgstr "Valor máximo para a enumeração de modo."

#: doc/classes/AimModifier3D.xml
msgid "The [AimModifier3D] rotates a bone to look at a reference bone."
msgstr ""
"O [AimModifier3D] rotaciona um osso para olhar para um osso de referência."

#: doc/classes/AimModifier3D.xml
msgid ""
"This is a simple version of [LookAtModifier3D] that only allows bone to the "
"reference without advanced options such as angle limitation or time-based "
"interpolation.\n"
"The feature is simplified, but instead it is implemented with smooth "
"tracking without euler, see [method set_use_euler]."
msgstr ""
"Esta é uma versão simplificada de [LookAtModifier3D] que permite apenas que "
"o osso siga a referência, sem opções avançadas, como limitação de ângulo ou "
"interpolação baseada no tempo.\n"
"O recurso é simplificado, mas, em contrapartida, é implementado com "
"rastreamento suave sem o uso de Euler. Veja [method set_use_euler]."

#: doc/classes/AimModifier3D.xml
msgid "Returns the forward axis of the bone."
msgstr "Retorna o eixo frontal do osso."

#: doc/classes/AimModifier3D.xml
msgid ""
"Returns the axis of the first rotation. It is enabled only if [method "
"is_using_euler] is [code]true[/code]."
msgstr ""
"Retorna o eixo da primeira rotação. Só é habilitado se [method "
"is_using_euler] for [code]true[/code]."

#: doc/classes/AimModifier3D.xml doc/classes/ConvertTransformModifier3D.xml
#: doc/classes/CopyTransformModifier3D.xml
msgid ""
"Returns [code]true[/code] if the relative option is enabled in the setting "
"at [param index]."
msgstr ""
"Retorna [code]true[/code] se a opção relativa estiver habilitada na "
"configuração em [param index]."

#: doc/classes/AimModifier3D.xml
msgid "Returns [code]true[/code] if it provides rotation with using euler."
msgstr ""
"Retorna [code]true[/code] se utilizar ângulos de Euler para representar a "
"rotação."

#: doc/classes/AimModifier3D.xml
msgid ""
"Returns [code]true[/code] if it provides rotation by two axes. It is enabled "
"only if [method is_using_euler] is [code]true[/code]."
msgstr ""
"Retorna [code]true[/code] se a rotação for representada por dois eixos. Essa "
"opção só é habilitada se [method is_using_euler] for [code]true[/code]."

#: doc/classes/AimModifier3D.xml
msgid "Sets the forward axis of the bone."
msgstr "Define o eixo frontal do osso."

#: doc/classes/AimModifier3D.xml
msgid ""
"Sets the axis of the first rotation. It is enabled only if [method "
"is_using_euler] is [code]true[/code]."
msgstr ""
"Define o eixo da primeira rotação. Essa opção só é habilitada se [method "
"is_using_euler] for [code]true[/code]."

#: doc/classes/AimModifier3D.xml
msgid ""
"Sets relative option in the setting at [param index] to [param enabled].\n"
"If sets [param enabled] to [code]true[/code], the rotation is applied "
"relative to the pose.\n"
"If sets [param enabled] to [code]false[/code], the rotation is applied "
"relative to the rest. It means to replace the current pose with the "
"[AimModifier3D]'s result."
msgstr ""
"Define a opção relativa na configuração em [param index] como [param "
"enabled].\n"
"Se [param enabled] for definido como [code]true[/code], a rotação será "
"aplicada em relação à pose.\n"
"Se [param enabled] for definido como [code]false[/code], a rotação será "
"aplicada em relação ao repouso. Isso significa substituir a pose atual pelo "
"resultado de [AimModifier3D]."

#: doc/classes/AimModifier3D.xml
msgid ""
"If sets [param enabled] to [code]true[/code], it provides rotation with "
"using euler.\n"
"If sets [param enabled] to [code]false[/code], it provides rotation with "
"using rotation by arc generated from the forward axis vector and the vector "
"toward the reference."
msgstr ""
"Se [param enabled] for definido como [code]true[/code], este método "
"fornecerá a rotação utilizando ângulos de Euler.\n"
"Se [param enabled] for definido como [code]false[/code], este método "
"fornecerá a rotação utilizando o arco gerado a partir do vetor do eixo "
"frontal e do vetor em direção à referência."

#: doc/classes/AimModifier3D.xml
msgid ""
"If sets [param enabled] to [code]true[/code], it provides rotation by two "
"axes. It is enabled only if [method is_using_euler] is [code]true[/code]."
msgstr ""
"Se definir [param enabled] como [code]true[/code], ele fornece rotação por "
"dois eixos. É ativado apenas se [method is_using_euler] for [code]true[/"
"code]."

#: doc/classes/AimModifier3D.xml doc/classes/ConvertTransformModifier3D.xml
#: doc/classes/CopyTransformModifier3D.xml
msgid "The number of settings in the modifier."
msgstr "O número de configurações no modificador."

#: doc/classes/AnimatableBody2D.xml
msgid ""
"A 2D physics body that can't be moved by external forces. When moved "
"manually, it affects other bodies in its path."
msgstr ""
"Um corpo físico 2D que não pode ser movido por forças externas. Quando "
"movido manualmente, ele afeta outros corpos em seu caminho."

#: doc/classes/AnimatableBody2D.xml
msgid ""
"An animatable 2D physics body. It can't be moved by external forces or "
"contacts, but can be moved manually by other means such as code, "
"[AnimationMixer]s (with [member AnimationMixer.callback_mode_process] set to "
"[constant AnimationMixer.ANIMATION_CALLBACK_MODE_PROCESS_PHYSICS]), and "
"[RemoteTransform2D].\n"
"When [AnimatableBody2D] is moved, its linear and angular velocity are "
"estimated and used to affect other physics bodies in its path. This makes it "
"useful for moving platforms, doors, and other moving objects."
msgstr ""
"Um corpo físico 2D animável. Não pode ser movido por forças externas nem por "
"contatos, mas pode ser movido manualmente por outros meios, como código, "
"[AnimationMixer]s (com [member AnimationMixer.callback_mode_process] "
"definido como [constant "
"AnimationMixer.ANIMATION_CALLBACK_MODE_PROCESS_PHYSICS]) e "
"[RemoteTransform2D].\n"
"Quando [AnimatableBody2D] é movido, sua velocidade linear e angular são "
"estimadas e usadas para afetar outros corpos físicos em seu caminho. Isso o "
"torna útil para plataformas, portas e outros objetos móveis."

