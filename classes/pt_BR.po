msgstr "Define o fator de escala da fonte de bitmap colorida."

#: doc/classes/FontFile.xml doc/classes/TextServer.xml
#: doc/classes/TextServerExtension.xml
msgid "Sets pixel offset of the underline below the baseline."
msgstr "Define o deslocamento de pixel do sublinhado abaixo da linha de base."

#: doc/classes/FontFile.xml doc/classes/TextServer.xml
#: doc/classes/TextServerExtension.xml
msgid "Sets thickness of the underline in pixels."
msgstr "Define a espessura do sublinhado em pixels."

#: doc/classes/FontFile.xml
msgid ""
"Sets embolden strength, if is not equal to zero, emboldens the font "
"outlines. Negative values reduce the outline thickness."
msgstr ""
"Define a força de negrito; se não for igual a zero, aplica negrito aos "
"contornos da fonte. Valores negativos reduzem a espessura do contorno."

#: doc/classes/FontFile.xml doc/classes/TextServer.xml
#: doc/classes/TextServerExtension.xml
