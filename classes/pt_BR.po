msgstr "Remove todos os tamanhos de fonte da entrada do cache."

#: doc/classes/FontFile.xml
msgid ""
"Removes all textures from font cache entry.\n"
"[b]Note:[/b] This function will not remove glyphs associated with the "
"texture, use [method remove_glyph] to remove them manually."
msgstr ""

#: doc/classes/FontFile.xml doc/classes/TextServer.xml
#: doc/classes/TextServerExtension.xml
msgid "Returns the font ascent (number of pixels above the baseline)."
msgstr "Retorna a ascensão da fonte (número de pixels acima da linha de base)."

#: doc/classes/FontFile.xml
msgid "Returns number of the font cache entries."
msgstr "Retorna o número de entradas de cache de fontes."

#: doc/classes/FontFile.xml doc/classes/TextServer.xml
#: doc/classes/TextServerExtension.xml
msgid "Returns the font descent (number of pixels below the baseline)."
msgstr "Retorna a descida da fonte (número de pixels abaixo da linha de base)."

#: doc/classes/FontFile.xml doc/classes/TextServer.xml
#: doc/classes/TextServerExtension.xml
msgid "Returns scaling factor of the color bitmap font."
msgstr "Retorna o fator de escala da fonte bitmap colorida."

#: doc/classes/FontFile.xml doc/classes/TextLine.xml
#: doc/classes/TextParagraph.xml doc/classes/TextServer.xml
#: doc/classes/TextServerExtension.xml
msgid "Returns pixel offset of the underline below the baseline."
msgstr "Retorna o deslocamento de pixel do sublinhado abaixo da linha de base."

#: doc/classes/FontFile.xml doc/classes/TextServer.xml
#: doc/classes/TextServerExtension.xml
msgid "Returns thickness of the underline in pixels."
msgstr "Retorna a espessura do sublinhado em pixels."

#: doc/classes/FontFile.xml
msgid ""
"Returns character code associated with [param glyph_index], or [code]0[/"
"code] if [param glyph_index] is invalid. See [method get_glyph_index]."
msgstr ""
"Retorna o código de caractere associado a [param glyph_index], ou [code]0[/"
"code] se [param glyph_index] for inválido. Veja [method get_glyph_index]."

#: doc/classes/FontFile.xml
msgid ""
"Returns embolden strength, if is not equal to zero, emboldens the font "
"outlines. Negative values reduce the outline thickness."
msgstr ""
"Retorna a força de negrito; se não for igual a zero, aplica negrito aos "
"contornos da fonte. Valores negativos reduzem a espessura do contorno."

#: doc/classes/FontFile.xml doc/classes/TextServer.xml
#: doc/classes/TextServerExtension.xml
msgid "Returns extra baseline offset (as a fraction of font height)."
msgstr ""
"Retorna o deslocamento de linha de base extra (como uma fração da altura da "
"fonte)."

#: doc/classes/FontFile.xml
msgid ""
"Returns spacing for [param spacing] in pixels (not relative to the font "
"size)."
msgstr ""
"Retorna o espaçamento para [param spacing] em pixels (não relativo ao "
"tamanho da fonte)."

#: doc/classes/FontFile.xml doc/classes/TextServer.xml
#: doc/classes/TextServerExtension.xml
msgid "Returns an active face index in the TrueType / OpenType collection."
msgstr "Retorna um índice de face ativo na coleção TrueType / OpenType."

#: doc/classes/FontFile.xml doc/classes/TextServer.xml
msgid ""
"Returns glyph advance (offset of the next glyph).\n"
"[b]Note:[/b] Advance for glyphs outlines is the same as the base glyph "
"advance and is not saved."
msgstr ""

#: doc/classes/FontFile.xml doc/classes/TextServerExtension.xml
msgid ""
"Returns the glyph index of a [param char], optionally modified by the [param "
"variation_selector]."
msgstr ""
"Retorna o índice de glyph de um [param char], opcionalmente modificado pelo "
"[param variation_selector]."

#: doc/classes/FontFile.xml doc/classes/TextServer.xml
#: doc/classes/TextServerExtension.xml
msgid "Returns list of rendered glyphs in the cache entry."
msgstr "Retorna a lista de glifos renderizados na entrada do cache."

#: doc/classes/FontFile.xml doc/classes/TextServer.xml
#: doc/classes/TextServerExtension.xml
msgid "Returns glyph offset from the baseline."
msgstr "Retorna o deslocamento do glifo a partir da linha de base."

#: doc/classes/FontFile.xml
msgid "Returns glyph size."
msgstr "Retorna o tamanho do glifo."

#: doc/classes/FontFile.xml doc/classes/TextServer.xml
#: doc/classes/TextServerExtension.xml
msgid "Returns index of the cache texture containing the glyph."
msgstr "Retorna o índice da textura de cache que contém o glifo."

#: doc/classes/FontFile.xml doc/classes/TextServer.xml
#: doc/classes/TextServerExtension.xml
msgid "Returns rectangle in the cache texture containing the glyph."
msgstr "Retorna o retângulo na textura de cache que contém o glifo."

#: doc/classes/FontFile.xml doc/classes/TextServer.xml
#: doc/classes/TextServerExtension.xml
msgid "Returns kerning for the pair of glyphs."
msgstr "Retorna o kerning para o par de glifos."

#: doc/classes/FontFile.xml doc/classes/TextServer.xml
#: doc/classes/TextServerExtension.xml
msgid "Returns list of the kerning overrides."
msgstr "Retorna a lista das sobrescritas de kerning."

#: doc/classes/FontFile.xml doc/classes/TextServer.xml
#: doc/classes/TextServerExtension.xml
msgid ""
"Returns [code]true[/code] if support override is enabled for the [param "
"language]."
msgstr ""
"Retorna [code]true[/code] se a substituição de suporte estiver ativada para "
"o [param language]."

#: doc/classes/FontFile.xml doc/classes/TextServer.xml
#: doc/classes/TextServerExtension.xml
msgid "Returns list of language support overrides."
msgstr "Retorna a lista de substituições de suporte a idiomas."

#: doc/classes/FontFile.xml doc/classes/TextServer.xml
#: doc/classes/TextServerExtension.xml
msgid ""
"Returns [code]true[/code] if support override is enabled for the [param "
"script]."
msgstr ""
"Retorna [code]true[/code] se a substituição de suporte estiver habilitada "
"para o [param script]."

#: doc/classes/FontFile.xml doc/classes/TextServer.xml
#: doc/classes/TextServerExtension.xml
msgid "Returns list of script support overrides."
msgstr "Retorna a lista de substituições de suporte a scripts."

#: doc/classes/FontFile.xml doc/classes/TextServer.xml
#: doc/classes/TextServerExtension.xml
msgid ""
"Returns list of the font sizes in the cache. Each size is [Vector2i] with "
"font size and outline size."
msgstr ""
"Retorna a lista dos tamanhos de fonte no cache. Cada tamanho é um [Vector2i] "
"com o tamanho da fonte e o tamanho do contorno."

#: doc/classes/FontFile.xml doc/classes/TextServer.xml
#: doc/classes/TextServerExtension.xml
msgid "Returns number of textures used by font cache entry."
msgstr "Retorna o número de texturas usadas pela entrada do cache de fontes."

#: doc/classes/FontFile.xml
msgid "Returns a copy of the font cache texture image."
msgstr "Retorna uma cópia da imagem de textura do cache de fontes."

#: doc/classes/FontFile.xml
msgid "Returns a copy of the array containing glyph packing data."
msgstr "Retorna uma cópia da matriz contendo dados de empacotamento de glifos."

#: doc/classes/FontFile.xml
msgid ""
"Returns 2D transform, applied to the font outlines, can be used for "
"slanting, flipping and rotating glyphs."
msgstr ""
"Retorna a transformação 2D aplicada aos contornos da fonte, podendo ser "
"usada para inclinar, inverter e rotacionar glifos."

#: doc/classes/FontFile.xml
msgid ""
"Returns variation coordinates for the specified font cache entry. See "
"[method Font.get_supported_variation_list] for more info."
msgstr ""
"Retorna as coordenadas de variação para a entrada de cache de fonte "
"especificada. Veja [method Font.get_supported_variation_list] para mais "
"informações."

#: doc/classes/FontFile.xml
msgid ""
"Loads an AngelCode BMFont (.fnt, .font) bitmap font from file [param path].\n"
"[b]Warning:[/b] This method should only be used in the editor or in cases "
"when you need to load external fonts at run-time, such as fonts located at "
"the [code]user://[/code] directory."
