msgstr "Subtrai um vetor de outro vetor."

#: doc/classes/Rect2.xml
#, fuzzy
msgid "Constructs a [Rect2] by [param position] and [param size]."
msgstr "Subtrai um vetor de outro vetor."

#: doc/classes/Rect2.xml
