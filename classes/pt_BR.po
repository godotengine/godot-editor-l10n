"Returns all response headers as a [Dictionary]. Each entry is composed by "
"the header name, and a [String] containing the values separated by [code]\"; "
"\"[/code]. The casing is kept the same as the headers were received.\n"
"[codeblock]\n"
"{\n"
"\t\"content-length\": 12,\n"
"\t\"Content-Type\": \"application/json; charset=UTF-8\",\n"
"}\n"
"[/codeblock]"
msgstr ""

#: doc/classes/HTTPClient.xml
