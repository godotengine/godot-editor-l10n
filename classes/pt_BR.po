#: doc/classes/AudioEffect.xml
msgid ""
"Override this method to customize the [AudioEffectInstance] created when "
"this effect is applied on a bus in the editor's Audio panel, or through "
"[method AudioServer.add_bus_effect].\n"
"[codeblock]\n"
"extends AudioEffect\n"
"\n"
"@export var strength = 4.0\n"
"\n"
"func _instantiate():\n"
"\tvar effect = CustomAudioEffectInstance.new()\n"
"\teffect.base = self\n"
"\n"
"\treturn effect\n"
"[/codeblock]\n"
"[b]Note:[/b] It is recommended to keep a reference to the original "
"[AudioEffect] in the new instance. Depending on the implementation this "
"allows the effect instance to listen for changes at run-time and be modified "
"accordingly."
msgstr ""

