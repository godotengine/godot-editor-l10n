msgstr "Matemática vetorial avançada"

#: doc/classes/AABB.xml
msgid ""
"Constructs an [AABB] with its [member position] and [member size] set to "
"[constant Vector3.ZERO]."
msgstr ""
"Constrói um [AABB] com sua [member position] e seu [member size] definidos "
"como [constant Vector3.ZERO]."

#: doc/classes/AABB.xml
msgid "Constructs an [AABB] as a copy of the given [AABB]."
msgstr "Constrói um [AABB] como uma cópia do [AABB] fornecido."

#: doc/classes/AABB.xml
msgid "Constructs an [AABB] by [param position] and [param size]."
msgstr "Constrói um [AABB] a partir de [param position] e [param size]."

#: doc/classes/AABB.xml
msgid ""
"Returns an [AABB] equivalent to this bounding box, with its width, height, "
"and depth modified to be non-negative values.\n"
"[codeblocks]\n"
"[gdscript]\n"
"var box = AABB(Vector3(5, 0, 5), Vector3(-20, -10, -5))\n"
"var absolute = box.abs()\n"
"print(absolute.position) # Prints (-15.0, -10.0, 0.0)\n"
"print(absolute.size)     # Prints (20.0, 10.0, 5.0)\n"
"[/gdscript]\n"
"[csharp]\n"
"var box = new Aabb(new Vector3(5, 0, 5), new Vector3(-20, -10, -5));\n"
"var absolute = box.Abs();\n"
"GD.Print(absolute.Position); // Prints (-15, -10, 0)\n"
"GD.Print(absolute.Size);     // Prints (20, 10, 5)\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]Note:[/b] It's recommended to use this method when [member size] is "
"negative, as most other methods in Godot assume that the [member size]'s "
"components are greater than [code]0[/code]."
msgstr ""
"Retorna um [AABB] equivalente a esta caixa delimitadora, com sua largura, "
"altura e profundidade modificadas para valores não negativos.\n"
"[codeblocks]\n"
"[gdscript]\n"
"var box = AABB(Vector3(5, 0, 5), Vector3(-20, -10, -5))\n"
"var absolute = box.abs()\n"
"print(absolute.position) # Imprime (-15.0, -10.0, 0.0)\n"
"print(absolute.size)     # Imprime (20.0, 10.0, 5.0)\n"
"[/gdscript]\n"
"[csharp]\n"
"var box = new Aabb(new Vector3(5, 0, 5), new Vector3(-20, -10, -5));\n"
"var absolute = box.Abs();\n"
"GD.Print(absolute.Position); // Imprime (-15, -10, 0)\n"
"GD.Print(absolute.Size);     # Imprime (20, 10, 5)\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]Nota:[/b] É recomendado usar este método quando o [member size] for "
"negativo, pois a maioria dos outros métodos no Godot supõe que os "
"componentes do [member size] sejam maiores que [code]0[/code]."

#: doc/classes/AABB.xml
msgid ""
"Returns [code]true[/code] if this bounding box [i]completely[/i] encloses "
"the [param with] box. The edges of both boxes are included.\n"
"[codeblocks]\n"
"[gdscript]\n"
"var a = AABB(Vector3(0, 0, 0), Vector3(4, 4, 4))\n"
"var b = AABB(Vector3(1, 1, 1), Vector3(3, 3, 3))\n"
"var c = AABB(Vector3(2, 2, 2), Vector3(8, 8, 8))\n"
"\n"
"print(a.encloses(a)) # Prints true\n"
"print(a.encloses(b)) # Prints true\n"
"print(a.encloses(c)) # Prints false\n"
"[/gdscript]\n"
"[csharp]\n"
"var a = new Aabb(new Vector3(0, 0, 0), new Vector3(4, 4, 4));\n"
"var b = new Aabb(new Vector3(1, 1, 1), new Vector3(3, 3, 3));\n"
"var c = new Aabb(new Vector3(2, 2, 2), new Vector3(8, 8, 8));\n"
"\n"
"GD.Print(a.Encloses(a)); // Prints True\n"
"GD.Print(a.Encloses(b)); // Prints True\n"
"GD.Print(a.Encloses(c)); // Prints False\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"Retorna [code]true[/code] se esta caixa delimitadora englobar "
"[i]completamente[/i] a caixa [param with]. As bordas de ambas as caixas "
"estão incluídas.\n"
"[codeblocks]\n"
"[gdscript]\n"
"var a = AABB(Vector3(0, 0, 0), Vector3(4, 4, 4))\n"
"var b = AABB(Vector3(1, 1, 1), Vector3(3, 3, 3))\n"
"var c = AABB(Vector3(2, 2, 2), Vector3(8, 8, 8))\n"
"\n"
"print(a.encloses(a)) # Imprime true\n"
"print(a.encloses(b)) # Imprime true\n"
"print(a.encloses(c)) # Imprime false\n"
"[/gdscript]\n"
"[csharp]\n"
"var a = new Aabb(new Vector3(0, 0, 0), new Vector3(4, 4, 4));\n"
"var b = new Aabb(new Vector3(1, 1, 1), new Vector3(3, 3, 3));\n"
"var c = new Aabb(new Vector3(2, 2, 2), new Vector3(8, 8, 8));\n"
"\n"
"GD.Print(a.Encloses(a)); // Imprime True\n"
"GD.Print(a.Encloses(b)); // Imprime True\n"
"GD.Print(a.Encloses(c)); // Imprime False\n"
"[/csharp]\n"
"[/codeblocks]"

#: doc/classes/AABB.xml
msgid ""
"Returns a copy of this bounding box expanded to align the edges with the "
"given [param to_point], if necessary.\n"
"[codeblocks]\n"
"[gdscript]\n"
"var box = AABB(Vector3(0, 0, 0), Vector3(5, 2, 5))\n"
"\n"
"box = box.expand(Vector3(10, 0, 0))\n"
"print(box.position) # Prints (0.0, 0.0, 0.0)\n"
"print(box.size)     # Prints (10.0, 2.0, 5.0)\n"
"\n"
"box = box.expand(Vector3(-5, 0, 5))\n"
"print(box.position) # Prints (-5.0, 0.0, 0.0)\n"
"print(box.size)     # Prints (15.0, 2.0, 5.0)\n"
"[/gdscript]\n"
"[csharp]\n"
"var box = new Aabb(new Vector3(0, 0, 0), new Vector3(5, 2, 5));\n"
"\n"
"box = box.Expand(new Vector3(10, 0, 0));\n"
"GD.Print(box.Position); // Prints (0, 0, 0)\n"
"GD.Print(box.Size);     // Prints (10, 2, 5)\n"
"\n"
"box = box.Expand(new Vector3(-5, 0, 5));\n"
"GD.Print(box.Position); // Prints (-5, 0, 0)\n"
"GD.Print(box.Size);     // Prints (15, 2, 5)\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"Retorna uma cópia desta caixa delimitadora expandida para alinhar as bordas "
"com o [param to_point] fornecido, se necessário.\n"
"[codeblocks]\n"
"[gdscript]\n"
"var box = AABB(Vector3(0, 0, 0), Vector3(5, 2, 5))\n"
"\n"
"box = box.expand(Vector3(10, 0, 0))\n"
"print(box.position) # Imprime (0.0, 0.0, 0.0)\n"
"print(box.size)        # Imprime (10.0, 2.0, 5.0)\n"
"\n"
"box = box.expand(Vector3(-5, 0, 5))\n"
"print(box.position) # Imprime (-5.0, 0.0, 0.0)\n"
"print(box.size)        # Imprime (15.0, 2.0, 5.0)\n"
"[/gdscript]\n"
"[csharp]\n"
"var box = new Aabb(new Vector3(0, 0, 0), new Vector3(5, 2, 5));\n"
"\n"
"box = box.Expand(new Vector3(10, 0, 0));\n"
"GD.Print(box.Position); // Imprime (0, 0, 0)\n"
"GD.Print(box.Size);        // Imprime (10, 2, 5)\n"
"\n"
"box = box.Expand(new Vector3(-5, 0, 5));\n"
"GD.Print(box.Position); // Imprime (-5, 0, 0)\n"
"GD.Print(box.Size);        // Imprime (15, 2, 5)\n"
"[/csharp]\n"
"[/codeblocks]"

#: doc/classes/AABB.xml
msgid ""
"Returns the center point of the bounding box. This is the same as "
"[code]position + (size / 2.0)[/code]."
msgstr ""
"Retorna o ponto central da caixa delimitadora. Isso equivale a "
"[code]position + (size/ 2.0)[/code]."

#: doc/classes/AABB.xml
msgid ""
"Returns the position of one of the 8 vertices that compose this bounding "
"box. With an [param idx] of [code]0[/code] this is the same as [member "
"position], and an [param idx] of [code]7[/code] is the same as [member end]."
msgstr ""
"Retorna a posição de um dos 8 vértices que compõem esta caixa delimitadora. "
"Com um [param idx] de [code]0[/code] isso é o mesmo que [member position], e "
"um [param idx] de [code]7[/code] é o mesmo que [member end]."

#: doc/classes/AABB.xml
msgid ""
"Returns the longest normalized axis of this bounding box's [member size], as "
"a [Vector3] ([constant Vector3.RIGHT], [constant Vector3.UP], or [constant "
"Vector3.BACK]).\n"
"[codeblocks]\n"
"[gdscript]\n"
"var box = AABB(Vector3(0, 0, 0), Vector3(2, 4, 8))\n"
"\n"
"print(box.get_longest_axis())       # Prints (0.0, 0.0, 1.0)\n"
"print(box.get_longest_axis_index()) # Prints 2\n"
"print(box.get_longest_axis_size())  # Prints 8.0\n"
"[/gdscript]\n"
"[csharp]\n"
"var box = new Aabb(new Vector3(0, 0, 0), new Vector3(2, 4, 8));\n"
"\n"
"GD.Print(box.GetLongestAxis());      // Prints (0, 0, 1)\n"
"GD.Print(box.GetLongestAxisIndex()); // Prints Z\n"
"GD.Print(box.GetLongestAxisSize());  // Prints 8\n"
"[/csharp]\n"
"[/codeblocks]\n"
"See also [method get_longest_axis_index] and [method get_longest_axis_size]."
msgstr ""
"Retorna o eixo normalizado mais longo do [member size] desta caixa "
"delimitadora, como um [Vector3] ([constant Vector3.RIGHT], [constant "
"Vector3.UP] ou [constant Vector3.BACK]).\n"
"[codeblocks]\n"
"[gdscript]\n"
"var box = AABB(Vector3(0, 0, 0), Vector3(2, 4, 8))\n"
"\n"
"print(box.get_longest_axis())       # Imprime (0.0, 0.0, 1.0)\n"
"print(box.get_longest_axis_index()) # Imprime 2\n"
"print(box.get_longest_axis_size())  # Imprime 8.0\n"
"[/gdscript]\n"
"[csharp]\n"
"var box = new Aabb(new Vector3(0, 0, 0), new Vector3(2, 4, 8));\n"
"\n"
"GD.Print(box.GetLongestAxis());      // Imprime (0, 0, 1)\n"
"GD.Print(box.GetLongestAxisIndex()); // Imprime Z\n"
"GD.Print(box.GetLongestAxisSize());  // Imprime 8\n"
"[/csharp]\n"
"[/codeblocks]\n"
"Veja também [method get_longest_axis_index] e [method get_longest_axis_size]."

#: doc/classes/AABB.xml
msgid ""
"Returns the index to the longest axis of this bounding box's [member size] "
"(see [constant Vector3.AXIS_X], [constant Vector3.AXIS_Y], and [constant "
"Vector3.AXIS_Z]).\n"
"For an example, see [method get_longest_axis]."
msgstr ""
"Retorna o índice do eixo mais longo do [member size] desta caixa "
"delimitadora (veja [constant Vector3.AXIS_X], [constant Vector3.AXIS_Y] e "
"[constant Vector3.AXIS_Z]).\n"
"Para um exemplo, veja [method get_longest_axis]."

#: doc/classes/AABB.xml
msgid ""
"Returns the longest dimension of this bounding box's [member size].\n"
"For an example, see [method get_longest_axis]."
msgstr ""
"Retorna a dimensão mais longa do [member size] desta caixa delimitadora.\n"
"Para um exemplo, veja [method get_longest_axis]."

#: doc/classes/AABB.xml
msgid ""
"Returns the shortest normalized axis of this bounding box's [member size], "
"as a [Vector3] ([constant Vector3.RIGHT], [constant Vector3.UP], or "
"[constant Vector3.BACK]).\n"
"[codeblocks]\n"
"[gdscript]\n"
"var box = AABB(Vector3(0, 0, 0), Vector3(2, 4, 8))\n"
"\n"
"print(box.get_shortest_axis())       # Prints (1.0, 0.0, 0.0)\n"
"print(box.get_shortest_axis_index()) # Prints 0\n"
"print(box.get_shortest_axis_size())  # Prints 2.0\n"
"[/gdscript]\n"
"[csharp]\n"
"var box = new Aabb(new Vector3(0, 0, 0), new Vector3(2, 4, 8));\n"
"\n"
"GD.Print(box.GetShortestAxis());      // Prints (1, 0, 0)\n"
"GD.Print(box.GetShortestAxisIndex()); // Prints X\n"
"GD.Print(box.GetShortestAxisSize());  // Prints 2\n"
"[/csharp]\n"
"[/codeblocks]\n"
"See also [method get_shortest_axis_index] and [method "
"get_shortest_axis_size]."
msgstr ""
"Retorna o eixo normalizado mais curto do [member size] desta caixa "
"delimitadora, como um [Vector3] ([constant Vector3.RIGHT], [constant "
"Vector3.UP] ou [constant Vector3.BACK]).\n"
"[codeblocks]\n"
"[gdscript]\n"
"var box = AABB(Vector3(0, 0, 0), Vector3(2, 4, 8))\n"
"\n"
"print(box.get_shortest_axis())       # Imprime (1.0, 0.0, 0.0)\n"
"print(box.get_shortest_axis_index()) # Imprime 0\n"
"print(box.get_shortest_axis_size())  # Imprime 2.0\n"
"[/gdscript]\n"
"[csharp]\n"
"var box = new Aabb(new Vector3(0, 0, 0), new Vector3(2, 4, 8));\n"
"\n"
"GD.Print(box.GetShortestAxis());      // Imprime (1, 0, 0)\n"
"GD.Print(box.GetShortestAxisIndex()); // Imprime X\n"
"GD.Print(box.GetShortestAxisSize());  // Imprime 2\n"
"[/csharp]\n"
"[/codeblocks]\n"
"Veja também [method get_shortest_axis_index] e [method "
"get_shortest_axis_size]."

#: doc/classes/AABB.xml
msgid ""
"Returns the index to the shortest axis of this bounding box's [member size] "
"(see [constant Vector3.AXIS_X], [constant Vector3.AXIS_Y], and [constant "
"Vector3.AXIS_Z]).\n"
"For an example, see [method get_shortest_axis]."
msgstr ""
"Retorna o índice do eixo mais curto do [member size] desta caixa "
"delimitadora (veja [constant Vector3.AXIS_X], [constant Vector3.AXIS_Y] e "
"[constant Vector3.AXIS_Z]).\n"
"Para um exemplo, veja [method get_shortest_axis]."

#: doc/classes/AABB.xml
msgid ""
"Returns the shortest dimension of this bounding box's [member size].\n"
"For an example, see [method get_shortest_axis]."
msgstr ""
"Retorna a dimensão mais curta do [member size] desta caixa delimitadora.\n"
"Para um exemplo, veja [method get_shortest_axis]."

#: doc/classes/AABB.xml
msgid ""
"Returns the vertex's position of this bounding box that's the farthest in "
"the given direction. This point is commonly known as the support point in "
"collision detection algorithms."
msgstr ""
"Retorna a posição do vértice desta caixa delimitadora que está mais distante "
"na direção dada. Este ponto é comumente conhecido como o ponto de suporte "
"(support point) em algoritmos de detecção de colisão."

#: doc/classes/AABB.xml
msgid ""
"Returns the bounding box's volume. This is equivalent to [code]size.x * "
"size.y * size.z[/code]. See also [method has_volume]."
msgstr ""
"Retorna o volume da caixa delimitadora. Isso é equivalente a [code]size.x * "
"size.y * size.z[/code]. Veja também [method has_volume]."

#: doc/classes/AABB.xml
msgid ""
"Returns a copy of this bounding box extended on all sides by the given "
"amount [param by]. A negative amount shrinks the box instead.\n"
"[codeblocks]\n"
"[gdscript]\n"
"var a = AABB(Vector3(4, 4, 4), Vector3(8, 8, 8)).grow(4)\n"
"print(a.position) # Prints (0.0, 0.0, 0.0)\n"
"print(a.size)     # Prints (16.0, 16.0, 16.0)\n"
"\n"
"var b = AABB(Vector3(0, 0, 0), Vector3(8, 4, 2)).grow(2)\n"
"print(b.position) # Prints (-2.0, -2.0, -2.0)\n"
"print(b.size)     # Prints (12.0, 8.0, 6.0)\n"
"[/gdscript]\n"
"[csharp]\n"
"var a = new Aabb(new Vector3(4, 4, 4), new Vector3(8, 8, 8)).Grow(4);\n"
"GD.Print(a.Position); // Prints (0, 0, 0)\n"
"GD.Print(a.Size);     // Prints (16, 16, 16)\n"
"\n"
"var b = new Aabb(new Vector3(0, 0, 0), new Vector3(8, 4, 2)).Grow(2);\n"
"GD.Print(b.Position); // Prints (-2, -2, -2)\n"
"GD.Print(b.Size);     // Prints (12, 8, 6)\n"
"[/csharp]\n"
"[/codeblocks]"
msgstr ""
"Retorna uma cópia desta caixa delimitadora estendida em todos os lados pela "
"quantidade [param by] fornecida. Uma quantidade negativa encolhe a caixa.\n"
"[codeblocks]\n"
"[gdscript]\n"
"var a = AABB(Vector3(4, 4, 4), Vector3(8, 8, 8)).grow(4)\n"
"print(a.position) # Imprime (0.0, 0.0, 0.0)\n"
"print(a.size)     # Imprime (16.0, 16.0, 16.0)\n"
"\n"
"var b = AABB(Vector3(0, 0, 0), Vector3(8, 4, 2)).grow(2)\n"
"print(b.position) # Imprime (-2.0, -2.0, -2.0)\n"
"print(b.size)     # Imprime (12.0, 8.0, 6.0)\n"
"[/gdscript]\n"
"[csharp]\n"
"var a = new Aabb(new Vector3(4, 4, 4), new Vector3(8, 8, 8)).Grow(4);\n"
"GD.Print(a.Position); // Imprime (0, 0, 0)\n"
"GD.Print(a.Size);     // Imprime (16, 16, 16)\n"
"\n"
"var b = new Aabb(new Vector3(0, 0, 0), new Vector3(8, 4, 2)).Grow(2);\n"
"GD.Print(b.Position); // Imprime (-2, -2, -2)\n"
"GD.Print(b.Size);     // Imprime (12, 8, 6)\n"
"[/csharp]\n"
"[/codeblocks]"

#: doc/classes/AABB.xml
msgid ""
"Returns [code]true[/code] if the bounding box contains the given [param "
"point]. By convention, points exactly on the right, top, and front sides are "
"[b]not[/b] included.\n"
"[b]Note:[/b] This method is not reliable for [AABB] with a [i]negative[/i] "
"[member size]. Use [method abs] first to get a valid bounding box."
msgstr ""
"Retorna [code]true[/code] se a caixa delimitadora contiver o [param point] "
"fornecido. Por convenção, pontos exatamente nas faces direita, superior e "
"frontal [b]não[/b] estão incluídos.\n"
"[b]Nota:[/b] Este método não é confiável para [AABB] com um [member size] "
"[i]negativo[/i]. Use [method abs] primeiro para obter uma caixa delimitadora "
"válida."

#: doc/classes/AABB.xml
msgid ""
"Returns [code]true[/code] if this bounding box has a surface or a length, "
"that is, at least one component of [member size] is greater than [code]0[/"
"code]. Otherwise, returns [code]false[/code]."
msgstr ""
"Retorna [code]true[/code] se esta caixa delimitadora tiver uma superfície ou "
"um comprimento, ou seja, pelo menos um componente de [member size] é maior "
"que [code]0[/code]. Caso contrário, retorna [code]false[/code]."

#: doc/classes/AABB.xml
msgid ""
"Returns [code]true[/code] if this bounding box's width, height, and depth "
"are all positive. See also [method get_volume]."
msgstr ""
"Retorna [code]true[/code] se a largura, a altura e a profundidade desta "
"caixa de colisão forem todas positivas. Veja também [method get_volume]."

#: doc/classes/AABB.xml
msgid ""
"Returns the intersection between this bounding box and [param with]. If the "
"boxes do not intersect, returns an empty [AABB]. If the boxes intersect at "
"the edge, returns a flat [AABB] with no volume (see [method has_surface] and "
"[method has_volume]).\n"
"[codeblocks]\n"
"[gdscript]\n"
"var box1 = AABB(Vector3(0, 0, 0), Vector3(5, 2, 8))\n"
"var box2 = AABB(Vector3(2, 0, 2), Vector3(8, 4, 4))\n"
"\n"
"var intersection = box1.intersection(box2)\n"
"print(intersection.position) # Prints (2.0, 0.0, 2.0)\n"
"print(intersection.size)     # Prints (3.0, 2.0, 4.0)\n"
"[/gdscript]\n"
"[csharp]\n"
"var box1 = new Aabb(new Vector3(0, 0, 0), new Vector3(5, 2, 8));\n"
"var box2 = new Aabb(new Vector3(2, 0, 2), new Vector3(8, 4, 4));\n"
"\n"
"var intersection = box1.Intersection(box2);\n"
"GD.Print(intersection.Position); // Prints (2, 0, 2)\n"
"GD.Print(intersection.Size);     // Prints (3, 2, 4)\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]Note:[/b] If you only need to know whether two bounding boxes are "
"intersecting, use [method intersects], instead."
msgstr ""
"Retorna a interseção entre esta caixa de colisão e [param with]. Se as "
"caixas não se intersectarem, retorna um [AABB] vazio. Se as caixas se "
"intersectarem na borda, retorna um [AABB] plano sem volume (veja [method "
"has_surface] e [method has_volume]).\n"
"[codeblocks]\n"
"[gdscript]\n"
"var box1 = AABB(Vector3(0, 0, 0), Vector3(5, 2, 8))\n"
"var box2 = AABB(Vector3(2, 0, 2), Vector3(8, 4, 4))\n"
"\n"
"var intersection = box1.intersection(box2)\n"
"print(intersection.position) # Imprime (2.0, 0.0, 2.0)\n"
"print(intersection.size)     # Imprime (3.0, 2.0, 4.0)\n"
"[/gdscript]\n"
"[csharp]\n"
"var box1 = new Aabb(new Vector3(0, 0, 0), new Vector3(5, 2, 8));\n"
"var box2 = new Aabb(new Vector3(2, 0, 2), new Vector3(8, 4, 4));\n"
"\n"
"var intersection = box1.Intersection(box2);\n"
"GD.Print(intersection.Position); // Imprime (2, 0, 2)\n"
"GD.Print(intersection.Size);     // Imprime (3, 2, 4)\n"
"[/csharp]\n"
"[/codeblocks]\n"
"[b]Nota:[/b] Se você só precisa saber se duas caixas delimitadoras se "
"intersectam, use [method intersects] em vez disso."

#: doc/classes/AABB.xml
msgid ""
"Returns [code]true[/code] if this bounding box overlaps with the box [param "
"with]. The edges of both boxes are [i]always[/i] excluded."
msgstr ""
"Retorna [code]true[/code] se esta caixa delimitadora se sobrepõe com a caixa "
"[param with]. As bordas de ambas as caixas são [i]sempre[/i] excluídas."

#: doc/classes/AABB.xml
msgid ""
"Returns [code]true[/code] if this bounding box is on both sides of the given "
"[param plane]."
msgstr ""
"Retorna [code]true[/code] se esta caixa de colisão estiver em ambos os lados "
"do [param plane] fornecido."

#: doc/classes/AABB.xml
msgid ""
"Returns the first point where this bounding box and the given ray intersect, "
"as a [Vector3]. If no intersection occurs, returns [code]null[/code].\n"
"The ray begin at [param from], faces [param dir] and extends towards "
"infinity."
msgstr ""
"Retorna o primeiro ponto onde esta caixa delimitadora e o raio fornecido se "
"intersectam, como um [Vector3]. Se nenhuma interseção ocorrer, retorna "
"[code]null[/code].\n"
"O raio começa em [param from], aponta na direção de [param dir] e se estende "
"até o infinito."

#: doc/classes/AABB.xml
msgid ""
"Returns the first point where this bounding box and the given segment "
"intersect, as a [Vector3]. If no intersection occurs, returns [code]null[/"
"code].\n"
"The segment begins at [param from] and ends at [param to]."
msgstr ""
"Retorna o primeiro ponto onde esta caixa delimitadora e o segmento fornecido "
"se intersectam, como um [Vector3]. Se nenhuma interseção ocorrer, retorna "
"[code]null[/code].\n"
"O segmento começa em [param from] e termina em [param to]."

#: doc/classes/AABB.xml
msgid ""
"Returns [code]true[/code] if this bounding box and [param aabb] are "
"approximately equal, by calling [method Vector3.is_equal_approx] on the "
"[member position] and the [member size]."
msgstr ""
"Retorna [code]true[/code] se esta caixa delimitadora e [param aabb] são "
"aproximadamente iguais, chamando [method Vector3.is_equal_approx] em [member "
"position] e [member size]."

#: doc/classes/AABB.xml
msgid ""
"Returns [code]true[/code] if this bounding box's values are finite, by "
"calling [method Vector3.is_finite] on the [member position] and the [member "
"size]."
msgstr ""
"Retorna [code]true[/code] se os valores desta caixa delimitadora são "
"finitos, chamando [method Vector3.is_finite] em [member position] e [member "
"size]."

#: doc/classes/AABB.xml
msgid ""
"Returns an [AABB] that encloses both this bounding box and [param with] "
"around the edges. See also [method encloses]."
msgstr ""
"Retorna um [AABB] que engloba tanto esta caixa delimitadora quanto [param "
"with] ao redor das bordas. Veja também [method encloses]."

#: doc/classes/AABB.xml
msgid ""
"The ending point. This is usually the corner on the top-right and back of "
"the bounding box, and is equivalent to [code]position + size[/code]. Setting "
"this point affects the [member size]."
msgstr ""
"O ponto final. Geralmente, este é o canto superior direito e traseiro da "
"caixa delimitadora, sendo equivalente a [code]position + size[/code]. "
"Alterar este ponto afeta o [member size]."

#: doc/classes/AABB.xml
msgid ""
"The origin point. This is usually the corner on the bottom-left and forward "
"of the bounding box."
msgstr ""
"O ponto de origem. Geralmente, este é o canto inferior esquerdo e frontal da "
"caixa delimitadora."

#: doc/classes/AABB.xml
msgid ""
"The bounding box's width, height, and depth starting from [member position]. "
"Setting this value also affects the [member end] point.\n"
"[b]Note:[/b] It's recommended setting the width, height, and depth to non-"
"negative values. This is because most methods in Godot assume that the "
"[member position] is the bottom-left-forward corner, and the [member end] is "
"the top-right-back corner. To get an equivalent bounding box with non-"
"negative size, use [method abs]."
msgstr ""
"A largura, altura e profundidade da caixa delimitadora a partir de [member "
"position]. Definir este valor também afeta o ponto [member end].\n"
"[b]Nota:[/b] É recomendável definir a largura, altura e profundidade com "
"valores não negativos. Isso ocorre porque a maioria dos métodos no Godot "
"supõe que o [member position] é o canto inferior esquerdo frontal, e o "
"[member end] é o canto superior direito traseiro. Para obter uma caixa "
"delimitadora equivalente com tamanho não negativo, use [method abs]."

#: doc/classes/AABB.xml
msgid ""
"Returns [code]true[/code] if the [member position] or [member size] of both "
"bounding boxes are not equal.\n"
"[b]Note:[/b] Due to floating-point precision errors, consider using [method "
"is_equal_approx] instead, which is more reliable."
msgstr ""
"Retorna [code]true[/code] se [member position] ou [member size] de ambas as "
"caixas delimitadoras não forem iguais.\n"
"[b]Nota:[/b] Devido a erros de precisão de ponto flutuante, considere usar "
"[method is_equal_approx] em vez disso, que é mais confiável."

#: doc/classes/AABB.xml
msgid ""
"Inversely transforms (multiplies) the [AABB] by the given [Transform3D] "
"transformation matrix, under the assumption that the transformation basis is "
"orthonormal (i.e. rotation/reflection is fine, scaling/skew is not).\n"
"[code]aabb * transform[/code] is equivalent to [code]transform.inverse() * "
"aabb[/code]. See [method Transform3D.inverse].\n"
"For transforming by inverse of an affine transformation (e.g. with scaling) "
"[code]transform.affine_inverse() * aabb[/code] can be used instead. See "
"[method Transform3D.affine_inverse]."
msgstr ""
"Transforma inversamente (multiplica) a [AABB] pela matriz de transformação "
"[Transform3D] fornecida, sob a premissa de que a base da transformação é "
"ortonormal (isto é, rotação/reflexão é aceitável, mas escala/cisalhamento "
"não).\n"
"[code]aabb * transform[/code] é equivalente a [code]transform.inverse() * "
"aabb[/code]. Veja [method Transform3D.inverse].\n"
"Para transformar pela inversa de uma transformação afim (por exemplo, com "
"escala), [code]transform.affine_inverse() * aabb[/code] pode ser usado em "
"seu lugar. Veja [method Transform3D.affine_inverse]."

#: doc/classes/AABB.xml
msgid ""
"Returns [code]true[/code] if both [member position] and [member size] of the "
"bounding boxes are exactly equal, respectively.\n"
"[b]Note:[/b] Due to floating-point precision errors, consider using [method "
"is_equal_approx] instead, which is more reliable."
msgstr ""
"Retorna [code]true[/code] se [member position] e [member size] das caixas "
"delimitadoras forem exatamente iguais, respectivamente.\n"
"[b]Nota:[/b] Devido a erros de precisão de ponto flutuante, considere usar "
"[method is_equal_approx] em vez disso, que é mais confiável."

#: doc/classes/AcceptDialog.xml
msgid "A base dialog used for user notification."
msgstr "Um diálogo base usado para notificar o usuário."

#: doc/classes/AcceptDialog.xml
msgid ""
"The default use of [AcceptDialog] is to allow it to only be accepted or "
"closed, with the same result. However, the [signal confirmed] and [signal "
"canceled] signals allow to make the two actions different, and the [method "
"add_button] method allows to add custom buttons and actions.\n"
"[b]Note:[/b] [AcceptDialog] is invisible by default. To make it visible, "
"call one of the [code]popup_*[/code] methods from [Window] on the node, such "
"as [method Window.popup_centered_clamped]."
msgstr ""
"O uso padrão de [AcceptDialog] permite apenas que ele seja aceito ou "
"fechado, resultando na mesma ação. No entanto, os sinais [signal confirmed] "
"e [signal canceled] permitem diferenciar as duas ações, e o método [method "
"add_button] permite adicionar botões e ações personalizadas.\n"
"[b]Nota:[/b] O [AcceptDialog] é invisível por padrão. Para torná-lo visível, "
"chame um dos métodos [code]popup_*[/code] da [Window] no nó, como [method "
"Window.popup_centered_clamped]."

#: doc/classes/AcceptDialog.xml
msgid ""
"Adds a button with label [param text] and a custom [param action] to the "
"dialog and returns the created button.\n"
"If [param action] is not empty, pressing the button will emit the [signal "
"custom_action] signal with the specified action string.\n"
"If [code]true[/code], [param right] will place the button to the right of "
"any sibling buttons.\n"
"You can use [method remove_button] method to remove a button created with "
"this method from the dialog."
msgstr ""
"Adiciona um botão com o rótulo [param text] e uma ação personalizada [param "
"action] ao diálogo e retorna o botão criado.\n"
"Se [param action] não estiver vazia, pressionar o botão emitirá o sinal "
"[signal custom_action] com a string de ação especificada.\n"
"Se [code]true[/code], [param right] posicionará o botão à direita de "
"quaisquer botões irmãos.\n"
"Você pode usar o método [method remove_button] para remover do diálogo um "
"botão criado com este método."

#: doc/classes/AcceptDialog.xml
msgid ""
"Adds a button with label [param name] and a cancel action to the dialog and "
"returns the created button.\n"
"You can use [method remove_button] method to remove a button created with "
"this method from the dialog."
msgstr ""
"Adiciona um botão com o rótulo [param name] e uma ação de cancelamento ao "
"diálogo e retorna o botão criado.\n"
"Você pode usar o método [method remove_button] para remover do diálogo um "
"botão criado com este método."

#: doc/classes/AcceptDialog.xml
msgid ""
"Returns the label used for built-in text.\n"
"[b]Warning:[/b] This is a required internal node, removing and freeing it "
"may cause a crash. If you wish to hide it or any of its children, use their "
"[member CanvasItem.visible] property."
msgstr ""
"Retorna o rótulo (label) usado para o texto embutido.\n"
"[b]Aviso:[/b] Este é um nó interno obrigatório; removê-lo e liberá-lo (free) "
"pode causar um erro ou travamento (crash). Se você deseja ocultá-lo ou a "
"qualquer um de seus filhos, use a propriedade [member CanvasItem.visible] "
"deles."

#: doc/classes/AcceptDialog.xml
msgid ""
"Returns the OK [Button] instance.\n"
"[b]Warning:[/b] This is a required internal node, removing and freeing it "
"may cause a crash. If you wish to hide it or any of its children, use their "
"[member CanvasItem.visible] property."
msgstr ""
"Retorna a instância do [Button] OK.\n"
"[b]Alerta:[/b] Este é um nó interno obrigatório; removê-lo e liberá-lo "
"(free) pode causar um erro ou travamento (crash). Se você deseja ocultá-lo "
"ou a qualquer um de seus filhos, use a propriedade [member "
"CanvasItem.visible] deles."

#: doc/classes/AcceptDialog.xml
msgid ""
"Registers a [LineEdit] in the dialog. When the enter key is pressed, the "
"dialog will be accepted."
msgstr ""
"Adiciona uma [LineEdit] na janela. Quando a tecla Enter é pressionada, a "
"janela será aceita."

#: doc/classes/AcceptDialog.xml
msgid ""
"Removes the [param button] from the dialog. Does NOT free the [param "
"button]. The [param button] must be a [Button] added with [method "
"add_button] or [method add_cancel_button] method. After removal, pressing "
"the [param button] will no longer emit this dialog's [signal custom_action] "
"or [signal canceled] signals."
msgstr ""
"Remove o [param button] do diálogo. NÃO libera (free) o [param button]. O "
"[param button] deve ser um [Button] adicionado com o método [method "
"add_button] ou [method add_cancel_button]. Após a remoção, pressionar o "
"[param button] não emitirá mais os sinais [signal custom_action] ou [signal "
"canceled] deste diálogo."

#: doc/classes/AcceptDialog.xml
msgid "Sets autowrapping for the text in the dialog."
msgstr "Aciona quebra automática de linda para o texto na janela."

#: doc/classes/AcceptDialog.xml
msgid ""
"If [code]true[/code], the dialog will be hidden when the "
"[code]ui_close_dialog[/code] action is pressed (by default, this action is "
"bound to [kbd]Escape[/kbd], or [kbd]Cmd + W[/kbd] on macOS)."
msgstr ""
"Se [code]true[/code], o diálogo será ocultado quando a ação "
"[code]ui_close_dialog[/code] for pressionada (por padrão, esta ação está "
"vinculada à tecla [kbd]Escape[/kbd], ou [kbd]Cmd + W[/kbd] no macOS)."

#: doc/classes/AcceptDialog.xml
msgid ""
"If [code]true[/code], the dialog is hidden when the OK button is pressed. "
"You can set it to [code]false[/code] if you want to do e.g. input validation "
"when receiving the [signal confirmed] signal, and handle hiding the dialog "
"in your own logic.\n"
"[b]Note:[/b] Some nodes derived from this class can have a different default "
"value, and potentially their own built-in logic overriding this setting. For "
"example [FileDialog] defaults to [code]false[/code], and has its own input "
"validation code that is called when you press OK, which eventually hides the "
"dialog if the input is valid. As such, this property can't be used in "
"[FileDialog] to disable hiding the dialog when pressing OK."
msgstr ""
"Se [code]true[/code], a janela de diálogo será ocultada ao pressionar o "
"botão OK. Você pode configurar para [code]false[/code] caso queira fazer, "
"por exemplo, uma validação de input ao receber um sinal [signal confirmed], "
"e controlar a exibição da janela usando uma lógica própria.\n"
"[b]Obs:[/b] Alguns nós derivados desta classe podem ter um valor padrão "
"distinto, e, possivelmente, sua própria lógica interna sobrescrevendo essa "
"configuração. Por exemplo, [FileDialog] tem valor padrão [code]false[/code] "
"e possui validação de input próprio ao pressionar OK, o qual também oculta a "
"janela de diálogo quando o input for válido. Por isso, essa propriedade não "
"pode ser usada em [FileDialog] para desabilitar que a janela se oculte ao "
"pressionar OK."

#: doc/classes/AcceptDialog.xml
msgid "The text displayed by the dialog."
msgstr "O texto exibido na janela de diálogo."

#: doc/classes/AcceptDialog.xml
msgid ""
"The text displayed by the OK button (see [method get_ok_button]). If empty, "
"a default text will be used."
msgstr ""
"O texto exibido pelo botão OK (veja [method get_ok_button]). Se estiver "
"vazio, um texto padrão será usado."

#: doc/classes/AcceptDialog.xml
msgid ""
"Emitted when the dialog is closed or the button created with [method "
"add_cancel_button] is pressed."
msgstr ""
"Emitido quando o diálogo é fechado ou quando o botão criado com [method "
"add_cancel_button] é pressionado."

#: doc/classes/AcceptDialog.xml
msgid "Emitted when the dialog is accepted, i.e. the OK button is pressed."
msgstr ""
"Emitido quanto a janela é aceita, por exemplo, quando o botão OK é "
"pressionado."

#: doc/classes/AcceptDialog.xml
msgid ""
"Emitted when a custom button with an action is pressed. See [method "
"add_button]."
msgstr ""
"Emitido quando um botão personalizado com uma ação é pressionado. Veja "
"[method add_button]."

#: doc/classes/AcceptDialog.xml
msgid ""
"The minimum height of each button in the bottom row (such as OK/Cancel) in "
"pixels. This can be increased to make buttons with short texts easier to "
"click/tap."
msgstr ""
"A altura mínima em pixels de cada botão na linha inferior (como OK/"
"Cancelar). Isso pode ser aumentado para tornar botões com textos curtos mais "
"fáceis de clicar ou tocar."

#: doc/classes/AcceptDialog.xml
msgid ""
"The minimum width of each button in the bottom row (such as OK/Cancel) in "
"pixels. This can be increased to make buttons with short texts easier to "
"click/tap."
msgstr ""
"A largura mínima em pixels de cada botão na linha inferior (como OK/"
"Cancelar). Isso pode ser aumentado para tornar botões com textos curtos mais "
"fáceis de clicar ou tocar."

#: doc/classes/AcceptDialog.xml
msgid ""
"The size of the vertical space between the dialog's content and the button "
"row."
msgstr ""
"O tamanho do espaço vertical entre o conteúdo da janela e a linha de botões."

#: doc/classes/AcceptDialog.xml
msgid "The panel that fills the background of the window."
msgstr "O painel que preenche o fundo da janela."

#: doc/classes/AccessibilityServer.xml
msgid "A server interface for screen reader support."
msgstr "Uma interface de servidor para suporte a leitor de tela."

#: doc/classes/AccessibilityServer.xml doc/classes/DisplayServer.xml
msgid ""
"Creates a new, empty accessibility element resource.\n"
"[b]Note:[/b] An accessibility element is created and freed automatically for "
"each [Node]. In general, this function should not be called manually."
msgstr ""
"Cria um novo recurso de elemento de acessibilidade vazio.\n"
"[b]Nota:[/b] Um elemento de acessibilidade é criado e liberado "
"automaticamente para cada [Node]. Em geral, esta função não deve ser chamada "
"manualmente."

#: doc/classes/AccessibilityServer.xml
msgid ""
"Creates a new, empty accessibility sub-element resource. Sub-elements can be "
"used to provide accessibility information for objects which are not [Node]s, "
"such as list items, table cells, or menu items. Sub-elements are freed "
"automatically when the parent element is freed, or can be freed early using "
"the [method free_element] method."
msgstr ""
"Cria um novo recurso de subelemento de acessibilidade vazio. Subelementos "
"podem ser usados para fornecer informações de acessibilidade para objetos "
"que não são [Node]s, como itens de lista, células de tabela ou itens de "
"menu. Subelementos são liberados automaticamente quando o elemento pai é "
"liberado, ou podem ser liberados antecipadamente usando o método [method "
"free_element]."

#: doc/classes/AccessibilityServer.xml
msgid ""
"Creates a new, empty accessibility sub-element from the shaped text buffer. "
"Sub-elements are freed automatically when the parent element is freed, or "
"can be freed early using the [method free_element] method.\n"
"If [param is_last_line] is [code]true[/code], no trailing newline is "
"appended to the text content. Set to [code]true[/code] for the last line in "
"multi-line text fields and for single-line text fields."
msgstr ""
"Cria um novo recurso de subelemento de acessibilidade vazio a partir do "
"buffer de texto modelado (shaped text). Subelementos são liberados "
"automaticamente quando o elemento pai é liberado, ou podem ser liberados "
"antecipadamente usando o método [method free_element].\n"
"Se [param is_last_line] for [code]true[/code], nenhuma quebra de linha final "
"é adicionada ao conteúdo do texto. Defina como [code]true[/code] para a "
"última linha em campos de texto multilinha e para campos de texto de linha "
"única."

#: doc/classes/AccessibilityServer.xml doc/classes/DisplayServer.xml
msgid "Returns the metadata of the accessibility element [param id]."
msgstr "Retorna os metadados do elemento de acessibilidade [param id]."

#: doc/classes/AccessibilityServer.xml doc/classes/DisplayServer.xml
msgid ""
"Sets the metadata of the accessibility element [param id] to [param meta]."
msgstr ""
"Define os metadados do elemento de acessibilidade [param id] para [param "
"meta]."

#: doc/classes/AccessibilityServer.xml
msgid ""
"Frees the accessibility element [param id] created by [method "
"create_element], [method create_sub_element], or [method "
"create_sub_text_edit_elements]."
msgstr ""
"Libera o elemento de acessibilidade [param id] criado por [method "
"create_element], [method create_sub_element] ou [method "
"create_sub_text_edit_elements]."

#: doc/classes/AccessibilityServer.xml doc/classes/DisplayServer.xml
msgid "Returns the main accessibility element of the OS native window."
msgstr ""
"Retorna o principal elemento de acessibilidade da janela nativa do sistema "
"operacional."

#: doc/classes/AccessibilityServer.xml doc/classes/DisplayServer.xml
msgid ""
"Returns [code]true[/code] if [param id] is a valid accessibility element."
msgstr ""
"Retorna [code]true[/code] se [param id] for um elemento de acessibilidade "
"válido."

#: doc/classes/AccessibilityServer.xml
msgid ""
"Returns [code]true[/code] if screen reader is support by this implementation."
msgstr ""
"Retorna [code]true[/code] se esta implementação oferecer suporte a leitores "
"de tela."

#: doc/classes/AccessibilityServer.xml doc/classes/DisplayServer.xml
msgid ""
"Sets the window focused state for assistive apps.\n"
"[b]Note:[/b] This method is implemented on Linux, macOS, and Windows.\n"
"[b]Note:[/b] Advanced users only! [Window] objects call this method "
"automatically."
msgstr ""
"Define o estado de foco da janela para aplicativos de acessibilidade.\n"
"[b]Nota:[/b] Este método é implementado no Linux, macOS e Windows.\n"
"[b]Nota:[/b] Apenas para usuários avançados! Objetos [Window] chamam este "
"método automaticamente."

#: doc/classes/AccessibilityServer.xml doc/classes/DisplayServer.xml
msgid ""
"Sets window outer (with decorations) and inner (without decorations) bounds "
"for assistive apps.\n"
"[b]Note:[/b] This method is implemented on Linux, macOS, and Windows.\n"
"[b]Note:[/b] Advanced users only! [Window] objects call this method "
"automatically."
msgstr ""
"Define os limites externos (com decorações) e internos (sem decorações) da "
"janela para aplicativos de acessibilidade.\n"
"[b]Nota:[/b] Este método está implementado no Linux, macOS e Windows.\n"
"[b]Nota:[/b] Somente para usuários avançados! Objetos [Window] chamam este "
"método automaticamente."

#: doc/classes/AccessibilityServer.xml doc/classes/DisplayServer.xml
msgid ""
"Adds a callback for the accessibility action (action which can be performed "
"by using a special screen reader command or buttons on the Braille display), "
"and marks this action as supported. The action callback receives one "
"[Variant] argument, which value depends on action type."
msgstr ""
"Adiciona uma função de retorno de chamada para a ação de acessibilidade "
"(ação que pode ser realizada usando um comando especial do leitor de tela ou "
"botões no display Braille) e marca essa ação como compatível. A função de "
"retorno de chamada da ação recebe um argumento [Variant], cujo valor depende "
"do tipo de ação."

#: doc/classes/AccessibilityServer.xml doc/classes/DisplayServer.xml
msgid ""
"Adds a child accessibility element.\n"
"[b]Note:[/b] [Node] children and sub-elements are added to the child list "
"automatically."
msgstr ""
"Adiciona um elemento filho de acessibilidade.\n"
"[b]Nota:[/b] Os elementos filhos e subelementos do [Node] são adicionados "
"automaticamente à lista de filhos."

#: doc/classes/AccessibilityServer.xml doc/classes/DisplayServer.xml
msgid ""
"Adds support for a custom accessibility action. [param action_id] is passed "
"as an argument to the callback of [constant ACTION_CUSTOM] action."
msgstr ""
"Adiciona suporte para uma ação personalizada de acessibilidade. O [param "
"action_id] é passado como argumento para o retorno de chamada da ação "
"[constant ACTION_CUSTOM]."

#: doc/classes/AccessibilityServer.xml doc/classes/DisplayServer.xml
