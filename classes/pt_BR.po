"+-----+ +-----+\n"
"| Q   | | Q   | - \"Q\" - keycode\n"
"|   Й | |  ض | - \"Й\" and \"ض\" - key_label\n"
"+-----+ +-----+\n"
"[/codeblock]"
msgstr ""

