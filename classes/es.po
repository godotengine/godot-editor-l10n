#, fuzzy
msgid ""
"If [code]true[/code], the intensity slider in the displayed [ColorPicker] "
"will be visible."
msgstr ""
"Si es [code]true[/code], el deslizador de intensidad en el [ColorPicker] "
"mostrado será visible."

#: doc/classes/ColorPickerButton.xml
msgid "Emitted when the color changes."
msgstr "Emitida cuando el color cambia."

#: doc/classes/ColorPickerButton.xml
msgid ""
"Emitted when the [ColorPicker] is created (the button is pressed for the "
"first time)."
msgstr ""
"Emitida cuando se crea el [ColorPicker] (se pulsa el botón por primera vez)."

#: doc/classes/ColorPickerButton.xml
