msgstr "Si es [code]true[/code], el GraphElement está seleccionado."

#: doc/classes/GraphElement.xml
msgid "Emitted when removing the GraphElement is requested."
msgstr "Emitida cuando se solicita la eliminación de GraphElement."

#: doc/classes/GraphElement.xml
msgid "Emitted when the GraphElement is dragged."
msgstr "Emitida cuando se arrastra el GraphElement."

#: doc/classes/GraphElement.xml
msgid "Emitted when the GraphElement is deselected."
msgstr "Emitida cuando se deselecciona un GraphElement."

#: doc/classes/GraphElement.xml
