"[codeblocks]\n"
"[gdscript]\n"
"var color = Color(1, 0.5, 0.2)\n"
"print(color.to_argb64()) # Imprime -2147470541\n"
"[/gdscript]\n"
"[csharp]\n"
"var color = new Color(1.0f, 0.5f, 0.2f);\n"
"GD.Print(color.ToArgb64()); // Imprime -2147470541\n"
