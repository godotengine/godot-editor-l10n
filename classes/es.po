msgstr "El mes de diciembre, representado numéricamente como [code]12[/code]."

#: doc/classes/Time.xml
msgid "The day of the week Sunday, represented numerically as [code]0[/code]."
msgstr ""
"El día domingo de la semana, representado numéricamente como [code]0[/code]."

#: doc/classes/Time.xml
