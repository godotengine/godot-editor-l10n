"[gdscript]\n"
"var red = Color(Color.RED, 0.2) # Rojo opaco al 20%.\n"
"[/gdscript]\n"
"[csharp]\n"
"var red = new Color(Colors.Red, 0.2f); // Rojo opaco al 20%.\n"
"[/csharp]\n"
