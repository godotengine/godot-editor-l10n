msgstr "Borra todos los elementos del [OptionButton]."

#: doc/classes/OptionButton.xml
msgid "Returns the auto translate mode of the item at index [param idx]."
msgstr ""
"Devuelve el modo de traducción automática del ítem en el índice [param idx]."

#: doc/classes/OptionButton.xml
msgid "Returns the icon of the item at index [param idx]."
msgstr "Devuelve el icono del ítem en el índice [param idx]."

#: doc/classes/OptionButton.xml
msgid "Returns the ID of the item at index [param idx]."
msgstr "Devuelve el ID del ítem en el índice [param idx]."

#: doc/classes/OptionButton.xml
