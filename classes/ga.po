"Read from [code]CUSTOM.x[/code] when performing billboarding and use it as "
"an angle, in radians."
msgstr ""

#: doc/classes/RenderingServer.xml
msgid ""
"Read from [code]CUSTOM.y[/code] when performing billboarding and use it as "
"an angle, in radians."
msgstr ""

#: doc/classes/RenderingServer.xml
msgid ""
"Read from [code]CUSTOM.z[/code] when performing billboarding and use it as "
"an angle, in radians."
msgstr ""

#: doc/classes/RenderingServer.xml
