"Sets the color of the stacked outline identified by the given [param index] "
"to [param color]."
msgstr ""
"Socraíonn sé an [Color] den taobh dheis (aschur) den sliotán leis an [param "
"slot_index] a thugtar do [dath param]."

#: doc/classes/LabelSettings.xml
#, fuzzy
msgid ""
"Sets the size of the stacked outline identified by the given [param index] "
"to [param size]."
msgstr ""
"Socraíonn sé cineál na sraithe sonraí saincheaptha a shainaithnítear leis an "
"innéacs a thugtar."

#: doc/classes/LabelSettings.xml
#, fuzzy
msgid ""
"Sets the color of the stacked shadow identified by the given [param index] "
"to [param color]."
msgstr ""
"Socraíonn sé an [Color] den taobh dheis (aschur) den sliotán leis an [param "
"slot_index] a thugtar do [dath param]."

#: doc/classes/LabelSettings.xml
#, fuzzy
msgid ""
"Sets the offset of the stacked shadow identified by the given [param index] "
"to [param offset]."
msgstr "Socraíonn sé téacs na míre ag an [innéacs param] a thugtar."

#: doc/classes/LabelSettings.xml
