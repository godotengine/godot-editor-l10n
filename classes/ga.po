msgstr "Sampla an cainéal dath glas."

#: doc/classes/RenderingDevice.xml
msgid "Sample the blue color channel."
msgstr "Sampla an cainéal dath gorm."

#: doc/classes/RenderingDevice.xml
msgid "Sample the alpha channel."
msgstr "Sampla an cainéal alfa."

#: doc/classes/RenderingDevice.xml
