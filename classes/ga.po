msgstr "An fad ingearach idir calafoirt."

#: doc/classes/GraphNode.xml
msgid "The icon used for representing ports."
msgstr "An deilbhín a úsáidtear chun calafoirt a léiriú."

#: doc/classes/GraphNode.xml
