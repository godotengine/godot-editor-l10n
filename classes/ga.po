#: doc/classes/RichTextLabel.xml
msgid ""
"Adds a [code skip-lint][bgcolor][/code] tag to the tag stack.\n"
"[b]Note:[/b] The background color has padding applied by default, which is "
"controlled using [theme_item text_highlight_h_padding] and [theme_item "
"text_highlight_v_padding]. This can lead to overlapping highlights if "
"background colors are placed on neighboring lines/columns, so consider "
"setting those theme items to [code]0[/code] if you want to avoid this."
msgstr ""

#: doc/classes/RichTextLabel.xml
msgid ""
