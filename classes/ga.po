"specified [RID]."
msgstr ""
"Baintear eisceacht imbhuailte ionas go dtuairiscíonn an cruth imbhuailtí "
"leis an [RID] sonraithe."

#: doc/classes/ShapeCast2D.xml doc/classes/ShapeCast3D.xml
msgid ""
