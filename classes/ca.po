#: platform/macos/doc_classes/EditorExportPlatformMacOS.xml
msgid "macOS build number used to build application executable."
msgstr ""
"Número de compilació de macOS utilitzat per crear l'executable de "
"l'aplicació."

#: platform/macos/doc_classes/EditorExportPlatformMacOS.xml
msgid "macOS SDK build number used to build application executable."
msgstr ""
"Número de compilació de l'SDK de macOS utilitzat per crear l'executable de "
"l'aplicació."

#: platform/macos/doc_classes/EditorExportPlatformMacOS.xml
msgid "macOS SDK name used to build application executable."
msgstr "Nom del macOS SDK utilitzat per crear l'executable de l'aplicació."

#: platform/macos/doc_classes/EditorExportPlatformMacOS.xml
