msgstr "Retorna el pes de la forma de mescla facial sol·licitada."

#: doc/classes/XRFaceTracker.xml
msgid "Sets a face blend shape weight."
msgstr "Estableix el pes d'una forma de mescla facial."

#: doc/classes/XRFaceTracker.xml
msgid ""
"The array of face blend shape weights with indices corresponding to the "
"[enum BlendShapeEntry] enum."
msgstr ""

