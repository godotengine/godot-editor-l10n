"la cadena òssia quan [method get_disperse_mode] és [constant "
"DISPERSE_MODE_CUSTOM]."

#: doc/classes/BoneTwistDisperser3D.xml doc/classes/ChainIK3D.xml
#: doc/classes/LimitAngularVelocityModifier3D.xml
#: doc/classes/SpringBoneSimulator3D.xml
