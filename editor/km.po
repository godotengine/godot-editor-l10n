msgstr "ផ្លាស់ទីណូតក្នុងណូតមេ"

#: editor/docks/scene_tree_dock.cpp
msgid "Move Nodes in Parent"
msgstr "ផ្លាស់ទីណូតជាច្រើនក្នុងណូតមេ"

#: editor/docks/scene_tree_dock.cpp
msgid "Duplicate Node(s)"
msgstr "ចម្លងណូត (Duplicate Node(s))"

#: editor/docks/scene_tree_dock.cpp
msgid "Can't reparent nodes in inherited scenes, order of nodes can't change."
msgstr ""
"មិនអាចផ្លាស់ប្តូរណូតមេក្នុងឈុតឆាកទទួលមរតកបានទេ លំដាប់ណូតមិនអាចផ្លាស់ប្តូរបានឡើយ។"

#: editor/docks/scene_tree_dock.cpp
msgid "Node must belong to the edited scene to become root."
msgstr "ណូតត្រូវតែស្ថិតក្នុងឈុតឆាកដែលកំពុងកែសម្រួល ទើបអាចក្លាយជា Root បាន។"

#: editor/docks/scene_tree_dock.cpp
msgid "Instantiated scenes can't become root"
msgstr "ឈុតឆាកដែលបាន Instantiate មិនអាចក្លាយជា Root បានទេ"

#: editor/docks/scene_tree_dock.cpp
msgid "Make node as Root"
msgstr "ធ្វើឱ្យណូតក្លាយជា Root"

#: editor/docks/scene_tree_dock.cpp
msgid "Delete %d nodes and any children?"
msgstr "លុប %d ណូត និងណូតកូនទាំងអស់ឬ?"

#: editor/docks/scene_tree_dock.cpp
msgid "Delete %d nodes?"
msgstr "លុប %d ណូតឬ?"

#: editor/docks/scene_tree_dock.cpp
msgid "Delete the root node \"%s\"?"
msgstr "លុប Root Node \"%s\" ឬ?"

#: editor/docks/scene_tree_dock.cpp
msgid "Delete node \"%s\" and its children?"
msgstr "លុបណូត \"%s\" និងណូតកូនរបស់វាឬ?"

#: editor/docks/scene_tree_dock.cpp
msgid "Delete node \"%s\"?"
msgstr "លុបណូត \"%s\" ឬ?"

