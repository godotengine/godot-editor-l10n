msgstr "មើល Transform Gizmo"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "View Grid"
msgstr "មើល Grid"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "View Information"
msgstr "មើលព័ត៌មាន"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "View Frame Time"
msgstr "មើល Frame Time"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Half Resolution"
msgstr "កម្រិតពាក់កណ្តាល"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Audio Listener"
msgstr "Audio Listener (អ្នកស្តាប់សំឡេង)"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Enable Doppler"
msgstr "បើក Doppler"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Cinematic Preview"
msgstr "មើលជាមុន Cinematic"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Press Focus Selection twice to start following the selection as it moves. "
"Press it yet another time to stop following the selection."
msgstr ""
"ចុច Focus Selection ពីរដងដើម្បីចាប់ផ្ដើមតាមការជ្រើសរើសនៅពេលវាផ្លាស់ទី។ ចុចម្ដងទៀតដើម្បីឈប់តា"
"ម។"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Lock Transformation to X axis"
msgstr "ចាក់សោ Transformation ទៅអ័ក្ស X"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Lock Transformation to Y axis"
msgstr "ចាក់សោ Transformation ទៅអ័ក្ស Y"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Lock Transformation to Z axis"
msgstr "ចាក់សោ Transformation ទៅអ័ក្ស Z"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Lock Transformation to YZ plane"
msgstr "ចាក់សោ Transformation ទៅប្លង់ YZ"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Lock Transformation to XZ plane"
msgstr "ចាក់សោ Transformation ទៅប្លង់ XZ"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Lock Transformation to XY plane"
msgstr "ចាក់សោ Transformation ទៅប្លង់ XY"

#: editor/scene/3d/node_3d_editor_plugin.cpp
#: editor/scene/canvas_item_editor_plugin.cpp
msgid "Cancel Transformation"
msgstr "បោះបង់ Transformation"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Begin Translate Transformation"
msgstr "ចាប់ផ្តើម Translate Transformation"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Begin Rotate Transformation"
msgstr "ចាប់ផ្តើម Rotate Transformation"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Begin Scale Transformation"
msgstr "ចាប់ផ្តើម Scale Transformation"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Reposition Using Collisions"
msgstr "កំណត់ទីតាំងឡើងវិញដោយប្រើ Collisions"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Click to stop following this node as it moves."
msgstr "ចុចដើម្បីឈប់តាមណូតនេះនៅពេលវាផ្លាស់ទី។"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Preview through the selected camera.\n"
"Hold Shift while clicking to also enable Pilot mode."
msgstr ""
"មើលជាមុនតាមរយៈកាមេរ៉ាដែលបានជ្រើសរើស។\n"
"ចុច Shift ជាប់ពេលចុច ដើម្បីបើករបៀប Pilot ផងដែរ។"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Toggle Camera Preview"
msgstr "បិទ/បើក Camera Preview"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Pilot"
msgstr "Pilot (របៀបបើកបរ)"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Enable pilot mode for the preview camera.\n"
"Allows WASD movement and mouse look when in preview mode."
msgstr ""
"បើករបៀប Pilot សម្រាប់កាមេរ៉ា Preview។\n"
"អនុញ្ញាតឱ្យផ្លាស់ទីដោយ WASD និងមើលដោយ Mouse នៅពេលក្នុងរបៀប Preview។"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Toggle Pilot Mode in Preview"
msgstr "បិទ/បើករបៀប Pilot ក្នុង Preview"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "View Rotation Locked"
msgstr "បានចាក់សោការបង្វិលទិដ្ឋភាព"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"To zoom further, change the camera's clipping planes (View → Settings...)"
msgstr ""
"ដើម្បី zoom ឱ្យកាន់តែជិត សូមផ្លាស់ប្តូរ clipping planes របស់កាមេរ៉ា (View → Settings...)"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Hold %s to highlight a vertex on the currently selected node,\n"
"then drag to move the node and snap it to vertices on neighboring nodes.\n"
"\n"
"For nodes without a vertex-based representation,\n"
"Snap Origin to Vertex is always used instead."
msgstr ""
"ចុច %s ជាប់ ដើម្បីបន្លេច Vertex នៅលើណូតដែលកំពុងជ្រើសរើស\n"
"បន្ទាប់មកអូសដើម្បីផ្លាស់ទីណូត និង Snap វាទៅ Vertices នៅលើណូតជិតខាង។\n"
"\n"
"សម្រាប់ណូតដែលគ្មានតំណាងផ្អែកលើ Vertex\n"
"Snap Origin to Vertex នឹងត្រូវបានប្រើជំនួសវិញជានិច្ច។"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Hold %s to highlight another node's vertex,\n"
"then click to teleport the selected node to the highlighted vertex."
msgstr ""
"ចុច %s ជាប់ ដើម្បីបន្លេច Vertex របស់ណូតផ្សេងទៀត\n"
"បន្ទាប់មកចុចដើម្បី Teleport ណូតដែលបានជ្រើសរើសទៅកាន់ Vertex ដែលបានបន្លេច។"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Snap to vertices of visual meshes.\n"
"Hold Shift while vertex snapping to temporarily snap to collision shapes "
"instead."
msgstr ""
"Snap ទៅ Vertices នៃ Visual Meshes។\n"
"ចុច Shift ជាប់ពេល Vertex Snapping ដើម្បី Snap ទៅ Collision Shapes ជាបណ្ដោះអាសន្នជំនួស"
"វិញ។"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Snap to vertices of collision shapes.\n"
"Hold Shift while vertex snapping to temporarily snap to mesh vertices "
"instead."
msgstr ""
"Snap ទៅ Vertices នៃ Collision Shapes។\n"
"ចុច Shift ជាប់ពេល Vertex Snapping ដើម្បី Snap ទៅ Mesh Vertices ជាបណ្ដោះអាសន្នជំនួសវិញ។"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "XForm Dialog"
msgstr "ផ្ទាំង XForm"

#: editor/scene/3d/node_3d_editor_plugin.cpp
#: editor/scene/canvas_item_editor_plugin.cpp
msgid "Lock Selected"
msgstr "ចាក់សោការជ្រើសរើស"

#: editor/scene/3d/node_3d_editor_plugin.cpp
#: editor/scene/canvas_item_editor_plugin.cpp
msgid "Unlock Selected"
msgstr "ដោះសោការជ្រើសរើស"

#: editor/scene/3d/node_3d_editor_plugin.cpp
#: editor/scene/canvas_item_editor_plugin.cpp
msgid "Group Selected"
msgstr "ដាក់ជាក្រុមការជ្រើសរើស"

#: editor/scene/3d/node_3d_editor_plugin.cpp
#: editor/scene/canvas_item_editor_plugin.cpp
