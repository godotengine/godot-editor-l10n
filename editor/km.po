#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid ""
"SmoothStep function( scalar(edge0), scalar(edge1), scalar(x) ).\n"
"\n"
"Returns 0.0 if 'x' is smaller than 'edge0' and 1.0 if x is larger than "
"'edge1'. Otherwise the return value is interpolated between 0.0 and 1.0 "
"using Hermite polynomials."
msgstr ""
"អនុគមន៍ SmoothStep( scalar(edge0), scalar(edge1), scalar(x) )។\n"
"\n"
"ត្រឡប់ 0.0 ប្រសិនបើ 'x' តូចជាង 'edge0' និង 1.0 ប្រសិនបើ x ធំជាង 'edge1'។ ក្រៅពីនេះ តម្លៃ"
"ដែលត្រឡប់មកវិញនឹងត្រូវបាន interpolate រវាង 0.0 និង 1.0 ដោយប្រើ Hermite polynomials។"

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid ""
"Step function( scalar(edge), scalar(x) ).\n"
"\n"
"Returns 0.0 if 'x' is smaller than 'edge' and otherwise 1.0."
msgstr ""
"អនុគមន៍ Step( scalar(edge), scalar(x) )។\n"
"\n"
"ត្រឡប់ 0.0 ប្រសិនបើ 'x' តូចជាង 'edge' ហើយត្រឡប់ 1.0 ក្នុងករណីផ្សេងទៀត។"

