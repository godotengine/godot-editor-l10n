#: platform/android/export/export_plugin.cpp
msgid "\"Use Gradle Build\" is required to enable \"Swipe to dismiss\"."
msgstr "\"Use Gradle Build\" ត្រូវបានទាមទារដើម្បីបើក \"Swipe to dismiss\"។"

#: platform/android/export/export_plugin.cpp
msgid "\"Use Gradle Build\" must be enabled to use the plugins."
msgstr "\"Use Gradle Build\" ត្រូវតែត្រូវបានបើក ដើម្បីប្រើ plugins។"

#: platform/android/export/export_plugin.cpp
msgid ""
"\"Compress Native Libraries\" is only valid when \"Use Gradle Build\" is "
"enabled."
msgstr ""
"\"Compress Native Libraries\" មានសុពលភាពតែនៅពេលដែល \"Use Gradle Build\" ត្រូវបាន"
"បើកប៉ុណ្ណោះ។"

#: platform/android/export/export_plugin.cpp
msgid "\"Export AAB\" is only valid when \"Use Gradle Build\" is enabled."
msgstr ""
"\"Export AAB\" មានសុពលភាពតែនៅពេលដែល \"Use Gradle Build\" ត្រូវបានបើកប៉ុណ្ណោះ។"

#: platform/android/export/export_plugin.cpp
msgid ""
"\"Min SDK\" can only be overridden when \"Use Gradle Build\" is enabled."
msgstr ""
"\"Min SDK\" អាចត្រូវបាន override បានតែនៅពេលដែល \"Use Gradle Build\" ត្រូវបានបើកប៉ុណ្"
"ណោះ។"

#: platform/android/export/export_plugin.cpp
msgid "\"Min SDK\" should be a valid integer, but got \"%s\" which is invalid."
msgstr ""
"\"Min SDK\" គួរតែជាចំនួនគត់ដែលត្រឹមត្រូវ ប៉ុន្តែទទួលបាន \"%s\" ដែលមិនត្រឹមត្រូវ។"

#: platform/android/export/export_plugin.cpp
msgid ""
"\"Min SDK\" cannot be lower than %d, which is the version needed by the "
"Godot library."
msgstr ""
"\"Min SDK\" មិនអាចទាបជាង %d បានទេ ដែលជា version ដែលត្រូវការដោយ Godot library។"

#: platform/android/export/export_plugin.cpp
msgid ""
"\"Target SDK\" can only be overridden when \"Use Gradle Build\" is enabled."
msgstr ""
"\"Target SDK\" អាចត្រូវបាន override បានតែនៅពេលដែល \"Use Gradle Build\" ត្រូវបានបើ"
"កប៉ុណ្ណោះ។"

#: platform/android/export/export_plugin.cpp
msgid ""
"\"Target SDK\" should be a valid integer, but got \"%s\" which is invalid."
msgstr ""
