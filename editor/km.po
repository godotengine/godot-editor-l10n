#: platform/android/export/export_plugin.cpp
msgid ""
"\"Use Gradle Build\" must be enabled to enable \"Show As Launcher App\"."
msgstr ""
"\"Use Gradle Build\" ត្រូវតែត្រូវបានបើក ដើម្បីបើក \"Show As Launcher App\"។"

#: platform/android/export/export_plugin.cpp
msgid ""
"\"Use Gradle Build\" must be enabled to disable \"Show In App Library\"."
msgstr ""
