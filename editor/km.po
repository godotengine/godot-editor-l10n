msgstr "Display Server មិនគាំទ្រ HDR Output ទេ។"

#: editor/run/game_view_plugin.cpp
msgid "Renderer does not support HDR output."
msgstr "Renderer មិនគាំទ្រ HDR Output ទេ។"

#: editor/run/game_view_plugin.cpp
