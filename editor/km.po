#: platform/android/export/export_plugin.cpp
msgid "\"Target SDK\" version must be greater or equal to \"Min SDK\" version."
msgstr "version \"Target SDK\" ត្រូវតែធំជាង ឬស្មើនឹង version \"Min SDK\"។"

