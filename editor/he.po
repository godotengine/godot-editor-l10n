#: scene/debugger/view_3d_controller.cpp
msgid "Perspective"
msgstr "פרספקטיבה"

#: editor/scene/3d/node_3d_editor_plugin.cpp
#: scene/debugger/view_3d_controller.cpp
msgid "Orthogonal"
msgstr "אורתוגונלי"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Auto Orthogonal Enabled"
msgstr "אורתוגונלי אוטומטי מופעל"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Lock View Rotation"
msgstr "נעילת סיבוב התצוגה"

#. TRANSLATORS: "Normal" as in "normal life", not "normal vector".
#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Display Normal"
msgstr "הצגה נורמלית"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Display Wireframe"
msgstr "הצגת מסגרת קווים"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Display Overdraw"
msgstr "הצגת שכבת פירוט"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Display Lighting"
msgstr "הצגת תאורה"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Display Unshaded"
msgstr "הצגה ללא הצללה"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Directional Shadow Splits"
msgstr "פיצולי צל כיווני"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Displays directional shadow splits in different colors to make adjusting "
"split thresholds easier. \n"
"Red: 1st split (closest to the camera), Green: 2nd split, Blue: 3rd split, "
"Yellow: 4th split (furthest from the camera)"
msgstr ""
"הצגת פיצולי הצל הכיווני בצבעים שונים כדי להקל על כוונון ספי הפיצול. \n"
"אדום: פיצול ראשון (הקרוב ביותר למצלמה), ירוק: פיצול שני, כחול: פיצול שלישי, "
"צהוב: פיצול רביעי (הרחוק ביותר מהמצלמה)"

#. TRANSLATORS: "Normal" as in "normal vector", not "normal life".
#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Normal Buffer"
msgstr "מאגר נורמלים"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Shadow Atlas"
msgstr "אטלס צללים"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Displays the shadow atlas used for positional (omni/spot) shadow mapping.\n"
"Requires a visible OmniLight3D or SpotLight3D node with shadows enabled to "
"have a visible effect."
msgstr ""
"הצגת אטלס הצללים שמשמש למיפוי צללים מיקומי (omni/spot).\n"
"נדרש מפרק OmniLight3D או SpotLight3D גלוי עם צללים מופעלים כדי שתהיה השפעה "
"גלויה."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Directional Shadow Map"
msgstr "מפת צל כיווני"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Displays the shadow map used for directional shadow mapping.\n"
"Requires a visible DirectionalLight3D node with shadows enabled to have a "
"visible effect."
msgstr ""
"הצגת מפת הצללים שמשמשת למיפוי צללים כיווני.\n"
"נדרש מפרק DirectionalLight3D גלוי עם צללים מופעלים כדי שתהיה השפעה גלויה."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Decal Atlas"
msgstr "אטלס מדבקות"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "AreaLight3D Atlas"
msgstr "אטלס AreaLight3D"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "VoxelGI Lighting"
msgstr "תאורת VoxelGI"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Requires a visible VoxelGI node that has been baked to have a visible effect."
msgstr "נדרש מפרק VoxelGI גלוי שנאפה כדי שתהיה השפעה גלויה."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "VoxelGI Albedo"
msgstr "אלבדו VoxelGI"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "VoxelGI Emission"
msgstr "פליטת VoxelGI"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "SDFGI Cascades"
msgstr "מדרגות SDFGI"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Requires SDFGI to be enabled in Environment to have a visible effect."
msgstr "נדרשת הפעלה של SDFGI ב־Environment כדי שתהיה השפעה גלויה."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "SDFGI Probes"
msgstr "גששי SDFGI"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Left-click a SDFGI probe to display its occlusion information (white = not "
"occluded, red = fully occluded).\n"
"Requires SDFGI to be enabled in Environment to have a visible effect."
msgstr ""
"לחיצה שמאלית על גשוש SDFGI מציגה את מידע ההסתרה שלו (לבן = לא מוסתר, אדום = "
"מוסתר לגמרי).\n"
"נדרשת הפעלה של SDFGI ב־Environment כדי שתהיה השפעה גלויה."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Scene Luminance"
msgstr "בהירות הסצנה"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Displays the scene luminance computed from the 3D buffer. This is used for "
"Auto Exposure calculation.\n"
"Requires Auto Exposure to be enabled in CameraAttributes to have a visible "
"effect."
msgstr ""
"הצגת בהירות הסצנה שחושבה מהמאגר התלת־ממדי. זה משמש לחישוב החשיפה האוטומטית.\n"
"נדרשת הפעלה של Auto Exposure ב־CameraAttributes כדי שתהיה השפעה גלויה."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "SSAO"
msgstr "SSAO"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Displays the screen-space ambient occlusion buffer. Requires SSAO to be "
"enabled in Environment to have a visible effect."
msgstr ""
"הצגת המאגר של הסתרת תאורה סביבתית במרחב המסך. נדרשת הפעלה של SSAO ב־"
"Environment כדי שתהיה השפעה גלויה."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "SSIL"
msgstr "SSIL"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Displays the screen-space indirect lighting buffer. Requires SSIL to be "
"enabled in Environment to have a visible effect."
msgstr ""
"הצגת המאגר של תאורה עקיפה במרחב המסך. נדרשת הפעלה של SSIL ב־Environment כדי "
"שתהיה השפעה גלויה."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "VoxelGI/SDFGI Buffer"
msgstr "מאגר VoxelGI/SDFGI"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Requires SDFGI or VoxelGI to be enabled to have a visible effect."
msgstr "נדרשת הפעלה של SDFGI או VoxelGI כדי שתהיה השפעה גלויה."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Disable Mesh LOD"
msgstr "השבתת LOD של רשתות"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Renders all meshes with their highest level of detail regardless of their "
"distance from the camera."
msgstr ""
"רינדור כל הרשתות ברמת הפירוט הגבוהה ביותר שלהן ללא קשר למרחק שלהן מהמצלמה."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "OmniLight3D Cluster"
msgstr "אשכול OmniLight3D"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Highlights tiles of pixels that are affected by at least one OmniLight3D."
msgstr "הדגשת אריחי פיקסלים שמושפעים מ־OmniLight3D אחד לפחות."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "SpotLight3D Cluster"
msgstr "אשכול SpotLight3D"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Highlights tiles of pixels that are affected by at least one SpotLight3D."
msgstr "הדגשת אריחי פיקסלים שמושפעים מ־SpotLight3D אחד לפחות."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "AreaLight3D Cluster"
msgstr "אשכול AreaLight3D"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Highlights tiles of pixels that are affected by at least one AreaLight3D."
msgstr "הדגשת אריחי פיקסלים שמושפעים מ־AreaLight3D אחד לפחות."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Decal Cluster"
msgstr "אשכול מדבקות"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Highlights tiles of pixels that are affected by at least one Decal."
msgstr "הדגשת אריחי פיקסלים שמושפעים מ־Decal אחד לפחות."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "ReflectionProbe Cluster"
msgstr "אשכול ReflectionProbe"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Highlights tiles of pixels that are affected by at least one ReflectionProbe."
msgstr "הדגשת אריחי פיקסלים שמושפעים מ־ReflectionProbe אחד לפחות."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Occlusion Culling Buffer"
msgstr "מאגר ברירת חסימה"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Represents occluders with black pixels. Requires occlusion culling to be "
"enabled to have a visible effect."
msgstr ""
"ייצוג חוסמים בפיקסלים שחורים. נדרשת הפעלה של סילוק הסתרות (occlusion "
"culling) כדי שתהיה השפעה גלויה."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Motion Vectors"
msgstr "וקטורי תנועה"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Represents motion vectors with colored lines in the direction of motion. "
"Gray dots represent areas with no per-pixel motion."
msgstr ""
"ייצוג וקטורי תנועה בקווים צבעוניים בכיוון התנועה. נקודות אפורות מייצגות "
"אזורים ללא תנועה ברמת הפיקסל."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Internal Buffer"
msgstr "מאגר פנימי"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Shows the scene rendered in linear colorspace before any tonemapping or post-"
"processing."
msgstr ""
"הצגת הסצנה כפי שרונדרה במרחב צבע לינארי לפני מיפוי גוונים או עיבוד לאחר."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Display Advanced..."
msgstr "תצוגה מתקדמת…"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "View Environment"
msgstr "צפייה בסביבה"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "View Gizmos"
msgstr "הצגת גיזמואים"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "View Transform Gizmo"
msgstr "הצגת גיזמו שינוי הצורה"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "View Grid"
msgstr "הצגת הרשת"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "View Information"
msgstr "הצגת מידע"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "View Frame Time"
msgstr "הצגת זמן השקופית"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Half Resolution"
msgstr "חצי רזולוציה"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Audio Listener"
msgstr "מאזין לשמע"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Enable Doppler"
msgstr "הפעלת דופלר"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Cinematic Preview"
msgstr "תצוגה מקדימה קולנועית"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Press Focus Selection twice to start following the selection as it moves. "
"Press it yet another time to stop following the selection."
msgstr ""
"יש ללחוץ פעמיים על „מיקוד בבחירה” כדי להתחיל לעקוב אחר הבחירה בזמן שהיא זזה. "
"לחיצה נוספת תפסיק את המעקב אחר הבחירה."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Lock Transformation to X axis"
msgstr "נעילת שינוי הצורה לציר X"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Lock Transformation to Y axis"
msgstr "נעילת שינוי הצורה לציר Y"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Lock Transformation to Z axis"
msgstr "נעילת שינוי הצורה לציר Z"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Lock Transformation to YZ plane"
msgstr "נעילת שינוי הצורה למישור YZ"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Lock Transformation to XZ plane"
msgstr "נעילת שינוי הצורה למישור XZ"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Lock Transformation to XY plane"
msgstr "נעילת שינוי הצורה למישור XY"

#: editor/scene/3d/node_3d_editor_plugin.cpp
#: editor/scene/canvas_item_editor_plugin.cpp
msgid "Cancel Transformation"
msgstr "ביטול שינוי הצורה"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Begin Translate Transformation"
msgstr "התחלת שינוי צורה מסוג הזזה"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Begin Rotate Transformation"
msgstr "התחלת שינוי צורה מסוג סיבוב"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Begin Scale Transformation"
msgstr "התחלת שינוי צורה מסוג קנה מידה"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Reposition Using Collisions"
msgstr "מיקום מחדש באמצעות התנגשויות"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Click to stop following this node as it moves."
msgstr "יש ללחוץ כדי להפסיק לעקוב אחר מפרק זה בזמן שהוא זז."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Preview through the selected camera.\n"
"Hold Shift while clicking to also enable Pilot mode."
msgstr ""
"תצוגה מקדימה דרך המצלמה שנבחרה.\n"
"יש להחזיק Shift בעת הלחיצה כדי להפעיל גם את מצב הטייס."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Toggle Camera Preview"
msgstr "החלפת מצב תצוגה מקדימה של מצלמה"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Pilot"
msgstr "טייס"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Enable pilot mode for the preview camera.\n"
"Allows WASD movement and mouse look when in preview mode."
msgstr ""
"הפעלת מצב טייס למצלמת התצוגה המקדימה.\n"
"מאפשר תנועה ב־WASD ומבט בעכבר במצב תצוגה מקדימה."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Toggle Pilot Mode in Preview"
msgstr "החלפת מצב טייס בתצוגה המקדימה"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "View Rotation Locked"
msgstr "סיבוב התצוגה נעול"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"To zoom further, change the camera's clipping planes (View → Settings...)"
msgstr ""
"כדי להתקרב עוד, יש לשנות את מישורי הקיטום של המצלמה (View → Settings...)"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Hold %s to highlight a vertex on the currently selected node,\n"
"then drag to move the node and snap it to vertices on neighboring nodes.\n"
"\n"
"For nodes without a vertex-based representation,\n"
"Snap Origin to Vertex is always used instead."
msgstr ""
"יש להחזיק %s כדי להדגיש קודקוד במפרק הנבחר כעת,\n"
"ואז לגרור כדי להזיז את המפרק ולהצמיד אותו לקודקודים של מפרקים סמוכים.\n"
"\n"
"למפרקים ללא ייצוג מבוסס קודקודים,\n"
"תמיד נעשה שימוש ב„הצמדת הראשית לקודקוד” במקום זאת."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Hold %s to highlight another node's vertex,\n"
"then click to teleport the selected node to the highlighted vertex."
msgstr ""
"יש להחזיק %s כדי להדגיש קודקוד של מפרק אחר,\n"
"ואז ללחוץ כדי להעביר את המפרק הנבחר לקודקוד המודגש."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Snap to vertices of visual meshes.\n"
"Hold Shift while vertex snapping to temporarily snap to collision shapes "
"instead."
msgstr ""
"הצמדה לקודקודים של רשתות חזותיות.\n"
"יש להחזיק Shift בזמן הצמדת קודקודים כדי להצמיד זמנית לצורות התנגשות במקום "
"זאת."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Snap to vertices of collision shapes.\n"
"Hold Shift while vertex snapping to temporarily snap to mesh vertices "
"instead."
msgstr ""
"הצמדה לקודקודים של צורות התנגשות.\n"
"יש להחזיק Shift בזמן הצמדת קודקודים כדי להצמיד זמנית לקודקודי רשת במקום זאת."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "XForm Dialog"
msgstr "חלון XForm"

#: editor/scene/3d/node_3d_editor_plugin.cpp
#: editor/scene/canvas_item_editor_plugin.cpp
msgid "Lock Selected"
msgstr "נעילת הנבחרים"

#: editor/scene/3d/node_3d_editor_plugin.cpp
#: editor/scene/canvas_item_editor_plugin.cpp
msgid "Unlock Selected"
msgstr "שחרור נעילת הנבחרים"

#: editor/scene/3d/node_3d_editor_plugin.cpp
#: editor/scene/canvas_item_editor_plugin.cpp
msgid "Group Selected"
msgstr "קיבוץ הנבחרים"

#: editor/scene/3d/node_3d_editor_plugin.cpp
#: editor/scene/canvas_item_editor_plugin.cpp
msgid "Ungroup Selected"
msgstr "פירוק קבוצת הנבחרים"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid ""
"Click to toggle between visibility states.\n"
"\n"
"Open eye: Gizmo is visible.\n"
"Closed eye: Gizmo is hidden.\n"
"Half-open eye: Gizmo is also visible through opaque surfaces (\"x-ray\")."
msgstr ""
"יש ללחוץ כדי לעבור בין מצבי הנראות.\n"
"\n"
"עין פתוחה: הגיזמו גלוי.\n"
"עין סגורה: הגיזמו מוסתר.\n"
"עין פתוחה למחצה: הגיזמו גלוי גם דרך משטחים אטומים („רנטגן”)."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Snap Nodes to Floor"
msgstr "הצמדת מפרקים לרצפה"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Couldn't find a solid floor to snap the selection to."
msgstr "לא נמצאה רצפה מוצקה להצמדת הבחירה אליה."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Add Preview Sun to Scene"
msgstr "הוספת שמש התצוגה המקדימה לסצנה"

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "Add Preview Environment to Scene"
msgstr "הוספת סביבת התצוגה המקדימה לסצנה"

#: editor/scene/3d/node_3d_editor_plugin.cpp
#: editor/scene/canvas_item_editor_plugin.cpp
msgid "Alt+RMB: Show list of all nodes at position clicked, including locked."
msgstr "Alt+לחצן ימני: הצגת רשימת כל המפרקים במיקום הלחיצה, כולל נעולים."

#: editor/scene/3d/node_3d_editor_plugin.cpp
#: editor/scene/canvas_item_editor_plugin.cpp
msgid "%s+Drag: Rotate selected node around pivot."
msgstr "‏%s+גרירה: סיבוב המפרק הנבחר סביב הציר."

#: editor/scene/3d/node_3d_editor_plugin.cpp
msgid "%s+Drag: Use snap."
msgstr "‏%s+גרירה: שימוש בהצמדה."

