msgstr "יצירת רשת קו מתאר…"

#: editor/scene/3d/mesh_instance_3d_editor_plugin.cpp
msgid ""
"Creates a static outline mesh. The outline mesh will have its normals "
"flipped automatically.\n"
"This can be used instead of the StandardMaterial Grow property when using "
"that property isn't possible."
msgstr ""
"יצירת רשת קו מתאר סטטית. הנורמלים של רשת קו המתאר יהופכו אוטומטית.\n"
"ניתן להשתמש בזה במקום המאפיין Grow של StandardMaterial כאשר לא ניתן להשתמש "
"במאפיין זה."

#: editor/scene/3d/mesh_instance_3d_editor_plugin.cpp
msgid "View UV1"
msgstr "הצגת UV1"

#: editor/scene/3d/mesh_instance_3d_editor_plugin.cpp
msgid "View UV2"
msgstr "הצגת UV2"

#: editor/scene/3d/mesh_instance_3d_editor_plugin.cpp
msgid "Unwrap UV2 for Lightmap/AO"
msgstr "פריסת UV2 עבור מפת תאורה/AO"

#: editor/scene/3d/mesh_instance_3d_editor_plugin.cpp
msgid "Create Outline Mesh"
msgstr "יצירת רשת קו מתאר"

#: editor/scene/3d/mesh_instance_3d_editor_plugin.cpp
msgid "Outline Size:"
msgstr "גודל קו המתאר:"

