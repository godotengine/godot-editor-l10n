#: editor/settings/editor_build_profile.cpp
msgid ""
"Fallback implementation of Text Server\n"
"Supports basic text layouts."
msgstr ""
"מימוש חלופי של שרת הטקסט\n"
"תומך בפריסות טקסט בסיסיות."

#: editor/settings/editor_build_profile.cpp
msgid ""
"Text Server implementation powered by ICU and HarfBuzz libraries.\n"
"Supports complex text layouts, BiDi, and contextual OpenType font features."
msgstr ""
"מימוש שרת טקסט מבוסס על הספריות ICU ו־HarfBuzz.\n"
"תומך בפריסות טקסט מורכבות, BiDi ותכונות גופן OpenType הקשריות."

#: editor/settings/editor_build_profile.cpp
msgid ""
"TrueType, OpenType, Type 1, and WOFF1 font format support using FreeType "
"library (if disabled, WOFF2 support is also disabled)."
msgstr ""
"תמיכה בתבניות הגופנים TrueType,‏ OpenType,‏ Type 1 ו־WOFF1 באמצעות הספרייה "
"FreeType (אם מושבת, גם התמיכה ב־WOFF2 מושבתת)."

#: editor/settings/editor_build_profile.cpp
msgid "WOFF2 font format support using FreeType and Brotli libraries."
msgstr "תמיכה בתבנית הגופנים WOFF2 באמצעות הספריות FreeType ו־Brotli."

#: editor/settings/editor_build_profile.cpp
msgid ""
"SIL Graphite smart font technology support (supported by Advanced Text "
"Server only)."
msgstr ""
"תמיכה בטכנולוגיית הגופנים החכמים SIL Graphite (נתמכת על ידי שרת הטקסט המתקדם "
"בלבד)."

#: editor/settings/editor_build_profile.cpp
msgid ""
"Multi-channel signed distance field font rendering support using msdfgen "
"library (pre-rendered MSDF fonts can be used even if this option is "
"disabled)."
msgstr ""
"תמיכה ברינדור גופנים בשדה מרחק חתום רב־ערוצי באמצעות הספרייה msdfgen (ניתן "
"להשתמש בגופני MSDF מרונדרים מראש גם אם אפשרות זו מושבתת)."

