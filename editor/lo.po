msgstr "ເລກກຳລັງຖານ e."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Base-2 Exponential."
msgstr "ເລກກຳລັງຖານ 2."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Finds the nearest integer less than or equal to the parameter."
msgstr "ຊອກຫາຈຳນວນຖ້ວນທີ່ໃກ້ທີ່ສຸດ ທີ່ມີຄ່ານ້ອຍກວ່າ ຫຼື ເທົ່າກັບພາລາມິເຕີ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Computes the fractional part of the argument."
msgstr "ຄຳນວນຫາສ່ວນເສດ (fractional part) ຂອງອາຄິວເມນ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Returns the inverse of the square root of the parameter."
msgstr "ຄືນຄ່າສ່ວນກັບຂອງຮາກຂັ້ນສອງຂອງພາລາມິເຕີ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Natural logarithm."
msgstr "ລໍກາຣິດທຳທຳມະຊາດ (Natural logarithm)."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Base-2 logarithm."
msgstr "ລໍກາຣິດທຳຖານ 2."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Returns the greater of two values."
msgstr "ຄືນຄ່າທີ່ຫຼາຍກວ່າລະຫວ່າງສອງຄ່າ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Returns the lesser of two values."
msgstr "ຄືນຄ່າທີ່ນ້ອຍກວ່າລະຫວ່າງສອງຄ່າ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Linear interpolation between two scalars."
msgstr "ການແຊກຄ່າແບບເສັ້ນ (Linear interpolation) ລະຫວ່າງສອງສະກາລາ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Performs a fused multiply-add operation (a * b + c) on scalars."
msgstr "ດຳເນີນການຄູນແລ້ວບວກ (fused multiply-add) (a * b + c) ໃນສະກາລາ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Returns the opposite value of the parameter."
msgstr "ຄືນຄ່າກົງກັນຂ້າມຂອງພາລາມິເຕີ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "1.0 - scalar"
msgstr "1.0 - scalar"

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid ""
"Returns the value of the first parameter raised to the power of the second."
msgstr "ຄືນຄ່າຂອງພາລາມິເຕີທຳອິດ ຍົກກຳລັງດ້ວຍພາລາມິເຕີທີສອງ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Converts a quantity in degrees to radians."
msgstr "ແປງຄ່າຈາກ ອົງສາ ເປັນ ເຣເດຍ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "1.0 / scalar"
msgstr "1.0 / scalar"

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Remaps a value from the input range to the output range."
msgstr "ປ່ຽນຊ່ວງຂອງຄ່າ (Remaps) ຈາກຊ່ວງຂາເຂົ້າ ໄປຫາຊ່ວງຂາອອກ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Finds the nearest integer to the parameter."
msgstr "ຊອກຫາຈຳນວນຖ້ວນທີ່ໃກ້ທີ່ສຸດກັບພາລາມິເຕີ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Finds the nearest even integer to the parameter."
msgstr "ຊອກຫາຈຳນວນຄູ່ທີ່ໃກ້ທີ່ສຸດກັບພາລາມິເຕີ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Clamps the value between 0.0 and 1.0."
msgstr "ຈຳກັດຄ່າໃຫ້ຢູ່ລະຫວ່າງ 0.0 ແລະ 1.0."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Extracts the sign of the parameter."
msgstr "ດຶງເອົາເຄື່ອງໝາຍ (sign) ຂອງພາລາມິເຕີ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Returns the sine of the parameter."
msgstr "ຄືນຄ່າ sine ຂອງພາລາມິເຕີ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Returns the hyperbolic sine of the parameter."
msgstr "ຄືນຄ່າ hyperbolic sine ຂອງພາລາມິເຕີ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Returns the square root of the parameter."
msgstr "ຄືນຄ່າຮາກຂັ້ນສອງຂອງພາລາມິເຕີ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid ""
"SmoothStep function( scalar(edge0), scalar(edge1), scalar(x) ).\n"
"\n"
"Returns 0.0 if 'x' is smaller than 'edge0' and 1.0 if x is larger than "
"'edge1'. Otherwise the return value is interpolated between 0.0 and 1.0 using "
"Hermite polynomials."
msgstr ""
"ຟັງຊັນ SmoothStep( scalar(edge0), scalar(edge1), scalar(x) ).\n"
"\n"
"ຄືນຄ່າ 0.0 ຖ້າ 'x' ນ້ອຍກວ່າ 'edge0' ແລະ ຄືນຄ່າ 1.0 ຖ້າ 'x' ຫຼາຍກວ່າ 'edge1'. ຖ້າບໍ່ດັ່ງນັ້ນ ຄ່າ"
"ທີ່ຄືນຈະຖືກແຊກລະຫວ່າງ 0.0 ແລະ 1.0 ໂດຍໃຊ້ Hermite polynomials."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid ""
"Step function( scalar(edge), scalar(x) ).\n"
"\n"
"Returns 0.0 if 'x' is smaller than 'edge' and otherwise 1.0."
msgstr ""
"ຟັງຊັນ Step( scalar(edge), scalar(x) ).\n"
"\n"
"ຄືນຄ່າ 0.0 ຖ້າ 'x' ນ້ອຍກວ່າ 'edge', ຖ້າບໍ່ດັ່ງນັ້ນຄືນຄ່າ 1.0."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid ""
"(Fragment/Light mode only) (Scalar) Sum of absolute derivative in 'x' and 'y'."
msgstr ""
"(ສະເພາະໂໝດ Fragment/Light) (Scalar) ຜົນລວມຂອງອະນຸພັນສຳບູນໃນແກນ 'x' ແລະ 'y'."

