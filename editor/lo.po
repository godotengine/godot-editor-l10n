#: editor/editor_node.cpp
msgid "Recovery Mode is enabled. Editor functionality has been restricted."
msgstr "ໂໝດກູ້ຄືນຖືກເປີດໃຊ້. ຟັງຊັນຂອງຕົວແກ້ໄຂຖືກຈຳກັດໄວ້."

#: editor/editor_node.cpp
msgid ""
"Spins when the editor window redraws.\n"
"Update Continuously is enabled, which can increase power usage. Click to "
"disable it."
msgstr ""
"ຈະໝູນເມື່ອໜ້າຕ່າງຕົວແກ້ໄຂມີການແຕ້ມໃໝ່.\n"
"ການອັບເດດແບບຕໍ່ເນື່ອງຖືກເປີດໃຊ້ຢູ່ ເຊິ່ງອາດເຮັດໃຫ້ໃຊ້ພະລັງງານຫຼາຍຂຶ້ນ. ຄລິກເພື່ອປິດ."

#: editor/editor_node.cpp
msgid "Spins when the editor window redraws."
msgstr "ຈະໝູນເມື່ອໜ້າຕ່າງຕົວແກ້ໄຂມີການແຕ້ມໃໝ່."

#: editor/editor_node.cpp
msgid ""
"Cannot save resource at path \"%s\", as it is imported.\n"
"Imported resources can't be saved. Instead, modify the source file or change "
"options in the Import dock."
msgstr ""
"ບໍ່ສາມາດບັນທຶກຊັບພະຍາກອນທີ່ \"%s\" ໄດ້ ເພາະມັນຖືກນຳເຂົ້າ (Import) ມາ.\n"
"ຊັບພະຍາກອນທີ່ນຳເຂົ້າບໍ່ສາມາດບັນທຶກທັບໄດ້. ໃຫ້ແກ້ໄຂທີ່ໄຟລ໌ຕົ້ນສະບັບ ຫຼື ປ່ຽນຕົວເລືອກໃນໜ້າຕ່າງ Import ແທ"
"ນ."

#: editor/editor_node.cpp
msgid "Error saving resource at path \"%s\": %s."
msgstr "ເກີດຂໍ້ຜິດພາດໃນການບັນທຶກຊັບພະຍາກອນທີ່ \"%s\": %s."

#: editor/editor_node.cpp
msgid ""
"The text-based resource at path \"%s\" is large on disk (%s), likely because "
"it has embedded binary data.\n"
"This slows down resource saving and loading.\n"
"Consider saving its binary subresource(s) to a binary `.res` file or saving "
"the resource as a binary `.res` file.\n"
"This warning can be disabled in the Editor Settings (FileSystem > On Save > "
"Warn on Saving Large Text Resources)."
msgstr ""
"ຊັບພະຍາກອນແບບຂໍ້ຄວາມທີ່ \"%s\" ມີຂະໜາດໃຫຍ່ (%s), ອາດເປັນຍ້ອນມີຂໍ້ມູນໄບນະລີຝັງຢູ່.\n"
"ນີ້ຈະເຮັດໃຫ້ການບັນທຶກ ແລະ ການໂຫລດຊ້າລົງ.\n"
"ຄວນພິຈາລະນາບັນທຶກຊັບພະຍາກອນຍ່ອຍເປັນໄຟລ໌ `.res` ຫຼື ບັນທຶກຊັບພະຍາກອນນີ້ເປັນໄຟລ໌ `.res` ແທນ.\n"
"ທ່ານສາມາດປິດຄຳເຕືອນນີ້ໄດ້ໃນ Editor Settings."

#: editor/editor_node.cpp
msgid ""
"This resource can't be saved because it was imported from another file. Make "
"it unique first."
msgstr ""
"ຊັບພະຍາກອນນີ້ບໍ່ສາມາດບັນທຶກໄດ້ເພາະມັນຖືກນຳເຂົ້າມາຈາກໄຟລ໌ອື່ນ. ໃຫ້ເຮັດໃຫ້ມັນເປັນເອກະລັກ (Make "
"Unique) ກ່ອນ."

#: editor/editor_node.cpp
msgid ""
"This resource can't be saved because it does not belong to the edited scene. "
"Make it unique first."
msgstr ""
"ຊັບພະຍາກອນນີ້ບໍ່ສາມາດບັນທຶກໄດ້ເພາະມັນບໍ່ໄດ້ເປັນຂອງສາກທີ່ກຳລັງແກ້ໄຂຢູ່. ໃຫ້ເຮັດໃຫ້ມັນເປັນເອກະລັກກ່ອນ."

#: editor/editor_node.cpp
msgid "Save Resource As..."
msgstr "ບັນທຶກຊັບພະຍາກອນເປັນ..."

#: editor/editor_node.cpp
msgid "Can't open file for writing:"
msgstr "ບໍ່ສາມາດເປີດໄຟລ໌ເພື່ອຂຽນໄດ້:"

#: editor/editor_node.cpp
msgid "Requested file format unknown:"
msgstr "ບໍ່ຮູ້ຈັກຮູບແບບໄຟລ໌ທີ່ຮ້ອງຂໍ:"

#: editor/editor_node.cpp
msgid "Error while saving."
msgstr "ເກີດຂໍ້ຜິດພາດຂະນະບັນທຶກ."

#: editor/editor_node.cpp
msgid "Can't open file '%s'. The file could have been moved or deleted."
msgstr "ບໍ່ສາມາດເປີດໄຟລ໌ '%s' ໄດ້. ໄຟລ໌ອາດຖືກຍ້າຍ ຫຼື ລຶບໄປແລ້ວ."

#: editor/editor_node.cpp
msgid "Error while parsing file '%s'."
msgstr "ເກີດຂໍ້ຜິດພາດໃນການອ່ານໄຟລ໌ '%s'."

#: editor/editor_node.cpp
msgid "Scene file '%s' appears to be invalid/corrupt."
msgstr "ໄຟລ໌ສາກ '%s' ເບິ່ງຄືວ່າບໍ່ຖືກຕ້ອງ ຫຼື ເສຍຫາຍ."

#: editor/editor_node.cpp
msgid "Missing file '%s' or one of its dependencies."
msgstr "ບໍ່ພົບໄຟລ໌ '%s' ຫຼື ໄຟລ໌ທີ່ກ່ຽວຂ້ອງ."

#: editor/editor_node.cpp
msgid ""
"File '%s' is saved in a format that is newer than the formats supported by "
"this version of Godot, so it can't be opened."
msgstr ""
"ໄຟລ໌ '%s' ຖືກບັນທຶກໃນຮູບແບບທີ່ໃໝ່ກວ່າລຸ້ນຂອງ Godot ທີ່ທ່ານໃຊ້ຢູ່, ຈຶ່ງບໍ່ສາມາດເປີດໄດ້."

#: editor/editor_node.cpp
msgid "Error while loading file '%s'."
msgstr "ເກີດຂໍ້ຜິດພາດຂະນະໂຫລດໄຟລ໌ '%s'."

#: editor/editor_node.cpp
msgid "Saving Scene"
msgstr "ກຳລັງບັນທຶກສາກ"

#: editor/editor_node.cpp
msgid "Analyzing"
msgstr "ກຳລັງວິເຄາະ"

#: editor/editor_node.cpp
msgid "Creating Thumbnail"
msgstr "ກຳລັງສ້າງຮູບຕົວຢ່າງ"

#: editor/editor_node.cpp
msgid "This operation can't be done without a tree root."
msgstr "ການດຳເນີນການນີ້ບໍ່ສາມາດເຮັດໄດ້ຖ້າບໍ່ມີສ່ວນຮາກຂອງຕົ້ນໄມ້."

#: editor/editor_node.cpp
msgid ""
"This scene can't be saved because there is a cyclic instance inclusion.\n"
"Please resolve it and then attempt to save again."
msgstr ""
"ບໍ່ສາມາດບັນທຶກສາກນີ້ໄດ້ ເພາະມີການຮ້ອງຂໍໄຟລ໌ແບບວົນລູບ (cyclic instance).\n"
"ກະລຸນາແກ້ໄຂກ່ອນ ແລ້ວຈຶ່ງລອງບັນທຶກໃໝ່."

#: editor/editor_node.cpp
msgid ""
"Couldn't save scene. Likely dependencies (instances or inheritance) couldn't "
"be satisfied."
msgstr ""
"ບໍ່ສາມາດບັນທຶກສາກໄດ້. ອາດເປັນຍ້ອນໄຟລ໌ທີ່ກ່ຽວຂ້ອງ (instances ຫຼື inheritance) ບໍ່ຖືກຕ້ອງ."

#: editor/editor_node.cpp
msgid ""
"The text-based scene at path \"%s\" is large on disk (%s), likely because it "
"has embedded binary data.\n"
"This slows down scene saving and loading.\n"
"Consider saving its binary subresource(s) to a binary `.res` file or saving "
"the scene as a binary `.scn` file.\n"
"This warning can be disabled in the Editor Settings (FileSystem > On Save > "
"Warn on Saving Large Text Resources)."
msgstr ""
"ສາກແບບຂໍ້ຄວາມທີ່ \"%s\" ມີຂະໜາດໃຫຍ່ (%s), ອາດເປັນຍ້ອນມີຂໍ້ມູນໄບນະລີຝັງຢູ່.\n"
"ນີ້ຈະເຮັດໃຫ້ການບັນທຶກ ແລະ ການໂຫລດຊ້າລົງ.\n"
"ຄວນພິຈາລະນາບັນທຶກຊັບພະຍາກອນຍ່ອຍເປັນໄຟລ໌ `.res` ຫຼື ບັນທຶກສາກເປັນໄຟລ໌ `.scn` ແທນ.\n"
"ທ່ານສາມາດປິດຄຳເຕືອນນີ້ໄດ້ໃນ Editor Settings."

#: editor/editor_node.cpp
msgid "Save scene before running..."
msgstr "ບັນທຶກສາກກ່ອນການຣັນ..."

#: editor/editor_node.cpp
msgid "Merge With Existing"
msgstr "ຮວມເຂົ້າກັບທີ່ມີຢູ່ແລ້ວ"

#: editor/editor_node.cpp
msgid "Apply MeshInstance Transforms"
msgstr "ນຳໃຊ້ການແປງຄ່າ (Transforms) ຂອງ MeshInstance"

#: editor/editor_node.cpp
msgid "Can't load MeshLibrary for merging!"
msgstr "ບໍ່ສາມາດໂຫລດ MeshLibrary ເພື່ອມາຮວມກັນໄດ້!"

#: editor/editor_node.cpp
msgid "Error saving MeshLibrary!"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການບັນທຶກ MeshLibrary!"

#: editor/editor_node.cpp
msgid ""
"An error occurred while trying to save the editor layout.\n"
"Make sure the editor's user data path is writable."
msgstr ""
"ເກີດຂໍ້ຜິດພາດຂະນະບັນທຶກຮູບແບບ (layout) ຂອງຕົວແກ້ໄຂ.\n"
"ກວດສອບໃຫ້ແນ່ໃຈວ່າເສັ້ນທາງຂໍ້ມູນຜູ້ໃຊ້ສາມາດຂຽນໄດ້."

#: editor/editor_node.cpp
msgid ""
"Default editor layout overridden.\n"
"To restore the Default layout to its base settings, use the Delete Layout "
"option and delete the Default layout."
msgstr ""
"ຮູບແບບເລີ່ມຕົ້ນຖືກຂຽນທັບແລ້ວ.\n"
"ເພື່ອຄືນຄ່າຮູບແບບເລີ່ມຕົ້ນ, ໃຫ້ໃຊ້ຕົວເລືອກ Delete Layout ແລ້ວລຶບຮູບແບບ Default ອອກ."

#: editor/editor_node.cpp
msgid "Layout name not found!"
msgstr "ບໍ່ພົບຊື່ຮູບແບບ (Layout)!"

#: editor/editor_node.cpp
msgid "Restored the Default layout to its base settings."
msgstr "ຄືນຄ່າຮູບແບບເລີ່ມຕົ້ນໄປຫາຄ່າພື້ນຖານແລ້ວ."

#: editor/editor_node.cpp
msgid "This object is marked as read-only, so it's not editable."
msgstr "ວັດຖຸນີ້ຖືກຕັ້ງຄ່າໃຫ້ອ່ານໄດ້ຢ່າງດຽວ, ຈຶ່ງບໍ່ສາມາດແກ້ໄຂໄດ້."

#: editor/editor_node.cpp
msgid ""
"This resource belongs to a scene that was imported, so it's not editable.\n"
"Please read the documentation relevant to importing scenes to better "
"understand this workflow."
msgstr ""
"ຊັບພະຍາກອນນີ້ເປັນຂອງສາກທີ່ຖືກນຳເຂົ້າມາ, ຈຶ່ງບໍ່ສາມາດແກ້ໄຂໄດ້.\n"
"ກະລຸນາອ່ານເອກະສານກ່ຽວກັບການນຳເຂົ້າສາກເພື່ອຄວາມເຂົ້າໃຈ."

#: editor/editor_node.cpp
msgid ""
"This resource belongs to a scene that was instantiated or inherited.\n"
"Changes to it must be made inside the original scene."
msgstr ""
"ຊັບພະຍາກອນນີ້ເປັນຂອງສາກທີ່ຖືກສ້າງເປັນອິນສະແຕນຊ໌ ຫຼື ສືບທອດມາ.\n"
"ການປ່ຽນແປງຕ້ອງເຮັດພາຍໃນສາກຕົ້ນສະບັບ."

#: editor/editor_node.cpp
msgid ""
"This resource was imported, so it's not editable. Change its settings in the "
"import panel and then re-import."
msgstr ""
"ຊັບພະຍາກອນນີ້ຖືກນຳເຂົ້າມາ, ຈຶ່ງບໍ່ສາມາດແກ້ໄຂໄດ້. ໃຫ້ປ່ຽນການຕັ້ງຄ່າໃນໜ້າຕ່າງ Import ແລ້ວນຳເຂົ້າໃໝ່."

#: editor/editor_node.cpp
msgid ""
"This scene was imported, so changes to it won't be kept.\n"
"Instantiating or inheriting it will allow you to make changes to it.\n"
"Please read the documentation relevant to importing scenes to better "
"understand this workflow."
msgstr ""
"ສາກນີ້ຖືກນຳເຂົ້າມາ, ການປ່ຽນແປງຈະບໍ່ຖືກບັນທຶກ.\n"
"ການສ້າງເປັນອິນສະແຕນຊ໌ ຫຼື ສືບທອດສາກຈະຊ່ວຍໃຫ້ທ່ານແກ້ໄຂໄດ້.\n"
"ກະລຸນາອ່ານເອກະສານກ່ຽວກັບການນຳເຂົ້າສາກ."

#: editor/editor_node.cpp
msgid "Changes may be lost!"
msgstr "ການປ່ຽນແປງອາດຈະສູນຫາຍ!"

#: editor/editor_node.cpp
msgid "This object is read-only."
msgstr "ວັດຖຸນີ້ນຳໃຊ້ອ່ານໄດ້ຢ່າງດຽວ."

#: editor/editor_node.cpp
msgid "%d second ago"
msgid_plural "%d seconds ago"
msgstr[0] "%d ວິນາທີກ່ອນ"

#: editor/editor_node.cpp
msgid "%d minute ago"
msgid_plural "%d minutes ago"
msgstr[0] "%d ນາທີກ່ອນ"

#: editor/editor_node.cpp
msgid "%d hour ago"
msgid_plural "%d hours ago"
msgstr[0] "%d ຊົ່ວໂມງກ່ອນ"

#: editor/editor_node.cpp
msgid "Scene opened: %s."
msgstr "ເປີດສາກແລ້ວ: %s."

#: editor/editor_node.cpp
msgid "Last saved: %s."
msgstr "ບັນທຶກຫຼ້າສຸດ: %s."

#: editor/editor_node.cpp
msgid ""
"Scene \"%s\" has unsaved changes.\n"
"%s"
msgstr ""
"ສາກ \"%s\" ມີການປ່ຽນແປງທີ່ຍັງບໍ່ໄດ້ບັນທຶກ.\n"
"%s"

#: editor/editor_node.cpp
msgid "Open Base Scene"
msgstr "ເປີດສາກຫຼັກ (Base Scene)"

#: editor/editor_node.cpp
msgid "%s no longer exists! Please specify a new save location."
msgstr "%s ບໍ່ມີຢູ່ແລ້ວ! ກະລຸນາລະບຸບ່ອນບັນທຶກໃໝ່."

#: editor/editor_node.cpp
msgid ""
"The current scene has no root node, but %d modified external resource(s) and/"
"or plugin data were saved anyway."
msgstr ""
"ສາກປັດຈຸບັນບໍ່ມີໂນດຮາກ, ແຕ່ຊັບພະຍາກອນພາຍນອກ %d ຢ່າງ ຫຼື ຂໍ້ມູນປລັກອິນຖືກບັນທຶກແລ້ວ."

#: editor/editor_node.cpp
msgid ""
"A root node is required to save the scene. You can add a root node using the "
"Scene tree dock."
