msgstr "ລົບສອງການແປງ (transform)."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Multiplies vector by transform."
msgstr "ຄູນເວັກເຕີດ້ວຍການແປງ (transform)."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Transform constant."
msgstr "ຄ່າຄົງທີ່ການແປງ (Transform)."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Transform parameter."
msgstr "ພາລາມິເຕີການແປງ (Transform)."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid ""
"The distance fade effect fades out each pixel based on its distance to "
"another object."
msgstr ""
"ເອັບເຟັກການຈາງຫາຍຕາມໄລຍະທາງ (distance fade) ຈະເຮັດໃຫ້ແຕ່ລະພິກເຊວຈາງລົງຕາມໄລຍະຫ່າງຈາກວັ"
"ດຖຸອື່ນ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid ""
"The proximity fade effect fades out each pixel based on its distance to "
"another object."
msgstr ""
"ເອັບເຟັກການຈາງຫາຍຕາມຄວາມໃກ້ຊິດ (proximity fade) ຈະເຮັດໃຫ້ແຕ່ລະພິກເຊວຈາງລົງຕາມໄລຍະຫ່າງຈາ"
"ກວັດຖຸອື່ນ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Returns a random value between the minimum and maximum input values."
msgstr "ຄືນຄ່າສຸ່ມລະຫວ່າງຄ່າຕ່ຳສຸດ ແລະ ສູງສຸດທີ່ປ້ອນເຂົ້າ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid ""
"Builds a rotation matrix from the given axis and angle, multiply the input "
"vector by it and returns both this vector and a matrix."
msgstr ""
"ສ້າງມາທຣິກການໝຸນຈາກແກນ ແລະ ມຸມທີ່ກຳນົດ, ຄູນເວັກເຕີຂາເຂົ້າດ້ວຍມາທຣິກນັ້ນ ແລະ ຄືນຄ່າທັງເວັກເຕີ ແລະ ມ"
"າທຣິກ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Vector function."
msgstr "ຟັງຊັນເວັກເຕີ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Vector operator."
msgstr "ຕົວດຳເນີນການເວັກເຕີ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Composes vector from scalars."
msgstr "ສ້າງເວັກເຕີຈາກສະກາລາ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Decomposes vector to scalars."
msgstr "ແຍກເວັກເຕີອອກເປັນສະກາລາ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Composes 2D vector from two scalars."
msgstr "ສ້າງເວັກເຕີ 2D ຈາກສອງສະກາລາ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Decomposes 2D vector to two scalars."
msgstr "ແຍກເວັກເຕີ 2D ອອກເປັນສອງສະກາລາ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Composes 3D vector from three scalars."
msgstr "ສ້າງເວັກເຕີ 3D ຈາກສາມສະກາລາ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Decomposes 3D vector to three scalars."
msgstr "ແຍກເວັກເຕີ 3D ອອກເປັນສາມສະກາລາ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Composes 4D vector from four scalars."
msgstr "ສ້າງເວັກເຕີ 4D ຈາກສີ່ສະກາລາ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Decomposes 4D vector to four scalars."
msgstr "ແຍກເວັກເຕີ 4D ອອກເປັນສີ່ສະກາລາ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Calculates the cross product of two vectors."
msgstr "ຄຳນວນ Cross Product ຂອງສອງເວັກເຕີ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid ""
"(Fragment/Light mode only) (Vector) Derivative in 'x' using local "
"differencing."
msgstr ""
"(ສະເພາະໂໝດ Fragment/Light) (ເວັກເຕີ) ອະນຸພັນໃນແກນ 'x' ໂດຍໃຊ້ຄວາມແຕກຕ່າງທ້ອງຖິ່ນ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid ""
"(Fragment/Light mode only) (Vector) Derivative in 'y' using local "
"differencing."
msgstr ""
"(ສະເພາະໂໝດ Fragment/Light) (ເວັກເຕີ) ອະນຸພັນໃນແກນ 'y' ໂດຍໃຊ້ຄວາມແຕກຕ່າງທ້ອງຖິ່ນ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "(Vector) Derivative in 'x' using local differencing."
msgstr "(ເວັກເຕີ) ອະນຸພັນໃນແກນ 'x' ໂດຍໃຊ້ຄວາມແຕກຕ່າງທ້ອງຖິ່ນ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "(Vector) Derivative in 'y' using local differencing."
msgstr "(ເວັກເຕີ) ອະນຸພັນໃນແກນ 'y' ໂດຍໃຊ້ຄວາມແຕກຕ່າງທ້ອງຖິ່ນ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Returns the distance between two points."
msgstr "ຄືນຄ່າໄລຍະຫ່າງລະຫວ່າງສອງຈຸດ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Calculates the dot product of two vectors."
msgstr "ຄຳນວນ Dot Product ຂອງສອງເວັກເຕີ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid ""
"Returns the vector that points in the same direction as a reference vector. "
"The function has three vector parameters : N, the vector to orient, I, the "
"incident vector, and Nref, the reference vector. If the dot product of I and "
"Nref is smaller than zero the return value is N. Otherwise -N is returned."
msgstr ""
"ຄືນຄ່າເວັກເຕີທີ່ຊີ້ໄປໃນທິດທາງດຽວກັບເວັກເຕີອ້າງອີງ. ຟັງຊັນມີສາມພາລາມິເຕີເວັກເຕີ: N (ເວັກເຕີທີ່ຕ້ອງການຈັດທິ"
"ດ), I (ເວັກເຕີຕົກກະທົບ), ແລະ Nref (ເວັກເຕີອ້າງອີງ). ຖ້າ Dot Product ຂອງ I ແລະ Nref ນ້ອຍ"
"ກວ່າສູນ ຄ່າທີ່ຄືນຈະເປັນ N, ຖ້າບໍ່ດັ່ງນັ້ນຈະຄືນຄ່າ -N."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid ""
"Returns falloff based on the dot product of surface normal and view direction "
"of camera (pass associated inputs to it)."
msgstr ""
"ຄືນຄ່າການຫຼຸດໜ້ອຍຖອຍລົງ (falloff) ໂດຍອີງຕາມ Dot Product ຂອງແນວສາກພື້ນຜິວ (surface "
"normal) ແລະ ທິດທາງການເບິ່ງຂອງກ້ອງ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Calculates the length of a vector."
msgstr "ຄຳນວນຫາລວງຍາວຂອງເວັກເຕີ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Linear interpolation between two vectors."
msgstr "ການແຊກຄ່າແບບເສັ້ນລະຫວ່າງສອງເວັກເຕີ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Linear interpolation between two vectors using scalar."
msgstr "ການແຊກຄ່າແບບເສັ້ນລະຫວ່າງສອງເວັກເຕີໂດຍໃຊ້ສະກາລາ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Performs a fused multiply-add operation (a * b + c) on vectors."
msgstr "ດຳເນີນການຄູນແລ້ວບວກ (a * b + c) ໃນເວັກເຕີ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Calculates the normalize product of vector."
msgstr "ຄຳນວນຫາເວັກເຕີຫົວໜ່ວຍ (normalize) ຂອງເວັກເຕີ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "1.0 - vector"
msgstr "1.0 - vector"

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "1.0 / vector"
msgstr "1.0 / vector"

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid ""
"Returns the vector that points in the direction of reflection ( a : incident "
"vector, b : normal vector )."
msgstr ""
"ຄືນຄ່າເວັກເຕີທີ່ຊີ້ໄປໃນທິດທາງຂອງການສະທ້ອນ ( a: ເວັກເຕີຕົກກະທົບ, b: ເວັກເຕີແນວສາກ )."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Returns the vector that points in the direction of refraction."
msgstr "ຄືນຄ່າເວັກເຕີທີ່ຊີ້ໄປໃນທິດທາງຂອງການຫັກເຫ (refraction)."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Remaps a vector from the input range to the output range."
msgstr "ປ່ຽນຊ່ວງຂອງເວັກເຕີຈາກຊ່ວງຂາເຂົ້າ ໄປຫາຊ່ວງຂາອອກ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid ""
"Remaps a vector from the input range to the output range. Ranges defined with "
"scalars."
msgstr ""
"ປ່ຽນຊ່ວງຂອງເວັກເຕີຈາກຊ່ວງຂາເຂົ້າ ໄປຫາຊ່ວງຂາອອກ ໂດຍຊ່ວງຖືກກຳນົດດ້ວຍສະກາລາ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid ""
"SmoothStep function( vector(edge0), vector(edge1), vector(x) ).\n"
"\n"
"Returns 0.0 if 'x' is smaller than 'edge0' and 1.0 if 'x' is larger than "
"'edge1'. Otherwise the return value is interpolated between 0.0 and 1.0 using "
"Hermite polynomials."
msgstr ""
"ຟັງຊັນ SmoothStep( vector(edge0), vector(edge1), vector(x) ).\n"
"\n"
"ຄືນຄ່າ 0.0 ຖ້າ 'x' ນ້ອຍກວ່າ 'edge0' ແລະ ຄືນຄ່າ 1.0 ຖ້າ 'x' ຫຼາຍກວ່າ 'edge1'. ຖ້າບໍ່ດັ່ງນັ້ນ ຄ່າ"
"ທີ່ຄືນຈະຖືກແຊກລະຫວ່າງ 0.0 ແລະ 1.0 ໂດຍໃຊ້ Hermite polynomials."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid ""
"SmoothStep function( scalar(edge0), scalar(edge1), vector(x) ).\n"
"\n"
"Returns 0.0 if 'x' is smaller than 'edge0' and 1.0 if 'x' is larger than "
"'edge1'. Otherwise the return value is interpolated between 0.0 and 1.0 using "
"Hermite polynomials."
msgstr ""
"ຟັງຊັນ SmoothStep( scalar(edge0), scalar(edge1), vector(x) ).\n"
"\n"
"ຄືນຄ່າ 0.0 ຖ້າ 'x' ນ້ອຍກວ່າ 'edge0' ແລະ ຄືນຄ່າ 1.0 ຖ້າ 'x' ຫຼາຍກວ່າ 'edge1'. ຖ້າບໍ່ດັ່ງນັ້ນ ຄ່າ"
"ທີ່ຄືນຈະຖືກແຊກລະຫວ່າງ 0.0 ແລະ 1.0 ໂດຍໃຊ້ Hermite polynomials."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid ""
"Step function( vector(edge), vector(x) ).\n"
"\n"
"Returns 0.0 if 'x' is smaller than 'edge' and otherwise 1.0."
msgstr ""
"ຟັງຊັນ Step( vector(edge), vector(x) ).\n"
"\n"
"ຄືນຄ່າ 0.0 ຖ້າ 'x' ນ້ອຍກວ່າ 'edge', ຖ້າບໍ່ດັ່ງນັ້ນຄືນຄ່າ 1.0."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid ""
"Step function( scalar(edge), vector(x) ).\n"
"\n"
"Returns 0.0 if 'x' is smaller than 'edge' and otherwise 1.0."
msgstr ""
"ຟັງຊັນ Step( scalar(edge), vector(x) ).\n"
"\n"
"ຄືນຄ່າ 0.0 ຖ້າ 'x' ນ້ອຍກວ່າ 'edge', ຖ້າບໍ່ດັ່ງນັ້ນຄືນຄ່າ 1.0."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid ""
"(Fragment/Light mode only) (Vector) Sum of absolute derivative in 'x' and 'y'."
msgstr ""
"(ສະເພາະໂໝດ Fragment/Light) (ເວັກເຕີ) ຜົນລວມຂອງອະນຸພັນສຳບູນໃນແກນ 'x' ແລະ 'y'."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "(Vector) Sum of absolute derivative in 'x' and 'y'."
msgstr "(ເວັກເຕີ) ຜົນລວມຂອງອະນຸພັນສຳບູນໃນແກນ 'x' ແລະ 'y'."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Adds 2D vector to 2D vector."
msgstr "ບວກເວັກເຕີ 2D ກັບເວັກເຕີ 2D."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Adds 3D vector to 3D vector."
msgstr "ບວກເວັກເຕີ 3D ກັບເວັກເຕີ 3D."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Adds 4D vector to 4D vector."
msgstr "ບວກເວັກເຕີ 4D ກັບເວັກເຕີ 4D."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Divides 2D vector by 2D vector."
msgstr "ຫານເວັກເຕີ 2D ດ້ວຍເວັກເຕີ 2D."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Divides 3D vector by 3D vector."
msgstr "ຫານເວັກເຕີ 3D ດ້ວຍເວັກເຕີ 3D."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Divides 4D vector by 4D vector."
msgstr "ຫານເວັກເຕີ 4D ດ້ວຍເວັກເຕີ 4D."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Multiplies 2D vector by 2D vector."
msgstr "ຄູນເວັກເຕີ 2D ດ້ວຍເວັກເຕີ 2D."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Multiplies 3D vector by 3D vector."
msgstr "ຄູນເວັກເຕີ 3D ດ້ວຍເວັກເຕີ 3D."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Multiplies 4D vector by 4D vector."
msgstr "ຄູນເວັກເຕີ 4D ດ້ວຍເວັກເຕີ 4D."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Returns the remainder of the two 2D vectors."
msgstr "ຄືນຄ່າເສດຈາກການຫານສອງເວັກເຕີ 2D."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Returns the remainder of the two 3D vectors."
msgstr "ຄືນຄ່າເສດຈາກການຫານສອງເວັກເຕີ 3D."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Returns the remainder of the two 4D vectors."
msgstr "ຄືນຄ່າເສດຈາກການຫານສອງເວັກເຕີ 4D."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Subtracts 2D vector from 2D vector."
msgstr "ລົບເວັກເຕີ 2D ອອກຈາກເວັກເຕີ 2D."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Subtracts 3D vector from 3D vector."
msgstr "ລົບເວັກເຕີ 3D ອອກຈາກເວັກເຕີ 3D."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "Subtracts 4D vector from 4D vector."
msgstr "ລົບເວັກເຕີ 4D ອອກຈາກເວັກເຕີ 4D."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid "2D vector constant."
