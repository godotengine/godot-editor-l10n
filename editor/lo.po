#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
msgid ""
"(Fragment/Light mode only) (Scalar) Derivative in 'x' using local "
"differencing."
msgstr ""
"(ສະເພາະໂໝດ Fragment/Light) (Scalar) ອະນຸພັນໃນແກນ 'x' ໂດຍໃຊ້ຄວາມແຕກຕ່າງທ້ອງຖິ່ນ."

#: modules/visual_shader/editor/visual_shader_editor_plugin.cpp
